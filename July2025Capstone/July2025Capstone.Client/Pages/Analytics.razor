@page "/analytics"
@using System.Net.Http.Json
@using July2025Capstone.Shared.Models
@using Microsoft.AspNetCore.Components.Web
@using Syncfusion.Blazor.Charts
@using Charts = Syncfusion.Blazor.Charts
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

<PageTitle>Health Analytics</PageTitle>

<style>
    .modal {
        background-color: rgba(0, 0, 0, 0.5);
    }
    .modal.show {
        display: block;
    }
    .stretched-chart {
        width: 100%;
        height: 400px;
    }
    .stretched-chart .e-chart {
        width: 100% !important;
    }
</style>

<div class="analytics-page">
    <div class="container-fluid py-3">
        <h2 class="mb-3">Health Analytics</h2>
        <p class="text-muted">Your health trends over time</p>

    @if (isLoading)
    {
        <div class="row g-3">
            <div class="col-12">
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (hasError)
    {
        <div class="row g-3">
            <div class="col-12">
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Error Loading Data</h4>
                    <p>@errorMessage</p>
                    <button class="btn btn-outline-danger" @onclick="RefreshData">Retry</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0">Blood Pressure Trends</h5>
                            <button class="btn btn-primary btn-sm" @onclick="() => ShowAddBloodPressureModal()">
                                <i class="bi bi-plus-circle me-1"></i>Add Reading
                            </button>
                        </div>
                        @if (bloodPressureData?.Any() == true)
                        {
                            <div class="stretched-chart">
                                <SfChart Width="100%" Height="400px" Theme="@Syncfusion.Blazor.Theme.Bootstrap5">
                                    <ChartPrimaryXAxis ValueType="@Syncfusion.Blazor.Charts.ValueType.DateTime" Format="MM/dd" />
                                    <ChartPrimaryYAxis Title="mmHg" Minimum="60" Maximum="180" />
                                    <ChartLegendSettings Position="@Syncfusion.Blazor.Charts.LegendPosition.Bottom" Alignment="@Syncfusion.Blazor.Charts.Alignment.Center"></ChartLegendSettings>
                                <ChartSeriesCollection>
                                    <ChartSeries DataSource="@bloodPressureData"
                                              XName="DateMeasured"
                                              YName="Systolic"
                                              Name="Systolic"
                                              Fill="#667eea"
                                              Type="@Charts.ChartSeriesType.Line">
                                        <ChartMarker Visible="true" Height="8" Width="8"></ChartMarker>
                                    </ChartSeries>
                                    <ChartSeries DataSource="@bloodPressureData"
                                              XName="DateMeasured"
                                              YName="Diastolic"
                                              Name="Diastolic"
                                              Fill="#764ba2"
                                              Type="@Charts.ChartSeriesType.Line">
                                        <ChartMarker Visible="true" Height="8" Width="8"></ChartMarker>
                                    </ChartSeries>
                                </ChartSeriesCollection>
                                </SfChart>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                No blood pressure data available
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0">Glucose Levels</h5>
                            <button class="btn btn-primary btn-sm" @onclick="() => ShowAddGlucoseModal()">
                                <i class="bi bi-plus-circle me-1"></i>Add Reading
                            </button>
                        </div>
                        @if (glucoseData?.Any() == true)
                        {
                            <div class="stretched-chart">
                                <SfChart Width="100%" Height="400px" Theme="@Syncfusion.Blazor.Theme.Bootstrap5">
                                    <ChartPrimaryXAxis ValueType="@Syncfusion.Blazor.Charts.ValueType.DateTime" Format="MM/dd" />
                                    <ChartPrimaryYAxis Title="mg/dL" Minimum="60" Maximum="200" />
                                    <ChartLegendSettings Position="@Syncfusion.Blazor.Charts.LegendPosition.Bottom" Alignment="@Syncfusion.Blazor.Charts.Alignment.Center"></ChartLegendSettings>
                                    <ChartSeriesCollection>
                                        <ChartSeries DataSource="@glucoseData"
                                                  XName="DateMeasured"
                                                  YName="GlucoseValue"
                                                  Name="Glucose"
                                                  Fill="#48bb78"
                                                  Type="@Syncfusion.Blazor.Charts.ChartSeriesType.Line">
                                            <ChartMarker Visible="true" Height="8" Width="8"></ChartMarker>
                                        </ChartSeries>
                                    </ChartSeriesCollection>
                                </SfChart>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                No glucose data available
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0">Weight History</h5>
                            <button class="btn btn-primary btn-sm" @onclick="() => ShowAddWeightModal()">
                                <i class="bi bi-plus-circle me-1"></i>Add Reading
                            </button>
                        </div>
                        @if (weightData?.Any() == true)
                        {
                            <div class="stretched-chart">
                                <SfChart Width="100%" Height="400px" Theme="@Syncfusion.Blazor.Theme.Bootstrap5">
                                    <ChartPrimaryXAxis ValueType="@Syncfusion.Blazor.Charts.ValueType.DateTime" Format="MM/dd" />
                                    <ChartPrimaryYAxis Title="Weight" />
                                    <ChartLegendSettings Position="@Syncfusion.Blazor.Charts.LegendPosition.Bottom" Alignment="@Syncfusion.Blazor.Charts.Alignment.Center"></ChartLegendSettings>
                                    <ChartSeriesCollection>
                                        <ChartSeries DataSource="@weightData"
                                                  XName="DateMeasured"
                                                  YName="WeightValue"
                                                  Name="Weight"
                                                  Fill="#ed64a6"
                                                  Type="@Syncfusion.Blazor.Charts.ChartSeriesType.Line">
                                            <ChartMarker Visible="true" Height="8" Width="8"></ChartMarker>
                                        </ChartSeries>
                                    </ChartSeriesCollection>
                                </SfChart>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                No weight data available
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
</div>

@* Blood Pressure Modal *@
<div class="modal @(isBloodPressureModalVisible ? "show d-block" : "d-none")" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Blood Pressure Reading</h5>
                <button type="button" class="btn-close" @onclick="HideModals"></button>
            </div>
            <EditForm Model="@newBloodPressure" OnValidSubmit="HandleBloodPressureSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Systolic (mmHg)</label>
                        <InputNumber class="form-control" @bind-Value="newBloodPressure.Systolic" />
                        <ValidationMessage For="@(() => newBloodPressure.Systolic)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Diastolic (mmHg)</label>
                        <InputNumber class="form-control" @bind-Value="newBloodPressure.Diastolic" />
                        <ValidationMessage For="@(() => newBloodPressure.Diastolic)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date Measured</label>
                        <InputDate class="form-control" @bind-Value="newBloodPressure.DateMeasured" />
                        <ValidationMessage For="@(() => newBloodPressure.DateMeasured)" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideModals">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@* Glucose Modal *@
<div class="modal @(isGlucoseModalVisible ? "show d-block" : "d-none")" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Glucose Reading</h5>
                <button type="button" class="btn-close" @onclick="HideModals"></button>
            </div>
            <EditForm Model="@newGlucose" OnValidSubmit="HandleGlucoseSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Glucose Level (mg/dL)</label>
                        <InputNumber class="form-control" @bind-Value="newGlucose.GlucoseValue" />
                        <ValidationMessage For="@(() => newGlucose.GlucoseValue)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date Measured</label>
                        <InputDate class="form-control" @bind-Value="newGlucose.DateMeasured" />
                        <ValidationMessage For="@(() => newGlucose.DateMeasured)" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideModals">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@* Weight Modal *@
<div class="modal @(isWeightModalVisible ? "show d-block" : "d-none")" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Weight Reading</h5>
                <button type="button" class="btn-close" @onclick="HideModals"></button>
            </div>
            <EditForm Model="@newWeight" OnValidSubmit="HandleWeightSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Weight Value</label>
                        <InputNumber class="form-control" @bind-Value="newWeight.WeightValue" />
                        <ValidationMessage For="@(() => newWeight.WeightValue)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Unit</label>
                        <InputSelect class="form-control" @bind-Value="newWeight.Unit">
                            <option value="@WeightUnit.Pounds">Pounds (lbs)</option>
                            <option value="@WeightUnit.Kilograms">Kilograms (kg)</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => newWeight.Unit)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Date Measured</label>
                        <InputDate class="form-control" @bind-Value="newWeight.DateMeasured" />
                        <ValidationMessage For="@(() => newWeight.DateMeasured)" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideModals">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@* Modal Backdrop *@
@if (isBloodPressureModalVisible || isGlucoseModalVisible || isWeightModalVisible)
{
    <div class="modal-backdrop show"></div>
}

@code {
    // State management
    private bool isLoading = true;
    private bool hasError = false;
    private string? errorMessage;
    private string? userId;

    // Data collections
    private List<VitalBloodPressure>? bloodPressureData;
    private List<VitalGlucose>? glucoseData;
    private List<VitalWeight>? weightData;

    // Modal visibility states
    private bool isBloodPressureModalVisible;
    private bool isGlucoseModalVisible;
    private bool isWeightModalVisible;

    // Form models
    private VitalBloodPressure newBloodPressure = new() { DateMeasured = DateTime.Today, UserId = string.Empty };
    private VitalGlucose newGlucose = new() { DateMeasured = DateTime.Today, UserId = string.Empty };
    private VitalWeight newWeight = new() { DateMeasured = DateTime.Today, UserId = string.Empty, Unit = WeightUnit.Pounds };

    // Form submission handlers
    private async Task HandleBloodPressureSubmit(EditContext context)
    {
        Console.WriteLine("Blood pressure form submitted");
        if (context.Validate())
        {
            Console.WriteLine("Form validation passed");
            await SaveBloodPressure();
        }
        else
        {
            Console.WriteLine("Form validation failed");
            foreach (var error in context.GetValidationMessages())
            {
                Console.WriteLine($"Validation error: {error}");
            }
        }
    }

    private async Task HandleGlucoseSubmit(EditContext context)
    {
        Console.WriteLine("Glucose form submitted");
        if (context.Validate())
        {
            Console.WriteLine("Form validation passed");
            await SaveGlucose();
        }
        else
        {
            Console.WriteLine("Form validation failed");
            foreach (var error in context.GetValidationMessages())
            {
                Console.WriteLine($"Validation error: {error}");
            }
        }
    }

    private async Task HandleWeightSubmit(EditContext context)
    {
        Console.WriteLine("Weight form submitted");
        if (context.Validate())
        {
            Console.WriteLine("Form validation passed");
            await SaveWeight();
        }
        else
        {
            Console.WriteLine("Form validation failed");
            foreach (var error in context.GetValidationMessages())
            {
                Console.WriteLine($"Validation error: {error}");
            }
        }
    }

    // Modal control methods
    private void ShowAddBloodPressureModal()
    {
        newBloodPressure = new() { DateMeasured = DateTime.Today, UserId = userId ?? string.Empty };
        isBloodPressureModalVisible = true;
        StateHasChanged();
    }

    private void ShowAddGlucoseModal()
    {
        newGlucose = new() { DateMeasured = DateTime.Today, UserId = userId ?? string.Empty };
        isGlucoseModalVisible = true;
        StateHasChanged();
    }

    private void ShowAddWeightModal()
    {
        newWeight = new() { DateMeasured = DateTime.Today, UserId = userId ?? string.Empty };
        isWeightModalVisible = true;
        StateHasChanged();
    }

    private void HideModals()
    {
        isBloodPressureModalVisible = false;
        isGlucoseModalVisible = false;
        isWeightModalVisible = false;
    }

    // Save methods
    private async Task SaveBloodPressure()
    {
        try
        {
            Console.WriteLine("Starting SaveBloodPressure...");
            if (string.IsNullOrEmpty(userId))
            {
                errorMessage = "User ID not available";
                StateHasChanged();
                return;
            }

            if (Http.BaseAddress == null)
            {
                Http.BaseAddress = new Uri("http://localhost:5094/");
            }

            // Create the reading with user ID
            newBloodPressure.UserId = userId;
            
            var response = await Http.PostAsJsonAsync("api/analytics/vitals/blood-pressure", newBloodPressure);
            
            if (response.IsSuccessStatusCode)
            {
                ResetModal();
                await RefreshData();
            }
            else
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to save blood pressure reading: {responseContent}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in SaveBloodPressure: {ex}");
            errorMessage = $"Error saving blood pressure reading: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task SaveGlucose()
    {
        try
        {
            Console.WriteLine("Starting SaveGlucose...");
            if (string.IsNullOrEmpty(userId))
            {
                errorMessage = "User ID not available";
                StateHasChanged();
                return;
            }

            if (Http.BaseAddress == null)
            {
                Http.BaseAddress = new Uri("http://localhost:5094/");
            }

            Console.WriteLine($"Attempting to save glucose: {newGlucose.GlucoseValue}");
            Console.WriteLine($"User ID: {userId}");

            // Set the user ID directly on the form model
            newGlucose.UserId = userId;
            Console.WriteLine($"Sending glucose request with data: Value={newGlucose.GlucoseValue}, UserId={newGlucose.UserId}");
            
            var response = await Http.PostAsJsonAsync("api/analytics/vitals/glucose", newGlucose);
            var responseContent = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Response: {response.StatusCode}, Content: {responseContent}");

            if (response.IsSuccessStatusCode)
            {
                HideModals();
                newGlucose = new() { DateMeasured = DateTime.Today }; // Reset the form
                StateHasChanged(); // Ensure UI updates
                await RefreshData();
            }
            else
            {
                errorMessage = $"Error saving glucose: {response.StatusCode} - {responseContent}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception saving glucose: {ex}");
            errorMessage = $"Error saving glucose: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task SaveWeight()
    {
        try
        {
            Console.WriteLine("Starting SaveWeight...");
            if (string.IsNullOrEmpty(userId))
            {
                errorMessage = "User ID not available";
                StateHasChanged();
                return;
            }

            if (Http.BaseAddress == null)
            {
                Http.BaseAddress = new Uri("http://localhost:5094/");
            }

            Console.WriteLine($"Attempting to save weight: {newWeight.WeightValue}");
            Console.WriteLine($"User ID: {userId}");

            // Set the user ID directly on the form model
            newWeight.UserId = userId;
            Console.WriteLine($"Sending weight request with data: Value={newWeight.WeightValue}, UserId={newWeight.UserId}");
            
            var response = await Http.PostAsJsonAsync("api/analytics/vitals/weight", newWeight);
            var responseContent = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Response: {response.StatusCode}, Content: {responseContent}");

            if (response.IsSuccessStatusCode)
            {
                HideModals();
                newWeight = new() { DateMeasured = DateTime.Today }; // Reset the form
                StateHasChanged(); // Ensure UI updates
                await RefreshData();
            }
            else
            {
                errorMessage = $"Error saving weight: {response.StatusCode} - {responseContent}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception saving weight: {ex}");
            errorMessage = $"Error saving weight: {ex.Message}";
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Http.BaseAddress == null)
        {
            Http.BaseAddress = new Uri("http://localhost:5094/");
        }
        
        // Wait for authentication state to be available
        await WaitForAuthenticationAndLoadData();
    }

    private async Task WaitForAuthenticationAndLoadData()
    {
        // Try to get authentication state multiple times if needed
        for (int i = 0; i < 10; i++) // Try for up to 5 seconds
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            userId = user.Claims.FirstOrDefault(c => c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier")?.Value;
            
            Console.WriteLine($"Attempt {i + 1} - User authenticated: {user.Identity?.IsAuthenticated}");
            Console.WriteLine($"Attempt {i + 1} - UserId: {userId}");
            
            if (!string.IsNullOrEmpty(userId))
            {
                Console.WriteLine("Authentication successful, loading data...");
                await RefreshData();
                return;
            }
            
            // If no user ID yet, wait a bit and try again
            await Task.Delay(500);
        }
        
        // If we get here, authentication failed or is taking too long
        Console.WriteLine("Authentication timeout or failed, loading data anyway...");
        await RefreshData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Wait a bit for charts to be fully rendered, then trigger refresh
            await Task.Delay(1500);
            Console.WriteLine("First render completed, triggering chart refresh...");
            await TriggerChartRefresh();
        }
    }

    private async Task RefreshData()
    {
        try
        {
            isLoading = true;
            hasError = false;
            errorMessage = null;

            var bpResponse = await Http.GetAsync("api/analytics/vitals/blood-pressure");
            if (bpResponse.IsSuccessStatusCode)
            {
                bloodPressureData = await bpResponse.Content.ReadFromJsonAsync<List<VitalBloodPressure>>();
            }
            else
            {
                hasError = true;
                errorMessage = "Failed to load blood pressure data";
            }

            var glucoseResponse = await Http.GetAsync("api/analytics/vitals/glucose");
            if (glucoseResponse.IsSuccessStatusCode)
            {
                glucoseData = await glucoseResponse.Content.ReadFromJsonAsync<List<VitalGlucose>>();
            }
            else
            {
                hasError = true;
                errorMessage = "Failed to load glucose data";
            }

            var weightResponse = await Http.GetAsync("api/analytics/vitals/weight");
            if (weightResponse.IsSuccessStatusCode)
            {
                weightData = await weightResponse.Content.ReadFromJsonAsync<List<VitalWeight>>();
            }
            else
            {
                hasError = true;
                errorMessage = "Failed to load weight data";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            
            // Force chart refresh after data is loaded
            await Task.Delay(100);
            StateHasChanged();
        }
    }

    private void ResetModal()
    {
        errorMessage = null;
        hasError = false;
        HideModals();
        StateHasChanged();
    }

    private async Task TriggerChartRefresh()
    {
        Console.WriteLine("Triggering chart refresh workaround...");
        
        if (string.IsNullOrEmpty(userId))
        {
            Console.WriteLine("UserId is null or empty, attempting chart refresh without authentication...");
            // Still try to refresh charts even if not authenticated yet
            await Task.Delay(500); // Wait for potential authentication to complete
            await ForceChartRerender();
            return;
        }

        try
        {
            // Create a temporary blood pressure reading to trigger chart refresh
            var tempBloodPressure = new VitalBloodPressure
            {
                UserId = userId,
                Systolic = 120,
                Diastolic = 80,
                DateMeasured = DateTime.Now
            };

            Console.WriteLine("Adding temporary blood pressure reading...");
            // Add the temporary reading
            var addResponse = await Http.PostAsJsonAsync("api/analytics/vitals/blood-pressure", tempBloodPressure);
            
            if (addResponse.IsSuccessStatusCode)
            {
                var createdReading = await addResponse.Content.ReadFromJsonAsync<VitalBloodPressure>();
                Console.WriteLine($"Temporary reading created with ID: {createdReading?.Id}");
                
                if (createdReading != null)
                {
                    // Immediately delete the temporary reading
                    Console.WriteLine("Deleting temporary reading...");
                    var deleteResponse = await Http.DeleteAsync($"api/analytics/vitals/blood-pressure/{createdReading.Id}");
                    Console.WriteLine($"Delete response status: {deleteResponse.StatusCode}");
                    
                    // Refresh the data to ensure charts are properly loaded
                    Console.WriteLine("Refreshing data after chart refresh workaround...");
                    await RefreshData();
                }
            }
            else
            {
                Console.WriteLine($"Failed to add temporary reading: {addResponse.StatusCode}");
            }
            
            Console.WriteLine("Chart refresh completed successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in TriggerChartRefresh: {ex.Message}");
            // If the trigger fails, just try a different approach
            await ForceChartRerender();
        }
    }

    private async Task ForceChartRerender()
    {
        Console.WriteLine("Forcing chart re-render by clearing and restoring data...");
        
        // Store current data
        var tempBpData = bloodPressureData;
        var tempGlucoseData = glucoseData;
        var tempWeightData = weightData;
        
        // Clear data to force chart unmount
        bloodPressureData = null;
        glucoseData = null;
        weightData = null;
        StateHasChanged();
        
        // Wait a brief moment
        await Task.Delay(50);
        
        // Restore data to force chart remount
        bloodPressureData = tempBpData;
        glucoseData = tempGlucoseData;
        weightData = tempWeightData;
        StateHasChanged();
        
        Console.WriteLine("Chart re-render completed");
    }
}
