                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@* View Blood Pressure Readings Modal *@
<div class="modal @(isViewBloodPressureModalVisible ? "show d-block" : "d-none")" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Blood Pressure Readings</h5>
                <button type="button" class="btn-close" @onclick="HideModals"></button>
            </div>
            <div class="modal-body">
                @if (bloodPressureData?.Any() == true)
                {
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Systolic</th>
                                    <th>Diastolic</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reading in bloodPressureData.OrderByDescending(x => x.DateMeasured))
                                {
                                    <tr>
                                        <td>@reading.DateMeasured.ToString("MM/dd/yyyy")</td>
                                        <td>@reading.Systolic mmHg</td>
                                        <td>@reading.Diastolic mmHg</td>
                                        <td>
                                            <button class="btn btn-warning btn-sm me-2" @onclick="() => EditBloodPressureReading(reading)">
                                                <i class="bi bi-pencil"></i> Edit
                                            </button>
                                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteBloodPressureReading(reading.Id)">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        No blood pressure readings found.
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="HideModals">Close</button>
            </div>
        </div>
    </div>
</div>

