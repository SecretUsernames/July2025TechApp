@page "/analytics"
@using System.Net.Http.Json
@using Syncfusion.Blazor.Charts
@using July2025Capstone.Models
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@rendermode InteractiveWebAssembly

<PageTitle>Health Analytics</PageTitle>

<div class="container-fluid py-3">
    <h3 class="mb-3">Health Analytics</h3>
    <p class="text-muted">Your health trends over time</p>

    @if (isLoading)
    {
        <div class="row g-3">
            <div class="col-12">
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (hasError)
    {
        <div class="row g-3">
            <div class="col-12">
                <div class="alert alert-danger" role="alert">
                    <h4 class="alert-heading">Error Loading Data</h4>
                    <p>@errorMessage</p>
                    <button class="btn btn-outline-danger" @onclick="RefreshData">Retry</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">Blood Pressure Trends</h5>
                        @if (bloodPressureData?.Any() == true)
                        {
                            <SfChart>
                                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime" Title="Date">
                                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                </ChartPrimaryXAxis>
                                <ChartPrimaryYAxis Title="mmHg" Minimum="60" Maximum="180">
                                    <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                                    <ChartStripLines>
                                        <ChartStripLine Start="120" End="120" Color="#ff6b6b" Width="1"></ChartStripLine>
                                        <ChartStripLine Start="80" End="80" Color="#ff6b6b" Width="1"></ChartStripLine>
                                    </ChartStripLines>
                                </ChartPrimaryYAxis>
                                <ChartSeriesCollection>
                                    <ChartSeries DataSource="@bloodPressureData" Name="Systolic" 
                                               XName="DateMeasured" YName="Systolic" 
                                               Type="ChartSeriesType.Line" Width="2">
                                        <ChartMarker Visible="true">
                                            <ChartDataLabel Visible="false">
                                            </ChartDataLabel>
                                        </ChartMarker>
                                    </ChartSeries>
                                    <ChartSeries DataSource="@bloodPressureData" Name="Diastolic" 
                                               XName="DateMeasured" YName="Diastolic" 
                                               Type="ChartSeriesType.Line" Width="2">
                                        <ChartMarker Visible="true">
                                            <ChartDataLabel Visible="false">
                                            </ChartDataLabel>
                                        </ChartMarker>
                                    </ChartSeries>
                                </ChartSeriesCollection>
                                <ChartLegend Visible="true" Position="Syncfusion.Blazor.Charts.LegendPosition.Bottom">
                                </ChartLegend>
                                <ChartTooltipSettings Enable="true">
                                </ChartTooltipSettings>
                            </SfChart>
                            <div class="text-muted small mt-2">
                                <span class="me-3">Reference Lines:</span>
                                <span class="me-2">Systolic: 120 mmHg</span>
                                <span>Diastolic: 80 mmHg</span>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                No blood pressure data available
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">Glucose Levels</h5>
                        @if (glucoseData?.Any() == true)
                        {
                            <SfChart>
                                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime" Title="Date">
                                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                </ChartPrimaryXAxis>
                                <ChartPrimaryYAxis Title="mg/dL" Minimum="60" Maximum="200">
                                    <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                                    <ChartStripLines>
                                        <ChartStripLine Start="100" End="100" Color="#ff6b6b" Width="1"></ChartStripLine>
                                    </ChartStripLines>
                                </ChartPrimaryYAxis>
                                <ChartSeriesCollection>
                                    <ChartSeries DataSource="@glucoseData" Name="Glucose" 
                                               XName="DateMeasured" YName="GlucoseValue" 
                                               Type="ChartSeriesType.Line" Width="2">
                                        <ChartMarker Visible="true">
                                            <ChartDataLabel Visible="false">
                                            </ChartDataLabel>
                                        </ChartMarker>
                                    </ChartSeries>
                                </ChartSeriesCollection>
                                <ChartLegend Visible="false">
                                </ChartLegend>
                                <ChartTooltipSettings Enable="true">
                                </ChartTooltipSettings>
                            </SfChart>
                            <div class="text-muted small mt-2">
                                <span class="me-3">Reference Line:</span>
                                <span>Normal Fasting: 100 mg/dL</span>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                No glucose data available
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-body">
                        <h5 class="card-title">Weight History</h5>
                        @if (weightData?.Any() == true)
                        {
                            <SfChart>
                                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.DateTime" Title="Date">
                                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                                </ChartPrimaryXAxis>
                                <ChartPrimaryYAxis Title="Weight">
                                    <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                                </ChartPrimaryYAxis>
                                <ChartSeriesCollection>
                                    <ChartSeries DataSource="@weightData" Name="Weight" 
                                               XName="DateMeasured" YName="WeightValue" 
                                               Type="ChartSeriesType.Line" Width="2">
                                        <ChartMarker Visible="true">
                                            <ChartDataLabel Visible="false">
                                            </ChartDataLabel>
                                        </ChartMarker>
                                    </ChartSeries>
                                </ChartSeriesCollection>
                                <ChartLegend Visible="false">
                                </ChartLegend>
                                <ChartTooltipSettings Enable="true">
                                </ChartTooltipSettings>
                            </SfChart>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                No weight data available
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <button class="btn btn-outline-primary" @onclick="RefreshData">
                    <i class="bi bi-arrow-clockwise me-2"></i>
                    Refresh Data
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool hasError = false;
    private string? errorMessage;
    private List<VitalBloodPressure>? bloodPressureData;
    private List<VitalGlucose>? glucoseData;
    private List<VitalWeight>? weightData;

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
    }

    private async Task RefreshData()
    {
        try
        {
            isLoading = true;
            hasError = false;
            errorMessage = null;

            var bloodPressureTask = Http.GetFromJsonAsync<List<VitalBloodPressure>>("api/analytics/vitals/blood-pressure");
            var glucoseTask = Http.GetFromJsonAsync<List<VitalGlucose>>("api/analytics/vitals/glucose");
            var weightTask = Http.GetFromJsonAsync<List<VitalWeight>>("api/analytics/vitals/weight");

            await Task.WhenAll(bloodPressureTask, glucoseTask, weightTask);

            bloodPressureData = await bloodPressureTask;
            glucoseData = await glucoseTask;
            weightData = await weightTask;
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = $"Error loading vital data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
