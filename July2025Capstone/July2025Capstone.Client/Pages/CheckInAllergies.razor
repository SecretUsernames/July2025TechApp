@page "/checkin-form-creation/allergies"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

<PageTitle>Allergies - Check-in Form</PageTitle>

<div class="container py-4">
    <!-- Progress Bar -->
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted">Step 3 of 7</span>
            <span class="text-muted">Allergies & Reactions</span>
        </div>
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: 43%"></div>
        </div>
    </div>

    <h3 class="mb-3">Allergies & Reactions</h3>
    <p class="text-muted">Please list all known allergies. If you have no known allergies, you can skip this step.</p>

    @if (!isAuthenticated)
    {
        <div class="alert alert-warning">
            <h4>Authentication Required</h4>
            <p>You need to be logged in to access this page.</p>
            <a href="/Account/Login" class="btn btn-primary">Login</a>
        </div>
        return;
    }

    @if (validationErrors.Any())
    {
        <div class="alert alert-danger mb-4">
            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <!-- Add Allergy Button -->
            <div class="mb-3">
                <button type="button" class="btn btn-primary" @onclick="ShowAddDialog">
                    <span class="bi bi-plus-circle me-2"></span>Add Allergy
                </button>
            </div>

            <!-- Allergies Table -->
            @if (allergies.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Allergen Name</th>
                                <th width="120">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var allergy in allergies)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-medium">@allergy.Allergen</div>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-primary" @onclick="() => EditAllergy(allergy)" title="Edit">
                                                <span class="bi bi-pencil"></span>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" @onclick="() => DeleteAllergy(allergy)" title="Delete">
                                                <span class="bi bi-trash"></span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="text-muted">
                        <span class="bi bi-shield-check fs-1 d-block mb-3"></span>
                        <h5>No allergies added yet</h5>
                        <p class="mb-0">Click "Add Allergy" to get started, or continue if you have no known allergies</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="mt-4 d-flex justify-content-between">
        <button type="button" @onclick="GoBack" class="btn btn-outline-secondary">
            <span class="bi bi-arrow-left me-2"></span>Back
        </button>
        <button type="button" @onclick="Continue" class="btn btn-primary">
            Continue to Insurance<span class="bi bi-arrow-right ms-2"></span>
        </button>
    </div>

    <!-- Add/Edit Allergy Modal -->
    @if (showDialog)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@dialogTitle</h5>
                        <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                    </div>
                    <EditForm Model="currentAllergy" OnValidSubmit="SaveAllergy">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Allergen Name *</label>
                                <InputText @bind-Value="currentAllergy.Allergen" 
                                           class="form-control" 
                                           placeholder="e.g., Peanuts, Penicillin, Pollen, Shellfish" />
                                <ValidationMessage For="@(() => currentAllergy.Allergen)" class="text-danger small mt-1" />
                                <div class="form-text">Enter the name of the substance you're allergic to</div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Save Allergy
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    @if (errorMessage != null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }

    @if (successMessage != null)
    {
        <div class="alert alert-success mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
</div>

@code {
    private List<AllergyDto> allergies = new();
    private AllergyDto currentAllergy = new();
    private bool showDialog = false;
    private string dialogTitle = "Add Allergy";
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        await LoadAllergies();
    }

    private async Task LoadAllergies()
    {
        try
        {
            isLoading = true;
            var response = await Http.GetAsync("api/checkin/allergies");
            
            if (response.IsSuccessStatusCode)
            {
                var allergyList = await response.Content.ReadFromJsonAsync<List<AllergyDto>>();
                allergies = allergyList ?? new List<AllergyDto>();
                StateHasChanged();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while loading your allergies. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading allergies: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowAddDialog()
    {
        currentAllergy = new AllergyDto();
        dialogTitle = "Add Allergy";
        showDialog = true;
        ClearMessages();
    }

    private void EditAllergy(AllergyDto? allergy)
    {
        if (allergy != null)
        {
            currentAllergy = new AllergyDto
            {
                Id = allergy.Id,
                Allergen = allergy.Allergen
            };
            dialogTitle = "Edit Allergy";
            showDialog = true;
            ClearMessages();
        }
    }

    private async Task DeleteAllergy(AllergyDto? allergy)
    {
        if (allergy != null && allergy.Id > 0)
        {
            try
            {
                ClearMessages();
                var response = await Http.DeleteAsync($"api/checkin/allergy/{allergy.Id}");
                
                if (response.IsSuccessStatusCode)
                {
                    successMessage = "Allergy deleted successfully!";
                    await LoadAllergies();
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    await HandleValidationErrors(response);
                }
                else
                {
                    errorMessage = "An error occurred while deleting the allergy. Please try again.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting allergy: {ex.Message}";
            }
        }
    }

    private async Task SaveAllergy()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            var request = new SaveAllergyRequest { Allergy = currentAllergy };
            var response = await Http.PostAsJsonAsync("api/checkin/save-allergy", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveAllergyResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Allergy saved successfully!";
                    showDialog = false;
                    await LoadAllergies();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save allergy";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while saving the allergy. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving allergy: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "Allergy.Allergen" => "Allergen Name",
            _ => fieldName.Replace("Allergy.", "")
        };
    }

    private void CloseDialog()
    {
        showDialog = false;
        ClearMessages();
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation/medications");
    }

    private void Continue()
    {
        Navigation.NavigateTo("/checkin-form-creation/insurance");
    }
}