@page "/checkin-form-creation/emergency-contacts"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

<PageTitle>Emergency Contacts - Check-in Form</PageTitle>

<div class="container py-4">
    @if (!isAuthenticated)
    {
        <div class="med-card">
            <div class="card-body">
                <div class="warning-state">
                    <i class="bi bi-exclamation-triangle text-warning fs-2 mb-3"></i>
                    <h4>Authentication Required</h4>
                    <p>You need to be logged in to access this page.</p>
                    <a href="/Account/Login" class="btn-primary-modern">Login</a>
                </div>
            </div>
        </div>
        return;
    }

    <!-- Modern Progress Bar -->
    <div class="modern-progress-wrapper mb-4">
        <div class="progress-step-info">
            <span class="step-number">Step 5 of 8</span>
            <span class="step-title">Emergency Contacts</span>
        </div>
        <div class="modern-step-progress">
            <div class="step-progress-bar" style="width: 62.5%"></div>
        </div>
    </div>

    <!-- Modern Hero Section -->
    <div class="page-hero mb-4">
        <div class="hero-icon">
            <i class="bi bi-person-lines-fill"></i>
        </div>
        <h1 class="hero-title">Emergency Contacts</h1>
        <p class="hero-subtitle">
            Add people who can be reached in case of a medical emergency. Having at least one emergency contact is important for your safety.
        </p>
    </div>

    <div class="med-card">
        <div class="card-header modern-header">
            <div class="header-content">
                <div class="header-icon">
                    <i class="bi bi-person-plus"></i>
                </div>
                <div class="header-text">
                    <h5 class="header-title">Emergency Contacts</h5>
                    <p class="header-subtitle">Manage your emergency contact information for medical situations</p>
                </div>
            </div>
        </div>
        <div class="card-body modern-content">
            <!-- Add Emergency Contact Button -->
            <div class="action-header mb-4">
                <button type="button" class="btn-add-modern" @onclick="ShowAddDialog">
                    <i class="bi bi-plus-circle me-2"></i>Add Emergency Contact
                </button>
            </div>

            <!-- Emergency Contacts Grid -->
            @if (emergencyContacts.Any())
            {
                <div class="contact-grid">
                    @foreach (var contact in emergencyContacts)
                    {
                        <div class="contact-card">
                            <div class="contact-card-header">
                                <div class="contact-info">
                                    <i class="bi bi-person-check text-primary me-2"></i>
                                    <span class="contact-name">@contact.FirstName @contact.LastName</span>
                                </div>
                                <div class="card-actions">
                                    <button type="button" class="action-btn edit" @onclick="() => EditContact(contact)" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="action-btn delete" @onclick="() => DeleteContact(contact)" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="contact-card-body">
                                <div class="contact-detail">
                                    <span class="detail-label">Relationship:</span>
                                    <span class="detail-value relationship">@contact.Relationship</span>
                                </div>
                                <div class="contact-detail">
                                    <span class="detail-label">Phone Number:</span>
                                    <span class="detail-value phone">@contact.Phone</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <h5 class="empty-title">No Emergency Contacts Added</h5>
                    <p class="empty-text">Click "Add Emergency Contact" above to add someone who can be reached in case of a medical emergency. This is important for your safety and care.</p>
                </div>
            }
        </div>
    </div>

    <!-- Modern Action Buttons -->
    <div class="action-buttons-container">
        <button type="button" @onclick="GoBack" class="btn-secondary-modern">
            <i class="bi bi-arrow-left me-2"></i>
            <span>Back to Insurance</span>
        </button>
        <button type="button" @onclick="Continue" class="btn-primary-modern">
            <span>Continue to Visit Information</span>
            <i class="bi bi-arrow-right ms-2"></i>
        </button>
    </div>

    <!-- Modern Add/Edit Emergency Contact Modal -->
    @if (showDialog)
    {
        <div class="modern-modal-backdrop" @onclick="CloseDialog">
            <div class="modern-modal" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-title-section">
                        <i class="bi bi-person-plus text-primary me-2"></i>
                        <h5 class="modal-title">@dialogTitle</h5>
                    </div>
                    <button type="button" class="modal-close" @onclick="CloseDialog">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <EditForm Model="currentContact" OnValidSubmit="SaveContact">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (validationErrors.Any())
                        {
                            <div class="status-alert error mb-3">
                                <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
                                <ul class="mb-0">
                                    @foreach (var error in validationErrors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }
                        
                        @if (errorMessage != null)
                        {
                            <div class="status-alert error mb-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                            </div>
                        }
                        
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-person me-2"></i>First Name *
                                    </label>
                                    <InputText @bind-Value="currentContact.FirstName" 
                                               class="form-control modern-input" 
                                               placeholder="Emergency contact's first name" />
                                    <ValidationMessage For="@(() => currentContact.FirstName)" class="validation-message" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-person me-2"></i>Last Name *
                                    </label>
                                    <InputText @bind-Value="currentContact.LastName" 
                                               class="form-control modern-input" 
                                               placeholder="Emergency contact's last name" />
                                    <ValidationMessage For="@(() => currentContact.LastName)" class="validation-message" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-heart me-2"></i>Relationship *
                                    </label>
                                    <InputSelect @bind-Value="currentContact.Relationship" class="form-select modern-select">
                                        <option value="">-- Select Relationship --</option>
                                        <option value="Spouse">Spouse</option>
                                        <option value="Parent">Parent</option>
                                        <option value="Child">Child</option>
                                        <option value="Sibling">Sibling</option>
                                        <option value="Partner">Partner</option>
                                        <option value="Friend">Friend</option>
                                        <option value="Guardian">Guardian</option>
                                        <option value="Other Family">Other Family</option>
                                        <option value="Other">Other</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => currentContact.Relationship)" class="validation-message" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-telephone me-2"></i>Phone Number *
                                    </label>
                                    <InputText @bind-Value="currentContact.Phone" 
                                               class="form-control modern-input" 
                                               placeholder="(555) 123-4567" />
                                    <ValidationMessage For="@(() => currentContact.Phone)" class="validation-message" />
                                    <div class="input-help">Include area code for best contact results</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary-modern" @onclick="CloseDialog">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn-primary-modern @(isLoading ? "loading" : "")" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-2"></i>
                                <span>Save Emergency Contact</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Status Messages -->
    @if (successMessage != null)
    {
        <div class="status-alert success mt-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
    
    @if (errorMessage != null && !showDialog)
    {
        <div class="status-alert error mt-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }
</div>

@code {
    private List<EmergencyContactDto> emergencyContacts = new();
    private EmergencyContactDto currentContact = new();
    private bool showDialog = false;
    private string dialogTitle = "Add Emergency Contact";
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        await LoadEmergencyContacts();
    }

    private async Task LoadEmergencyContacts()
    {
        try
        {
            isLoading = true;
            var response = await Http.GetAsync("api/checkin/emergency-contacts");
            
            if (response.IsSuccessStatusCode)
            {
                var contactList = await response.Content.ReadFromJsonAsync<List<EmergencyContactDto>>();
                emergencyContacts = contactList ?? new List<EmergencyContactDto>();
                StateHasChanged();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while loading your emergency contacts. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading emergency contacts: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowAddDialog()
    {
        currentContact = new EmergencyContactDto();
        dialogTitle = "Add Emergency Contact";
        showDialog = true;
        ClearMessages();
    }

    private void EditContact(EmergencyContactDto? contact)
    {
        if (contact != null)
        {
            currentContact = new EmergencyContactDto
            {
                Id = contact.Id,
                FirstName = contact.FirstName,
                LastName = contact.LastName,
                Phone = contact.Phone,
                Relationship = contact.Relationship
            };
            dialogTitle = "Edit Emergency Contact";
            showDialog = true;
            ClearMessages();
        }
    }

    private async Task DeleteContact(EmergencyContactDto? contact)
    {
        if (contact != null && contact.Id > 0)
        {
            try
            {
                ClearMessages();
                var response = await Http.DeleteAsync($"api/checkin/emergency-contact/{contact.Id}");
                
                if (response.IsSuccessStatusCode)
                {
                    successMessage = "Emergency contact deleted successfully!";
                    await LoadEmergencyContacts();
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    await HandleValidationErrors(response);
                }
                else
                {
                    errorMessage = "An error occurred while deleting the emergency contact. Please try again.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting emergency contact: {ex.Message}";
            }
        }
    }

    private async Task SaveContact()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            var request = new SaveEmergencyContactRequest { EmergencyContact = currentContact };
            var response = await Http.PostAsJsonAsync("api/checkin/save-emergency-contact", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveEmergencyContactResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Emergency contact saved successfully!";
                    showDialog = false;
                    await LoadEmergencyContacts();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save emergency contact";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while saving the emergency contact. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving emergency contact: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "EmergencyContact.FirstName" => "First Name",
            "EmergencyContact.LastName" => "Last Name",
            "EmergencyContact.Phone" => "Phone Number",
            "EmergencyContact.Relationship" => "Relationship",
            _ => fieldName.Replace("EmergencyContact.", "")
        };
    }

    private void CloseDialog()
    {
        showDialog = false;
        ClearMessages();
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation/insurance");
    }

    private void Continue()
    {
        Navigation.NavigateTo("/checkin-form-creation/visit-intake");
    }
}

