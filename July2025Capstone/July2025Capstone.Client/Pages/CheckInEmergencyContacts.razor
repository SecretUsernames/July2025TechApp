@page "/checkin-form-creation/emergency-contacts"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

<PageTitle>Emergency Contacts - Check-in Form</PageTitle>

<div class="container py-4">
    <!-- Progress Bar -->
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted">Step 5 of 7</span>
            <span class="text-muted">Emergency Contacts</span>
        </div>
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: 71%"></div>
        </div>
    </div>

    <h3 class="mb-3">Emergency Contacts</h3>
    <p class="text-muted">Please add at least one emergency contact who can be reached in case of a medical emergency.</p>

    @if (!isAuthenticated)
    {
        <div class="alert alert-warning">
            <h4>Authentication Required</h4>
            <p>You need to be logged in to access this page.</p>
            <a href="/Account/Login" class="btn btn-primary">Login</a>
        </div>
        return;
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <!-- Add Emergency Contact Button -->
            <div class="mb-3">
                <button type="button" class="btn btn-primary" @onclick="ShowAddDialog">
                    <span class="bi bi-plus-circle me-2"></span>Add Emergency Contact
                </button>
            </div>

            <!-- Emergency Contacts Table -->
            @if (emergencyContacts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Relationship</th>
                                <th>Phone Number</th>
                                <th width="120">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var contact in emergencyContacts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-medium">@contact.FirstName @contact.LastName</div>
                                    </td>
                                    <td>@contact.Relationship</td>
                                    <td>@contact.Phone</td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-primary" @onclick="() => EditContact(contact)" title="Edit">
                                                <span class="bi bi-pencil"></span>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" @onclick="() => DeleteContact(contact)" title="Delete">
                                                <span class="bi bi-trash"></span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="text-muted">
                        <span class="bi bi-person-plus fs-1 d-block mb-3"></span>
                        <h5>No emergency contacts added yet</h5>
                        <p class="mb-0">Click "Add Emergency Contact" to get started. It's important to have at least one emergency contact.</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="mt-4 d-flex justify-content-between">
        <button type="button" @onclick="GoBack" class="btn btn-outline-secondary">
            <span class="bi bi-arrow-left me-2"></span>Back
        </button>
        <button type="button" @onclick="Continue" class="btn btn-primary">
            Continue to Medical History<span class="bi bi-arrow-right ms-2"></span>
        </button>
    </div>

    <!-- Add/Edit Emergency Contact Modal -->
    @if (showDialog)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@dialogTitle</h5>
                        <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                    </div>
                    <EditForm Model="currentContact" OnValidSubmit="SaveContact">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            @if (validationErrors.Any())
                            {
                                <div class="alert alert-danger mb-3">
                                    <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
                                    <ul class="mb-0">
                                        @foreach (var error in validationErrors)
                                        {
                                            <li>@error</li>
                                        }
                                    </ul>
                                </div>
                            }
                            
                            @if (errorMessage != null)
                            {
                                <div class="alert alert-danger mb-3" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                                </div>
                            }
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">First Name *</label>
                                    <InputText @bind-Value="currentContact.FirstName" 
                                               class="form-control" 
                                               placeholder="Emergency contact's first name" />
                                    <ValidationMessage For="@(() => currentContact.FirstName)" class="text-danger small mt-1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Last Name *</label>
                                    <InputText @bind-Value="currentContact.LastName" 
                                               class="form-control" 
                                               placeholder="Emergency contact's last name" />
                                    <ValidationMessage For="@(() => currentContact.LastName)" class="text-danger small mt-1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Relationship *</label>
                                    <InputSelect @bind-Value="currentContact.Relationship" class="form-select">
                                        <option value="">-- Select Relationship --</option>
                                        <option value="Spouse">Spouse</option>
                                        <option value="Parent">Parent</option>
                                        <option value="Child">Child</option>
                                        <option value="Sibling">Sibling</option>
                                        <option value="Partner">Partner</option>
                                        <option value="Friend">Friend</option>
                                        <option value="Guardian">Guardian</option>
                                        <option value="Other Family">Other Family</option>
                                        <option value="Other">Other</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => currentContact.Relationship)" class="text-danger small mt-1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Phone Number *</label>
                                    <InputText @bind-Value="currentContact.Phone" 
                                               class="form-control" 
                                               placeholder="e.g., (555) 123-4567" />
                                    <ValidationMessage For="@(() => currentContact.Phone)" class="text-danger small mt-1" />
                                    <div class="form-text">Include area code</div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Save Emergency Contact
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    @* Success messages are shown outside the modal since they appear after successful operations when modal is closed *@
    @if (successMessage != null)
    {
        <div class="alert alert-success mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
    
    @* Error messages outside modal are only for non-modal operations (like loading data) *@
    @if (errorMessage != null && !showDialog)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }
</div>

@code {
    private List<EmergencyContactDto> emergencyContacts = new();
    private EmergencyContactDto currentContact = new();
    private bool showDialog = false;
    private string dialogTitle = "Add Emergency Contact";
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        await LoadEmergencyContacts();
    }

    private async Task LoadEmergencyContacts()
    {
        try
        {
            isLoading = true;
            var response = await Http.GetAsync("api/checkin/emergency-contacts");
            
            if (response.IsSuccessStatusCode)
            {
                var contactList = await response.Content.ReadFromJsonAsync<List<EmergencyContactDto>>();
                emergencyContacts = contactList ?? new List<EmergencyContactDto>();
                StateHasChanged();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while loading your emergency contacts. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading emergency contacts: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowAddDialog()
    {
        currentContact = new EmergencyContactDto();
        dialogTitle = "Add Emergency Contact";
        showDialog = true;
        ClearMessages();
    }

    private void EditContact(EmergencyContactDto? contact)
    {
        if (contact != null)
        {
            currentContact = new EmergencyContactDto
            {
                Id = contact.Id,
                FirstName = contact.FirstName,
                LastName = contact.LastName,
                Phone = contact.Phone,
                Relationship = contact.Relationship
            };
            dialogTitle = "Edit Emergency Contact";
            showDialog = true;
            ClearMessages();
        }
    }

    private async Task DeleteContact(EmergencyContactDto? contact)
    {
        if (contact != null && contact.Id > 0)
        {
            try
            {
                ClearMessages();
                var response = await Http.DeleteAsync($"api/checkin/emergency-contact/{contact.Id}");
                
                if (response.IsSuccessStatusCode)
                {
                    successMessage = "Emergency contact deleted successfully!";
                    await LoadEmergencyContacts();
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    await HandleValidationErrors(response);
                }
                else
                {
                    errorMessage = "An error occurred while deleting the emergency contact. Please try again.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting emergency contact: {ex.Message}";
            }
        }
    }

    private async Task SaveContact()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            var request = new SaveEmergencyContactRequest { EmergencyContact = currentContact };
            var response = await Http.PostAsJsonAsync("api/checkin/save-emergency-contact", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveEmergencyContactResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Emergency contact saved successfully!";
                    showDialog = false;
                    await LoadEmergencyContacts();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save emergency contact";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while saving the emergency contact. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving emergency contact: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "EmergencyContact.FirstName" => "First Name",
            "EmergencyContact.LastName" => "Last Name",
            "EmergencyContact.Phone" => "Phone Number",
            "EmergencyContact.Relationship" => "Relationship",
            _ => fieldName.Replace("EmergencyContact.", "")
        };
    }

    private void CloseDialog()
    {
        showDialog = false;
        ClearMessages();
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation/insurance");
    }

    private void Continue()
    {
        Navigation.NavigateTo("/checkin-form-creation/medical-history");
    }
}