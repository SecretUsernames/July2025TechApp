@page "/checkin-form-creation"
@using System.Net.Http.Json
@rendermode InteractiveWebAssembly

<PageTitle>Check-in Form Management</PageTitle>

<div class="container py-4">
    <!-- Modern Hero Banner -->
    <div class="med-banner mb-4">
        <h1 class="mb-1">Check-in Form Management</h1>
        <p class="mb-0">
            Manage your check-in information for faster hospital visits.
        </p>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading your check-in information...</span>
            </div>
            <div class="ms-3">
                <p class="text-muted mb-0">Loading your check-in information...</p>
            </div>
        </div>
    }
    else if (!isAuthenticated)
    {
        <div class="med-card">
            <div class="card-body text-center py-4">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                <span>Redirecting to login...</span>
            </div>
        </div>
    }
    else
    {
        @if (hasExistingForm)
        {
            <!-- Modern Check-in Information Summary -->
            @if (completionStatus != null)
            {
                <div class="med-card mb-4">
                    <div class="card-header bg-gradient text-white" style="background: var(--brand-gradient) !important; border-radius: 14px 14px 0 0;">
                        <h5 class="mb-0"><i class="bi bi-check-circle-fill me-2"></i>Check-in Information Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <!-- Personal Information Section -->
                                <div class="info-section">
                                    <div class="info-header">
                                        <i class="bi bi-person-fill me-2 text-primary"></i>
                                        <span class="info-title">Personal Information</span>
                                    </div>
                                    <div class="status-badge">
                                        @if (completionStatus.HasPersonalInfo && completionStatus.HasAddress)
                                        {
                                            <span class="badge-soft badge-soft-success">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft">Pending</span>
                                        }
                                    </div>
                                </div>
                                
                                <!-- Medications Section -->
                                <div class="info-section">
                                    <div class="info-header">
                                        <i class="bi bi-capsule me-2 text-primary"></i>
                                        <span class="info-title">Medications</span>
                                    </div>
                                    <div class="status-badge">
                                        @if (completionStatus.HasMedications)
                                        {
                                            <span class="badge-soft badge-soft-info">Optional - Added</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft">Optional</span>
                                        }
                                    </div>
                                </div>
                                
                                <!-- Medical History Section -->
                                <div class="info-section">
                                    <div class="info-header">
                                        <i class="bi bi-heart-pulse me-2 text-primary"></i>
                                        <span class="info-title">Medical History</span>
                                    </div>
                                    <div class="status-badge">
                                        @if (completionStatus.HasAllergies)
                                        {
                                            <span class="badge-soft badge-soft-info">Optional - Added</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft">Optional</span>
                                        }
                                    </div>
                                </div>
                                
                                <!-- Insurance Section -->
                                <div class="info-section">
                                    <div class="info-header">
                                        <i class="bi bi-shield-check me-2 text-primary"></i>
                                        <span class="info-title">Insurance</span>
                                    </div>
                                    <div class="status-badge">
                                        @if (completionStatus.HasInsurance)
                                        {
                                            <span class="badge-soft badge-soft-success">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft">Pending</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <!-- Emergency Contacts Section -->
                                <div class="info-section">
                                    <div class="info-header">
                                        <i class="bi bi-person-lines-fill me-2 text-primary"></i>
                                        <span class="info-title">Emergency Contacts</span>
                                    </div>
                                    <div class="status-badge">
                                        @if (completionStatus.HasEmergencyContacts)
                                        {
                                            <span class="badge-soft badge-soft-success">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft">Pending</span>
                                        }
                                    </div>
                                </div>
                                
                                <!-- Reason for Visit Section -->
                                <div class="info-section">
                                    <div class="info-header">
                                        <i class="bi bi-clipboard-pulse me-2 text-primary"></i>
                                        <span class="info-title">Reason for Visit</span>
                                    </div>
                                    <div class="status-badge">
                                        @if (completionStatus.HasVisitIntake)
                                        {
                                            <span class="badge-soft badge-soft-success">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft">Pending</span>
                                        }
                                    </div>
                                </div>
                                
                                <!-- Lifestyle Information Section -->
                                <div class="info-section">
                                    <div class="info-header">
                                        <i class="bi bi-activity me-2 text-primary"></i>
                                        <span class="info-title">Lifestyle Information</span>
                                    </div>
                                    <div class="status-badge">
                                        @if (completionStatus.HasLifestyle)
                                        {
                                            <span class="badge-soft badge-soft-success">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft">Pending</span>
                                        }
                                    </div>
                                </div>
                                
                                <!-- Consent Section -->
                                <div class="info-section">
                                    <div class="info-header">
                                        <i class="bi bi-file-text me-2 text-primary"></i>
                                        <span class="info-title">Consent</span>
                                    </div>
                                    <div class="status-badge">
                                        @if (completionStatus.HasConsent)
                                        {
                                            <span class="badge-soft badge-soft-success">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge-soft">Pending</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Overall Progress Bar -->
                        <div class="progress-section mt-4">
                            <div class="progress-header">
                                <i class="bi bi-bar-chart me-2 text-primary"></i>
                                <span class="progress-title">Overall Progress</span>
                            </div>
                            @{
                                var completedSections = 0;
                                var totalSections = 6; // Personal Info, Insurance, Emergency Contacts, Lifestyle, Reason for Visit, Consent
                                
                                if (completionStatus.HasPersonalInfo && completionStatus.HasAddress) completedSections++;
                                if (completionStatus.HasInsurance) completedSections++;
                                if (completionStatus.HasEmergencyContacts) completedSections++;
                                if (completionStatus.HasLifestyle) completedSections++;
                                if (completionStatus.HasVisitIntake) completedSections++;
                                if (completionStatus.HasConsent) completedSections++;
                                
                                var progressPercentage = totalSections > 0 ? (completedSections * 100 / totalSections) : 0;
                            }
                            
                            <div class="modern-progress mb-3">
                                <div class="progress-bar-modern @(progressPercentage == 100 ? "complete" : "")" 
                                     style="width: @(progressPercentage)%">
                                    <span class="progress-text">@(progressPercentage)%</span>
                                </div>
                            </div>
                            <small class="text-muted">@completedSections of @totalSections required sections completed</small>
                            
                            @if (progressPercentage < 100)
                            {
                                <div class="action-section mt-4">
                                    <h6 class="section-subtitle text-warning mb-3">
                                        <i class="bi bi-exclamation-triangle me-2"></i>Complete These Required Sections:
                                    </h6>
                                    <div class="action-buttons">
                                        @if (!completionStatus.HasPersonalInfo || !completionStatus.HasAddress)
                                        {
                                            <a href="/checkin-form-creation/personal-info" class="action-btn btn-warning">
                                                <i class="bi bi-person me-1"></i>Personal Info
                                            </a>
                                        }
                                        @if (!completionStatus.HasInsurance)
                                        {
                                            <a href="/checkin-form-creation/insurance" class="action-btn btn-warning">
                                                <i class="bi bi-shield-check me-1"></i>Insurance
                                            </a>
                                        }
                                        @if (!completionStatus.HasEmergencyContacts)
                                        {
                                            <a href="/checkin-form-creation/emergency-contacts" class="action-btn btn-warning">
                                                <i class="bi bi-person-lines-fill me-1"></i>Emergency Contacts
                                            </a>
                                        }
                                        @if (!completionStatus.HasLifestyle)
                                        {
                                            <a href="/checkin-form-creation/lifestyle" class="action-btn btn-warning">
                                                <i class="bi bi-activity me-1"></i>Lifestyle
                                            </a>
                                        }
                                        @if (!completionStatus.HasVisitIntake)
                                        {
                                            <a href="/checkin-form-creation/visit-intake" class="action-btn btn-warning">
                                                <i class="bi bi-clipboard-pulse me-1"></i>Reason for Visit
                                            </a>
                                        }
                                        @if (!completionStatus.HasConsent)
                                        {
                                            <a href="/checkin-form-creation/review" class="action-btn btn-warning">
                                                <i class="bi bi-file-text me-1"></i>Consent
                                            </a>
                                        }
                                    </div>
                                    
                                    <!-- Optional sections -->
                                    <div class="mt-4">
                                        <h6 class="section-subtitle text-info mb-3">
                                            <i class="bi bi-plus-circle me-2"></i>Optional Sections (Add if Applicable):
                                        </h6>
                                        <div class="action-buttons">
                                            <a href="/checkin-form-creation/medications" class="action-btn btn-info">
                                                <i class="bi bi-capsule me-1"></i>Medications @(completionStatus.HasMedications ? "(Added)" : "")
                                            </a>
                                            <a href="/checkin-form-creation/medical-history" class="action-btn btn-info">
                                                <i class="bi bi-heart-pulse me-1"></i>Medical History @(completionStatus.HasAllergies ? "(Added)" : "")
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="mt-4">
                                    <div class="success-message">
                                        <i class="bi bi-check-circle-fill me-2"></i>
                                        <strong>Congratulations!</strong> All required sections are complete and your check-in form is ready to use.
                                    </div>
                                    
                                    <!-- Still show optional sections -->
                                    <div class="mt-4">
                                        <h6 class="section-subtitle text-info mb-3">
                                            <i class="bi bi-plus-circle me-2"></i>Optional Sections (Add if Applicable):
                                        </h6>
                                        <div class="action-buttons">
                                            <a href="/checkin-form-creation/medications" class="action-btn btn-info">
                                                <i class="bi bi-capsule me-1"></i>Medications @(completionStatus.HasMedications ? "(Added)" : "")
                                            </a>
                                            <a href="/checkin-form-creation/medical-history" class="action-btn btn-info">
                                                <i class="bi bi-heart-pulse me-1"></i>Medical History @(completionStatus.HasAllergies ? "(Added)" : "")
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Fallback if completion status is null -->
                <div class="med-card mb-4">
                    <div class="card-body">
                        <div class="warning-state">
                            <i class="bi bi-exclamation-triangle text-warning fs-2 mb-3"></i>
                            <h6>Progress Information Unavailable</h6>
                            <p class="text-muted mb-0">We're having trouble loading your progress information. The summary will appear once this is resolved.</p>
                        </div>
                    </div>
                </div>
            }

            <!-- User has existing form - Modern Action Cards -->
            <div class="row g-4">
                <div class="col-md-8">
                    <div class="med-card">
                        <div class="card-body">
                            @{
                                var allRequiredComplete = completionStatus != null && 
                                    completionStatus.HasPersonalInfo && 
                                    completionStatus.HasAddress && 
                                    completionStatus.HasInsurance && 
                                    completionStatus.HasEmergencyContacts && 
                                    completionStatus.HasLifestyle && 
                                    completionStatus.HasVisitIntake && 
                                    completionStatus.HasConsent;
                            }
                            
                            <div class="form-status-header">
                                @if (allRequiredComplete)
                                {
                                    <div class="status-icon complete">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                    <h5 class="status-title">Your Check-in Form is Complete</h5>
                                }
                                else
                                {
                                    <div class="status-icon pending">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                    </div>
                                    <h5 class="status-title">Your Check-in Form Needs Attention</h5>
                                }
                            </div>
                            
                            @if (!allRequiredComplete)
                            {
                                <div class="warning-message">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Complete all required sections above to generate your PDF.
                                </div>
                            }
                            
                            @if (existingFormSummary != null)
                            {
                                <div class="form-meta @(isEditingForm ? "updating" : "") @(hasLocalUpdates && !isEditingForm ? "updated" : "")">
                                    @if (isEditingForm)
                                    {
                                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                                        <span>Last updated: @existingFormSummary.LastModified.ToString("MMM dd, yyyy 'at' h:mm tt") - Opening editor...</span>
                                    }
                                    else
                                    {
                                        <span>Last updated: @existingFormSummary.LastModified.ToString("MMM dd, yyyy 'at' h:mm tt")</span>
                                        @if (hasLocalUpdates)
                                        {
                                            <span class="update-badge">Updated!</span>
                                        }
                                    }
                                </div>
                                <p class="form-name">@existingFormSummary.Name</p>
                            }
                            
                            <div class="action-buttons-primary">
                                <button class="btn-primary-modern @(allRequiredComplete ? "complete" : "disabled")" 
                                        @onclick="GenerateCheckInPdf" 
                                        disabled="@(isLoading || isEditingForm || !allRequiredComplete)"
                                        title="@(allRequiredComplete ? "Generate your check-in PDF" : "Complete all required sections to generate PDF")">
                                    <i class="bi bi-file-earmark-pdf me-2"></i>
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    @if (!allRequiredComplete)
                                    {
                                        <i class="bi bi-exclamation-triangle me-2"></i>
                                    }
                                    <span class="btn-text">Generate Check-in PDF</span>
                                    @if (!allRequiredComplete)
                                    {
                                        <small class="btn-subtext">Complete required sections first</small>
                                    }
                                </button>
                                <button class="btn-secondary-modern" @onclick="EditForm" disabled="@(isLoading || isEditingForm)">
                                    @if (isEditingForm)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-pencil-square me-2"></i>
                                    }
                                    <span class="btn-text">@(isEditingForm ? "Opening Editor..." : "Edit Form")</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4">
                    @if (allRequiredComplete)
                    {
                        <div class="med-card status-ready">
                            <div class="card-body text-center">
                                <div class="status-graphic">
                                    <i class="bi bi-check-circle text-success"></i>
                                </div>
                                <h6 class="status-card-title">Ready to Go!</h6>
                                <p class="status-card-text">
                                    Your form is complete. Generate your PDF before your appointment and bring it with you for faster check-in.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="med-card status-pending">
                            <div class="card-body text-center">
                                <div class="status-graphic">
                                    <i class="bi bi-exclamation-triangle text-warning"></i>
                                </div>
                                <h6 class="status-card-title">Almost There!</h6>
                                <p class="status-card-text">
                                    Complete the required sections shown above to generate your check-in PDF.
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- User needs to create form - Modern Welcome -->
            <div class="row g-4">
                <div class="col-md-8">
                    <div class="med-card welcome-card">
                        <div class="card-body text-center py-5">
                            <div class="welcome-icon">
                                <i class="bi bi-clipboard-plus"></i>
                            </div>
                            <h5 class="welcome-title">Create Your First Check-in Form</h5>
                            <p class="welcome-text">
                                Set up your check-in information once and save time at every medical appointment.
                            </p>
                            
                            <button class="btn-create-form" @onclick="StartFormCreation">
                                <i class="bi bi-plus-circle me-2"></i>
                                Create Check-in Form
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="med-card info-card">
                        <div class="card-body">
                            <div class="med-section-title">What you'll add</div>
                            <div class="checklist">
                                <div class="checklist-item required">
                                    <i class="bi bi-check2 text-success me-2"></i>
                                    <span>Personal Information</span>
                                </div>
                                <div class="checklist-item required">
                                    <i class="bi bi-check2 text-success me-2"></i>
                                    <span>Insurance Details</span>
                                </div>
                                <div class="checklist-item required">
                                    <i class="bi bi-check2 text-success me-2"></i>
                                    <span>Emergency Contacts</span>
                                </div>
                                <div class="checklist-item required">
                                    <i class="bi bi-check2 text-success me-2"></i>
                                    <span>Lifestyle Information</span>
                                </div>
                                <div class="checklist-item required">
                                    <i class="bi bi-check2 text-success me-2"></i>
                                    <span>Reason for Visit</span>
                                </div>
                                <div class="checklist-item optional">
                                    <i class="bi bi-plus text-info me-2"></i>
                                    <span>Medical History <small class="text-muted">(Optional)</small></span>
                                </div>
                                <div class="checklist-item optional">
                                    <i class="bi bi-plus text-info me-2"></i>
                                    <span>Current Medications <small class="text-muted">(Optional)</small></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        
        @if (statusMessage != null)
        {
            <div class="status-alert @(statusMessage.IsSuccess ? "success" : "error")" role="alert">
                <i class="bi @(statusMessage.IsSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                @statusMessage.Message
            </div>
        }
    }
</div>

<style>
    /* Modern Card Enhancements */
    .med-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .med-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
    }
    
    /* Info Sections Styling */
    .info-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }
    
    .info-section:last-child {
        border-bottom: none;
    }
    
    .info-header {
        display: flex;
        align-items: center;
    }
    
    .info-title {
        font-weight: 600;
        color: #374151;
    }
    
    .status-badge .badge-soft {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    /* Modern Progress Bar */
    .progress-section {
        padding-top: 20px;
        border-top: 2px solid rgba(59, 130, 246, 0.1);
    }
    
    .progress-header {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }
    
    .progress-title {
        font-weight: 600;
        color: #374151;
    }
    
    .modern-progress {
        background: #f1f5f9;
        border-radius: 12px;
        height: 24px;
        overflow: hidden;
        position: relative;
    }
    
    .progress-bar-modern {
        background: linear-gradient(90deg, var(--teal-500), var(--brand-600));
        height: 100%;
        border-radius: 12px;
        transition: width 0.6s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }
    
    .progress-bar-modern.complete {
        background: linear-gradient(90deg, #10b981, #059669);
    }
    
    .progress-text {
        color: white;
        font-weight: 600;
        font-size: 0.875rem;
    }
    
    /* Action Sections */
    .action-section {
        background: rgba(59, 130, 246, 0.03);
        border-radius: 12px;
        padding: 20px;
    }
    
    .section-subtitle {
        font-weight: 600;
        display: flex;
        align-items: center;
    }
    
    .action-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    
    .action-btn {
        padding: 8px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.875rem;
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }
    
    .action-btn.btn-warning {
        background: rgba(245, 158, 11, 0.1);
        color: #92400e;
        border-color: rgba(245, 158, 11, 0.2);
    }
    
    .action-btn.btn-warning:hover {
        background: rgba(245, 158, 11, 0.2);
        transform: translateY(-1px);
    }
    
    .action-btn.btn-info {
        background: rgba(59, 130, 246, 0.1);
        color: #1d4ed8;
        border-color: rgba(59, 130, 246, 0.2);
    }
    
    .action-btn.btn-info:hover {
        background: rgba(59, 130, 246, 0.2);
        transform: translateY(-1px);
    }
    
    /* Success Message */
    .success-message {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 12px;
        padding: 16px;
        color: #065f46;
    }
    
    /* Form Status */
    .form-status-header {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }
    
    .status-icon {
        margin-right: 12px;
        font-size: 1.5rem;
    }
    
    .status-icon.complete {
        color: #10b981;
    }
    
    .status-icon.pending {
        color: #f59e0b;
    }
    
    .status-title {
        font-weight: 600;
        margin: 0;
        color: #374151;
    }
    
    .warning-message {
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.2);
        border-radius: 8px;
        padding: 12px;
        color: #92400e;
        font-size: 0.875rem;
        margin-bottom: 16px;
    }
    
    .form-meta {
        color: #6b7280;
        font-size: 0.875rem;
        margin-bottom: 8px;
    }
    
    .form-meta.updating {
        animation: pulse-blue 1s ease-in-out;
        color: var(--brand-600);
        font-weight: 600;
    }
    
    .form-meta.updated {
        animation: highlight-green 2s ease-in-out;
    }
    
    .update-badge {
        background: #10b981;
        color: white;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.75rem;
        margin-left: 8px;
    }
    
    .form-name {
        color: #374151;
        font-weight: 500;
        margin-bottom: 20px;
    }
    
    /* Modern Action Buttons */
    .action-buttons-primary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    
    .btn-primary-modern {
