@page "/checkin-form-creation"
@using System.Net.Http.Json
@rendermode InteractiveWebAssembly

<PageTitle>Check-in Form Management</PageTitle>

<h3 class="mb-3">Check-in Form Management</h3>
<p class="text-muted">Manage your check-in information for faster hospital visits.</p>

@if (isLoading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading your check-in information...</span>
        </div>
    </div>
}
else
{
    @if (hasExistingForm)
    {
        <!-- User has existing form -->
        <div class="row g-4">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <span class="bi bi-check-circle-fill text-success me-2 fs-4"></span>
                            <h5 class="card-title mb-0">Your Check-in Form is Ready</h5>
                        </div>
                        
                        @if (existingFormSummary != null)
                        {
                            <p class="text-muted mb-3">
                                Last updated: @existingFormSummary.LastModified.ToString("MMM dd, yyyy")
                            </p>
                            <p class="mb-4">@existingFormSummary.Name</p>
                        }
                        
                        <div class="d-grid gap-2 d-md-flex">
                            <button class="btn btn-success flex-fill" @onclick="GenerateCheckInPdf">
                                <span class="bi bi-file-earmark-pdf me-2"></span>
                                Generate Check-in PDF
                            </button>
                            <button class="btn btn-outline-primary flex-fill" @onclick="EditForm">
                                <span class="bi bi-pencil-square me-2"></span>
                                Edit Form
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card border-info">
                    <div class="card-body text-center">
                        <span class="bi bi-info-circle text-info fs-2"></span>
                        <h6 class="card-title mt-2">Quick Tip</h6>
                        <p class="card-text small">
                            Generate your PDF before your appointment and bring it with you for faster check-in.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- User needs to create form -->
        <div class="row g-4">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <span class="bi bi-clipboard-plus text-primary fs-1 mb-3 d-block"></span>
                        <h5 class="card-title">Create Your First Check-in Form</h5>
                        <p class="text-muted mb-4">
                            Set up your check-in information once and save time at every medical appointment.
                        </p>
                        
                        <button class="btn btn-primary btn-lg" @onclick="StartFormCreation">
                            <span class="bi bi-plus-circle me-2"></span>
                            Create Check-in Form
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card border-primary">
                    <div class="card-body">
                        <h6 class="card-title">What you'll add:</h6>
                        <ul class="list-unstyled mb-0">
                            <li><span class="bi bi-check2 text-success me-2"></span>Personal Information</li>
                            <li><span class="bi bi-check2 text-success me-2"></span>Insurance Details</li>
                            <li><span class="bi bi-check2 text-success me-2"></span>Emergency Contacts</li>
                            <li><span class="bi bi-check2 text-success me-2"></span>Medical History</li>
                            <li><span class="bi bi-check2 text-success me-2"></span>Current Medications</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
    
    @if (statusMessage != null)
    {
        <div class="alert @(statusMessage.IsSuccess ? "alert-success" : "alert-danger") mt-4" role="alert">
            @statusMessage.Message
        </div>
    }
}