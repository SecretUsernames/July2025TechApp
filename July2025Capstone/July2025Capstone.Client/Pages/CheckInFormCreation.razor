@page "/checkin-form-creation"
@using System.Net.Http.Json
@rendermode InteractiveWebAssembly

<PageTitle>Check-in Form Management</PageTitle>

<h3 class="mb-3">Check-in Form Management</h3>
<p class="text-muted">Manage your check-in information for faster hospital visits.</p>

@if (isLoading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading your check-in information...</span>
        </div>
        <div class="ms-3">
            <p class="text-muted mb-0">Loading your check-in information...</p>
        </div>
    </div>
}
else if (!isAuthenticated)
{
    <div class="alert alert-info text-center py-4">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
        <span>Redirecting to login...</span>
    </div>
}
else
{
    @if (hasExistingForm)
    {
        <!-- Check-in Information Summary -->
        @if (completionStatus != null)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-check-circle-fill me-2"></i>Check-in Information Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-primary mb-3"><i class="bi bi-person-fill me-2"></i>Personal Information</h6>
                            <p class="mb-1"><strong>Status:</strong> 
                                @if (completionStatus.HasPersonalInfo && completionStatus.HasAddress)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </p>
                            
                            <h6 class="text-primary mt-3 mb-3"><i class="bi bi-capsule me-2"></i>Medications</h6>
                            <p class="mb-1"><strong>Status:</strong> 
                                @if (completionStatus.HasMedications)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </p>
                            
                            <h6 class="text-primary mt-3 mb-3"><i class="bi bi-heart-pulse me-2"></i>Medical History</h6>
                            <p class="mb-1"><strong>Status:</strong> 
                                @if (completionStatus.HasAllergies)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </p>
                            
                            <h6 class="text-primary mt-3 mb-3"><i class="bi bi-shield-check me-2"></i>Insurance</h6>
                            <p class="mb-1"><strong>Status:</strong> 
                                @if (completionStatus.HasInsurance)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-primary mb-3"><i class="bi bi-person-lines-fill me-2"></i>Emergency Contacts</h6>
                            <p class="mb-1"><strong>Status:</strong> 
                                @if (completionStatus.HasEmergencyContacts)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </p>
                            
                            <h6 class="text-primary mt-3 mb-3"><i class="bi bi-clipboard-pulse me-2"></i>Reason for Visit</h6>
                            <p class="mb-1"><strong>Status:</strong> 
                                @if (completionStatus.HasVisitIntake)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </p>
                            
                            <h6 class="text-primary mt-3 mb-3"><i class="bi bi-activity me-2"></i>Lifestyle Information</h6>
                            <p class="mb-1"><strong>Status:</strong> 
                                @if (completionStatus.HasLifestyle)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </p>
                            
                            <h6 class="text-primary mt-3 mb-3"><i class="bi bi-file-text me-2"></i>Consent</h6>
                            <p class="mb-1"><strong>Status:</strong> 
                                @if (completionStatus.HasConsent)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </p>
                        </div>
                    </div>
                    
                    <!-- Overall Progress Bar -->
                    <hr class="my-3">
                    <div class="row">
                        <div class="col-12">
                            <h6 class="text-primary mb-2"><i class="bi bi-bar-chart me-2"></i>Overall Progress</h6>
                            @{
                                var completedSections = 0;
                                var totalSections = 8; // Personal Info, Medications, Medical History, Insurance, Emergency Contacts, Lifestyle, Reason for Visit, Consent
                                
                                if (completionStatus.HasPersonalInfo && completionStatus.HasAddress) completedSections++;
                                if (completionStatus.HasMedications) completedSections++;
                                if (completionStatus.HasAllergies) completedSections++;
                                if (completionStatus.HasInsurance) completedSections++;
                                if (completionStatus.HasEmergencyContacts) completedSections++;
                                if (completionStatus.HasLifestyle) completedSections++;
                                if (completionStatus.HasVisitIntake) completedSections++;
                                if (completionStatus.HasConsent) completedSections++;
                                
                                var progressPercentage = totalSections > 0 ? (completedSections * 100 / totalSections) : 0;
                            }
                            
                            <div class="progress mb-2" style="height: 20px;">
                                <div class="progress-bar @(progressPercentage == 100 ? "bg-success" : "bg-primary")" role="progressbar" 
                                     style="width: @(progressPercentage)%" 
                                     aria-valuenow="@progressPercentage" 
                                     aria-valuemin="0" 
                                     aria-valuemax="100">
                                    @(progressPercentage)%
                                </div>
                            </div>
                            <small class="text-muted">@completedSections of @totalSections sections completed</small>
                            
                            @if (progressPercentage < 100)
                            {
                                <div class="mt-3">
                                    <h6 class="text-warning mb-2"><i class="bi bi-exclamation-triangle me-2"></i>Complete These Sections:</h6>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (!completionStatus.HasPersonalInfo || !completionStatus.HasAddress)
                                        {
                                            <a href="/checkin-form-creation/personal-info" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-person me-1"></i>Personal Info
                                            </a>
                                        }
                                        @if (!completionStatus.HasMedications)
                                        {
                                            <a href="/checkin-form-creation/medications" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-capsule me-1"></i>Medications
                                            </a>
                                        }
                                        @if (!completionStatus.HasAllergies)
                                        {
                                            <a href="/checkin-form-creation/medical-history" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-heart-pulse me-1"></i>Medical History
                                            </a>
                                        }
                                        @if (!completionStatus.HasInsurance)
                                        {
                                            <a href="/checkin-form-creation/insurance" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-shield-check me-1"></i>Insurance
                                            </a>
                                        }
                                        @if (!completionStatus.HasEmergencyContacts)
                                        {
                                            <a href="/checkin-form-creation/emergency-contacts" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-person-lines-fill me-1"></i>Emergency Contacts
                                            </a>
                                        }
                                        @if (!completionStatus.HasLifestyle)
                                        {
                                            <a href="/checkin-form-creation/lifestyle" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-activity me-1"></i>Lifestyle
                                            </a>
                                        }
                                        @if (!completionStatus.HasVisitIntake)
                                        {
                                            <a href="/checkin-form-creation/visit-intake" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-clipboard-pulse me-1"></i>Reason for Visit
                                            </a>
                                        }
                                        @if (!completionStatus.HasConsent)
                                        {
                                            <a href="/checkin-form-creation/review" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-file-text me-1"></i>Consent
                                            </a>
                                        }
                                    </div>
                                    <small class="text-muted mt-2 d-block">
                                        <i class="bi bi-info-circle me-1"></i>
                                        All sections are now dynamically tracked based on your actual data.
                                    </small>
                                </div>
                            }
                            else
                            {
                                <div class="mt-3">
                                    <div class="alert alert-success mb-0" role="alert">
                                        <i class="bi bi-check-circle-fill me-2"></i>
                                        <strong>Congratulations!</strong> Your check-in form is complete and ready to use.
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Fallback if completion status is null -->
            <div class="alert alert-warning mb-4">
                <h6><i class="bi bi-exclamation-triangle me-2"></i>Progress Information Unavailable</h6>
                <p class="mb-0">We're having trouble loading your progress information. The summary will appear once this is resolved.</p>
            </div>
        }

        <!-- User has existing form -->
        <div class="row g-4">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <span class="bi bi-check-circle-fill text-success me-2 fs-4"></span>
                            <h5 class="card-title mb-0">Your Check-in Form is Ready</h5>
                        </div>
                        
                        @if (existingFormSummary != null)
                        {
                            <p class="text-muted mb-3 @(isEditingForm ? "text-primary fw-bold date-updating" : "") @(hasLocalUpdates && !isEditingForm ? "date-updated" : "")">
                                @if (isEditingForm)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Last updated: @existingFormSummary.LastModified.ToString("MMM dd, yyyy 'at' h:mm tt") - Opening editor...</span>
                                }
                                else
                                {
                                    <span>Last updated: @existingFormSummary.LastModified.ToString("MMM dd, yyyy 'at' h:mm tt")</span>
                                    @if (hasLocalUpdates)
                                    {
                                        <span class="badge bg-success ms-2">Updated!</span>
                                    }
                                }
                            </p>
                            <p class="mb-4">@existingFormSummary.Name</p>
                        }
                        
                        <div class="d-grid gap-2 d-md-flex">
                            <button class="btn btn-success flex-fill" @onclick="GenerateCheckInPdf" disabled="@(isLoading || isEditingForm)">
                                <span class="bi bi-file-earmark-pdf me-2"></span>
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                Generate Check-in PDF
                            </button>
                            <button class="btn btn-outline-primary flex-fill" @onclick="EditForm" disabled="@(isLoading || isEditingForm)">
                                @if (isEditingForm)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                else
                                {
                                    <span class="bi bi-pencil-square me-2"></span>
                                }
                                @(isEditingForm ? "Opening Editor..." : "Edit Form")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card border-info">
                    <div class="card-body text-center">
                        <span class="bi bi-info-circle text-info fs-2"></span>
                        <h6 class="card-title mt-2">Quick Tip</h6>
                        <p class="card-text small">
                            Generate your PDF before your appointment and bring it with you for faster check-in.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- User needs to create form -->
        <div class="row g-4">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <span class="bi bi-clipboard-plus text-primary fs-1 mb-3 d-block"></span>
                        <h5 class="card-title">Create Your First Check-in Form</h5>
                        <p class="text-muted mb-4">
                            Set up your check-in information once and save time at every medical appointment.
                        </p>
                        
                        <button class="btn btn-primary btn-lg" @onclick="StartFormCreation">
                            <span class="bi bi-plus-circle me-2"></span>
                            Create Check-in Form
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card border-primary">
                    <div class="card-body">
                        <h6 class="card-title">What you'll add:</h6>
                        <ul class="list-unstyled mb-0">
                            <li><span class="bi bi-check2 text-success me-2"></span>Personal Information</li>
                            <li><span class="bi bi-check2 text-success me-2"></span>Insurance Details</li>
                            <li><span class="bi bi-check2 text-success me-2"></span>Emergency Contacts</li>
                            <li><span class="bi bi-check2 text-success me-2"></span>Medical History</li>
                            <li><span class="bi bi-check2 text-success me-2"></span>Current Medications</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
    
    @if (statusMessage != null)
    {
        <div class="alert @(statusMessage.IsSuccess ? "alert-success" : "alert-danger") mt-4" role="alert">
            @statusMessage.Message
        </div>
    }
}

<style>
    .date-updating {
        animation: pulse-blue 1s ease-in-out;
    }
    
    .date-updated {
        animation: highlight-green 2s ease-in-out;
    }
    
    @@keyframes pulse-blue {
        0% { background-color: transparent; }
        50% { background-color: rgba(13, 110, 253, 0.1); }
        100% { background-color: transparent; }
    }
    
    @@keyframes highlight-green {
        0% { background-color: rgba(25, 135, 84, 0.2); }
        100% { background-color: transparent; }
    }

    .progress {
        border-radius: 10px;
    }
    
    .progress-bar {
        border-radius: 10px;
        transition: width 0.6s ease;
    }
</style>
