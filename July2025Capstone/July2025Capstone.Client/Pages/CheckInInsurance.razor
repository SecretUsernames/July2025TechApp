@page "/checkin-form-creation/insurance"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

<PageTitle>Insurance - Check-in Form</PageTitle>

<div class="container py-4">
    <!-- Progress Bar -->
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted">Step 4 of 8</span>
            <span class="text-muted">Insurance Information</span>
        </div>
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: 50%"></div>
        </div>
    </div>

    <h3 class="mb-3">Insurance Information</h3>
    <p class="text-muted">Please add your insurance policy details. You can add multiple insurance policies if needed.</p>

    @if (!isAuthenticated)
    {
        <div class="alert alert-warning">
            <h4>Authentication Required</h4>
            <p>You need to be logged in to access this page.</p>
            <a href="/Account/Login" class="btn btn-primary">Login</a>
        </div>
        return;
    }

    @if (validationErrors.Any())
    {
        <div class="alert alert-danger mb-4">
            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <!-- Add Insurance Button -->
            <div class="mb-3">
                <button type="button" class="btn btn-primary" @onclick="ShowAddDialog">
                    <span class="bi bi-plus-circle me-2"></span>Add Insurance Policy
                </button>
            </div>

            <!-- Insurance Policies Table -->
            @if (insurancePolicies.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Provider</th>
                                <th>Policy Number</th>
                                <th>Group Number</th>
                                <th>Policyholder</th>
                                <th width="120">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var insurance in insurancePolicies)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-medium">@insurance.Provider</div>
                                    </td>
                                    <td>@insurance.PolicyNumber</td>
                                    <td>@insurance.GroupNumber</td>
                                    <td>
                                        <div>@insurance.PolicyholderName</div>
                                        <small class="text-muted">(@insurance.RelationshipToPatient)</small>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-primary" @onclick="() => EditInsurance(insurance)" title="Edit">
                                                <span class="bi bi-pencil"></span>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" @onclick="() => DeleteInsurance(insurance)" title="Delete">
                                                <span class="bi bi-trash"></span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="text-muted">
                        <span class="bi bi-shield-plus fs-1 d-block mb-3"></span>
                        <h5>No insurance policies added yet</h5>
                        <p class="mb-0">Click "Add Insurance Policy" to get started</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Navigation Buttons -->
    <div class="mt-4 d-flex justify-content-between">
        <button type="button" @onclick="GoBack" class="btn btn-outline-secondary">
            <span class="bi bi-arrow-left me-2"></span>Back
        </button>
        <button type="button" @onclick="Continue" class="btn btn-primary">
            Continue to Emergency Contacts<span class="bi bi-arrow-right ms-2"></span>
        </button>
    </div>

    <!-- Add/Edit Insurance Modal -->
    @if (showDialog)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@dialogTitle</h5>
                        <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                    </div>
                    <EditForm Model="currentInsurance" OnValidSubmit="SaveInsurance">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Insurance Provider *</label>
                                    <InputText @bind-Value="currentInsurance.Provider" 
                                               class="form-control" 
                                               placeholder="e.g., Blue Cross Blue Shield, Aetna, United Healthcare" />
                                    <ValidationMessage For="@(() => currentInsurance.Provider)" class="text-danger small mt-1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Policy Number *</label>
                                    <InputText @bind-Value="currentInsurance.PolicyNumber" 
                                               class="form-control" 
                                               placeholder="Policy number from insurance card" />
                                    <ValidationMessage For="@(() => currentInsurance.PolicyNumber)" class="text-danger small mt-1" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Group Number *</label>
                                    <InputText @bind-Value="currentInsurance.GroupNumber" 
                                               class="form-control" 
                                               placeholder="Group number from insurance card" />
                                    <ValidationMessage For="@(() => currentInsurance.GroupNumber)" class="text-danger small mt-1" />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label">Policyholder Name *</label>
                                    <InputText @bind-Value="currentInsurance.PolicyholderName" 
                                               class="form-control" 
                                               placeholder="Name of the person who holds the policy" />
                                    <ValidationMessage For="@(() => currentInsurance.PolicyholderName)" class="text-danger small mt-1" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Relationship to Patient *</label>
                                    <InputSelect @bind-Value="currentInsurance.RelationshipToPatient" class="form-select">
                                        <option value="">-- Select --</option>
                                        <option value="Self">Self</option>
                                        <option value="Spouse">Spouse</option>
                                        <option value="Parent">Parent</option>
                                        <option value="Child">Child</option>
                                        <option value="Other">Other</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => currentInsurance.RelationshipToPatient)" class="text-danger small mt-1" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Save Insurance Policy
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    @if (errorMessage != null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }

    @if (successMessage != null)
    {
        <div class="alert alert-success mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
</div>

@code {
    private List<InsurancePolicyDto> insurancePolicies = new();
    private InsurancePolicyDto currentInsurance = new();
    private bool showDialog = false;
    private string dialogTitle = "Add Insurance Policy";
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        await LoadInsurance();
    }

    private async Task LoadInsurance()
    {
        try
        {
            isLoading = true;
            var response = await Http.GetAsync("api/checkin/insurance");
            
            if (response.IsSuccessStatusCode)
            {
                var insuranceList = await response.Content.ReadFromJsonAsync<List<InsurancePolicyDto>>();
                insurancePolicies = insuranceList ?? new List<InsurancePolicyDto>();
                StateHasChanged();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while loading your insurance policies. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading insurance policies: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowAddDialog()
    {
        currentInsurance = new InsurancePolicyDto();
        dialogTitle = "Add Insurance Policy";
        showDialog = true;
        ClearMessages();
    }

    private void EditInsurance(InsurancePolicyDto? insurance)
    {
        if (insurance != null)
        {
            currentInsurance = new InsurancePolicyDto
            {
                Id = insurance.Id,
                Provider = insurance.Provider,
                PolicyNumber = insurance.PolicyNumber,
                GroupNumber = insurance.GroupNumber,
                PolicyholderName = insurance.PolicyholderName,
                RelationshipToPatient = insurance.RelationshipToPatient
            };
            dialogTitle = "Edit Insurance Policy";
            showDialog = true;
            ClearMessages();
        }
    }

    private async Task DeleteInsurance(InsurancePolicyDto? insurance)
    {
        if (insurance != null && insurance.Id > 0)
        {
            try
            {
                ClearMessages();
                var response = await Http.DeleteAsync($"api/checkin/insurance/{insurance.Id}");
                
                if (response.IsSuccessStatusCode)
                {
                    successMessage = "Insurance policy deleted successfully!";
                    await LoadInsurance();
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    await HandleValidationErrors(response);
                }
                else
                {
                    errorMessage = "An error occurred while deleting the insurance policy. Please try again.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting insurance policy: {ex.Message}";
            }
        }
    }

    private async Task SaveInsurance()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            var request = new SaveInsuranceRequest { Insurance = currentInsurance };
            var response = await Http.PostAsJsonAsync("api/checkin/save-insurance", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveInsuranceResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Insurance policy saved successfully!";
                    showDialog = false;
                    await LoadInsurance();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save insurance policy";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while saving the insurance policy. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving insurance policy: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "Insurance.Provider" => "Insurance Provider",
            "Insurance.PolicyNumber" => "Policy Number",
            "Insurance.GroupNumber" => "Group Number",
            "Insurance.PolicyholderName" => "Policyholder Name",
            "Insurance.RelationshipToPatient" => "Relationship to Patient",
            _ => fieldName.Replace("Insurance.", "")
        };
    }

    private void CloseDialog()
    {
        showDialog = false;
        ClearMessages();
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation/medical-history");
    }

    private void Continue()
    {
        Navigation.NavigateTo("/checkin-form-creation/emergency-contacts");
    }
}