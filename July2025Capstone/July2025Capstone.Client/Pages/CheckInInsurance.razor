@page "/checkin-form-creation/insurance"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

<PageTitle>Insurance - Check-in Form</PageTitle>

<div class="container py-4">
    @if (!isAuthenticated)
    {
        <div class="med-card">
            <div class="card-body">
                <div class="warning-state">
                    <i class="bi bi-exclamation-triangle text-warning fs-2 mb-3"></i>
                    <h4>Authentication Required</h4>
                    <p>You need to be logged in to access this page.</p>
                    <a href="/Account/Login" class="btn-primary-modern">Login</a>
                </div>
            </div>
        </div>
        return;
    }

    <!-- Modern Progress Bar -->
    <div class="modern-progress-wrapper mb-4">
        <div class="progress-step-info">
            <span class="step-number">Step 4 of 8</span>
            <span class="step-title">Insurance Information</span>
        </div>
        <div class="modern-step-progress">
            <div class="step-progress-bar" style="width: 50%"></div>
        </div>
    </div>

    <!-- Modern Hero Section -->
    <div class="page-hero mb-4">
        <div class="hero-icon">
            <i class="bi bi-shield-check"></i>
        </div>
        <h1 class="hero-title">Insurance Information</h1>
        <p class="hero-subtitle">
            Add your insurance policy details to ensure proper billing and coverage verification.
        </p>
    </div>

    @if (validationErrors.Any())
    {
        <div class="status-alert error mb-4" role="alert">
            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="med-card">
        <div class="card-header modern-header">
            <div class="header-content">
                <div class="header-icon">
                    <i class="bi bi-shield-plus"></i>
                </div>
                <div class="header-text">
                    <h5 class="header-title">Insurance Policies</h5>
                    <p class="header-subtitle">Manage your insurance information for billing and coverage</p>
                </div>
            </div>
        </div>
        <div class="card-body modern-content">
            <!-- Add Insurance Button -->
            <div class="action-header mb-4">
                <button type="button" class="btn-add-modern" @onclick="ShowAddDialog">
                    <i class="bi bi-plus-circle me-2"></i>Add Insurance Policy
                </button>
            </div>

            <!-- Insurance Policies Table -->
            @if (insurancePolicies.Any())
            {
                <div class="insurance-grid">
                    @foreach (var insurance in insurancePolicies)
                    {
                        <div class="insurance-card">
                            <div class="insurance-card-header">
                                <div class="provider-info">
                                    <i class="bi bi-shield-check text-primary me-2"></i>
                                    <span class="provider-name">@insurance.Provider</span>
                                </div>
                                <div class="card-actions">
                                    <button type="button" class="action-btn edit" @onclick="() => EditInsurance(insurance)" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="action-btn delete" @onclick="() => DeleteInsurance(insurance)" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="insurance-card-body">
                                <div class="policy-detail">
                                    <span class="detail-label">Policy Number:</span>
                                    <span class="detail-value">@insurance.PolicyNumber</span>
                                </div>
                                @if (!string.IsNullOrEmpty(insurance.GroupNumber))
                                {
                                    <div class="policy-detail">
                                        <span class="detail-label">Group Number:</span>
                                        <span class="detail-value">@insurance.GroupNumber</span>
                                    </div>
                                }
                                <div class="policy-detail">
                                    <span class="detail-label">Policyholder:</span>
                                    <span class="detail-value">@insurance.PolicyholderName</span>
                                </div>
                                <div class="policy-detail">
                                    <span class="detail-label">Relationship:</span>
                                    <span class="detail-value relationship">@insurance.RelationshipToPatient</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-shield-plus"></i>
                    </div>
                    <h5 class="empty-title">No Insurance Policies Added</h5>
                    <p class="empty-text">Click "Add Insurance Policy" above to get started with your coverage information.</p>
                </div>
            }
        </div>
    </div>

    <!-- Modern Action Buttons -->
    <div class="action-buttons-container">
        <button type="button" @onclick="GoBack" class="btn-secondary-modern">
            <i class="bi bi-arrow-left me-2"></i>
            <span>Back to Medical History</span>
        </button>
        <button type="button" @onclick="Continue" class="btn-primary-modern">
            <span>Continue to Emergency Contacts</span>
            <i class="bi bi-arrow-right ms-2"></i>
        </button>
    </div>

    <!-- Modern Add/Edit Insurance Modal -->
    @if (showDialog)
    {
        <div class="modern-modal-backdrop" @onclick="CloseDialog">
            <div class="modern-modal" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-title-section">
                        <i class="bi bi-shield-plus text-primary me-2"></i>
                        <h5 class="modal-title">@dialogTitle</h5>
                    </div>
                    <button type="button" class="modal-close" @onclick="CloseDialog">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <EditForm Model="currentInsurance" OnValidSubmit="SaveInsurance">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-4">
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-building me-2"></i>Insurance Provider *
                                    </label>
                                    <InputText @bind-Value="currentInsurance.Provider" 
                                               class="form-control modern-input" 
                                               placeholder="e.g., Blue Cross Blue Shield, Aetna, United Healthcare" />
                                    <ValidationMessage For="@(() => currentInsurance.Provider)" class="validation-message" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-card-text me-2"></i>Policy Number *
                                    </label>
                                    <InputText @bind-Value="currentInsurance.PolicyNumber" 
                                               class="form-control modern-input" 
                                               placeholder="Policy number from insurance card" />
                                    <ValidationMessage For="@(() => currentInsurance.PolicyNumber)" class="validation-message" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-people me-2"></i>Group Number
                                    </label>
                                    <InputText @bind-Value="currentInsurance.GroupNumber" 
                                               class="form-control modern-input" 
                                               placeholder="Group number from insurance card" />
                                    <ValidationMessage For="@(() => currentInsurance.GroupNumber)" class="validation-message" />
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-person-badge me-2"></i>Policyholder Name *
                                    </label>
                                    <InputText @bind-Value="currentInsurance.PolicyholderName" 
                                               class="form-control modern-input" 
                                               placeholder="Name of the person who holds the policy" />
                                    <ValidationMessage For="@(() => currentInsurance.PolicyholderName)" class="validation-message" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-heart me-2"></i>Relationship to Patient *
                                    </label>
                                    <InputSelect @bind-Value="currentInsurance.RelationshipToPatient" class="form-select modern-select">
                                        <option value="">-- Select --</option>
                                        <option value="Self">Self</option>
                                        <option value="Spouse">Spouse</option>
                                        <option value="Parent">Parent</option>
                                        <option value="Child">Child</option>
                                        <option value="Other">Other</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => currentInsurance.RelationshipToPatient)" class="validation-message" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary-modern" @onclick="CloseDialog">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn-primary-modern @(isLoading ? "loading" : "")" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-2"></i>
                                <span>Save Insurance Policy</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Status Messages -->
    @if (errorMessage != null)
    {
        <div class="status-alert error mt-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }

    @if (successMessage != null)
    {
        <div class="status-alert success mt-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
</div>

@code {
    private List<InsurancePolicyDto> insurancePolicies = new();
    private InsurancePolicyDto currentInsurance = new();
    private bool showDialog = false;
    private string dialogTitle = "Add Insurance Policy";
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        await LoadInsurance();
    }

    private async Task LoadInsurance()
    {
        try
        {
            isLoading = true;
            var response = await Http.GetAsync("api/checkin/insurance");
            
            if (response.IsSuccessStatusCode)
            {
                var insuranceList = await response.Content.ReadFromJsonAsync<List<InsurancePolicyDto>>();
                insurancePolicies = insuranceList ?? new List<InsurancePolicyDto>();
                StateHasChanged();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while loading your insurance policies. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading insurance policies: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowAddDialog()
    {
        currentInsurance = new InsurancePolicyDto();
        dialogTitle = "Add Insurance Policy";
        showDialog = true;
        ClearMessages();
    }

    private void EditInsurance(InsurancePolicyDto? insurance)
    {
        if (insurance != null)
        {
            currentInsurance = new InsurancePolicyDto
            {
                Id = insurance.Id,
                Provider = insurance.Provider,
                PolicyNumber = insurance.PolicyNumber,
                GroupNumber = insurance.GroupNumber,
                PolicyholderName = insurance.PolicyholderName,
                RelationshipToPatient = insurance.RelationshipToPatient
            };
            dialogTitle = "Edit Insurance Policy";
            showDialog = true;
            ClearMessages();
        }
    }

    private async Task DeleteInsurance(InsurancePolicyDto? insurance)
    {
        if (insurance != null && insurance.Id > 0)
        {
            try
            {
                ClearMessages();
                var response = await Http.DeleteAsync($"api/checkin/insurance/{insurance.Id}");
                
                if (response.IsSuccessStatusCode)
                {
                    successMessage = "Insurance policy deleted successfully!";
                    await LoadInsurance();
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    await HandleValidationErrors(response);
                }
                else
                {
                    errorMessage = "An error occurred while deleting the insurance policy. Please try again.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting insurance policy: {ex.Message}";
            }
        }
    }

    private async Task SaveInsurance()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            var request = new SaveInsuranceRequest { Insurance = currentInsurance };
            var response = await Http.PostAsJsonAsync("api/checkin/save-insurance", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveInsuranceResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Insurance policy saved successfully!";
                    showDialog = false;
                    await LoadInsurance();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save insurance policy";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while saving the insurance policy. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving insurance policy: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "Insurance.Provider" => "Insurance Provider",
            "Insurance.PolicyNumber" => "Policy Number",
            "Insurance.GroupNumber" => "Group Number",
            "Insurance.PolicyholderName" => "Policyholder Name",
            "Insurance.RelationshipToPatient" => "Relationship to Patient",
            _ => fieldName.Replace("Insurance.", "")
        };
    }

    private void CloseDialog()
    {
        showDialog = false;
        ClearMessages();
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation/medical-history");
    }

    private void Continue()
    {
        Navigation.NavigateTo("/checkin-form-creation/emergency-contacts");
    }
}

