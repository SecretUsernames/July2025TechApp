@page "/checkin-form-creation/lifestyle"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@using Microsoft.Extensions.Logging
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<CheckInLifestyle> Logger
@rendermode InteractiveWebAssembly

<PageTitle>Lifestyle Information - Check-in Form</PageTitle>

<div class="container py-4">
    <!-- Progress Bar -->
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted">Step 7 of 8</span>
            <span class="text-muted">Lifestyle Information</span>
        </div>
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: 87.5%"></div>
        </div>
    </div>

    <h3 class="mb-3">Lifestyle Information</h3>
    <p class="text-muted">Please provide information about your lifestyle habits. This information helps our medical staff provide better care and identify potential health risks.</p>

    @if (!isAuthenticated)
    {
        <div class="alert alert-warning">
            <h4>Authentication Required</h4>
            <p>You need to be logged in to access this page.</p>
            <a href="/Account/Login" class="btn btn-primary">Login</a>
        </div>
        return;
    }

    @if (validationErrors.Any())
    {
        <div class="alert alert-danger mb-4">
            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <EditForm Model="lifestyle" OnValidSubmit="SaveLifestyle">
                <DataAnnotationsValidator />
                
                <!-- Tobacco Use Section -->
                <div class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <div class="lifestyle-section-icon me-3">
                            <i class="bi bi-ban"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 lifestyle-section-title">Tobacco Use</h5>
                            <p class="text-muted mb-0 small">Do you currently use or have you previously used tobacco products?</p>
                        </div>
                        <span class="badge bg-danger ms-auto">Required</span>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-lg-4 col-md-6">
                            <div class="form-check lifestyle-option">
                                <input type="radio" name="tobaccoUse" checked="@(lifestyle.TobaccoUse == TobaccoUse.No)" 
                                       @onchange="@(() => SetTobaccoUse(TobaccoUse.No))" 
                                       class="form-check-input" id="tobaccoNo" />
                                <label class="form-check-label" for="tobaccoNo">
                                    <span class="badge bg-success me-2">No</span>I don't use tobacco
                                </label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="form-check lifestyle-option">
                                <input type="radio" name="tobaccoUse" checked="@(lifestyle.TobaccoUse == TobaccoUse.Yes)" 
                                       @onchange="@(() => SetTobaccoUse(TobaccoUse.Yes))" 
                                       class="form-check-input" id="tobaccoYes" />
                                <label class="form-check-label" for="tobaccoYes">
                                    <span class="badge bg-warning me-2">Yes</span>I currently use tobacco
                                </label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="form-check lifestyle-option">
                                <input type="radio" name="tobaccoUse" checked="@(lifestyle.TobaccoUse == TobaccoUse.Former)" 
                                       @onchange="@(() => SetTobaccoUse(TobaccoUse.Former))" 
                                       class="form-check-input" id="tobaccoFormer" />
                                <label class="form-check-label" for="tobaccoFormer">
                                    <span class="badge bg-info me-2">Former</span>I used to use tobacco
                                </label>
                            </div>
                        </div>
                    </div>
                    <ValidationMessage For="@(() => lifestyle.TobaccoUse)" class="text-danger small mt-2" />
                </div>

                <!-- Alcohol Use Section -->
                <div class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <div class="lifestyle-section-icon me-3">
                            <i class="bi bi-cup"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 lifestyle-section-title">Alcohol Use</h5>
                            <p class="text-muted mb-0 small">How often do you consume alcoholic beverages?</p>
                        </div>
                        <span class="badge bg-danger ms-auto">Required</span>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-lg-4 col-md-6">
                            <div class="form-check lifestyle-option">
                                <input type="radio" name="alcoholUse" checked="@(lifestyle.AlcoholUse == AlcoholUse.No)" 
                                       @onchange="@(() => SetAlcoholUse(AlcoholUse.No))" 
                                       class="form-check-input" id="alcoholNo" />
                                <label class="form-check-label" for="alcoholNo">
                                    <span class="badge bg-success me-2">No</span>I don't drink alcohol
                                </label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="form-check lifestyle-option">
                                <input type="radio" name="alcoholUse" checked="@(lifestyle.AlcoholUse == AlcoholUse.Occasionally)" 
                                       @onchange="@(() => SetAlcoholUse(AlcoholUse.Occasionally))" 
                                       class="form-check-input" id="alcoholOccasionally" />
                                <label class="form-check-label" for="alcoholOccasionally">
                                    <span class="badge bg-warning me-2">Occasionally</span>I drink occasionally
                                </label>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="form-check lifestyle-option">
                                <input type="radio" name="alcoholUse" checked="@(lifestyle.AlcoholUse == AlcoholUse.Yes)" 
                                       @onchange="@(() => SetAlcoholUse(AlcoholUse.Yes))" 
                                       class="form-check-input" id="alcoholYes" />
                                <label class="form-check-label" for="alcoholYes">
                                    <span class="badge bg-danger me-2">Yes</span>I drink regularly
                                </label>
                            </div>
                        </div>
                    </div>
                    <ValidationMessage For="@(() => lifestyle.AlcoholUse)" class="text-danger small mt-2" />
                </div>

                <!-- Recreational Drugs Section -->
                <div class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <div class="lifestyle-section-icon me-3">
                            <i class="bi bi-prescription2"></i>
                        </div>
                        <div>
                            <h5 class="mb-1 lifestyle-section-title">Recreational Drug Use</h5>
                            <p class="text-muted mb-0 small">Do you use any recreational or illicit drugs?</p>
                        </div>
                        <span class="badge bg-danger ms-auto">Required</span>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check lifestyle-option">
                                <input type="radio" name="drugUse" checked="@(!lifestyle.RecreationalDrugs)" 
                                       @onchange="@(() => SetDrugUse(false))" 
                                       class="form-check-input" id="drugNo" />
                                <label class="form-check-label" for="drugNo">
                                    <span class="badge bg-success me-2">No</span>I don't use recreational drugs
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check lifestyle-option">
                                <input type="radio" name="drugUse" checked="@(lifestyle.RecreationalDrugs)" 
                                       @onchange="@(() => SetDrugUse(true))" 
                                       class="form-check-input" id="drugYes" />
                                <label class="form-check-label" for="drugYes">
                                    <span class="badge bg-warning me-2">Yes</span>I use recreational drugs
                                </label>
                            </div>
                        </div>
                    </div>
                    <ValidationMessage For="@(() => lifestyle.RecreationalDrugs)" class="text-danger small mt-2" />
                    <div class="alert alert-info mt-3 mb-0">
                        <i class="bi bi-shield-lock me-2"></i>
                        <small>This information is confidential and helps ensure your safety during treatment.</small>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between">
                    <button type="button" @onclick="GoBack" class="btn btn-outline-secondary">
                        <span class="bi bi-arrow-left me-2"></span>Back
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Continue to Final Review<span class="bi bi-arrow-right ms-2"></span>
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Privacy Information Card -->
    <div class="card border-warning mt-4">
        <div class="card-body">
            <h6 class="card-title"><i class="bi bi-shield-lock me-2"></i>Privacy & Confidentiality</h6>
            <ul class="mb-0 small">
                <li><strong>Confidential:</strong> All lifestyle information is kept strictly confidential</li>
                <li><strong>Medical Safety:</strong> This information helps prevent dangerous drug interactions</li>
                <li><strong>Better Care:</strong> Honest information leads to more effective treatment</li>
                <li><strong>No Judgment:</strong> Our medical staff provides care without judgment</li>
            </ul>
        </div>
    </div>

    @* Success and error messages *@
    @if (successMessage != null)
    {
        <div class="alert alert-success mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
    
    @if (errorMessage != null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }
</div>

@code {
    private LifestyleDto lifestyle = new();
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        await LoadLifestyle();
    }

    private async Task LoadLifestyle()
    {
        try
        {
            isLoading = true;
            Logger.LogInformation("Starting to load lifestyle data...");
            
            var response = await Http.GetAsync("api/checkin/lifestyle");
            Logger.LogInformation("HTTP Response Status: {StatusCode}", response.StatusCode);
            
            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Logger.LogInformation("Raw response content: {Content}", responseContent);
                
                var result = await response.Content.ReadFromJsonAsync<GetLifestyleResponse>();
                if (result?.Lifestyle != null)
                {
                    lifestyle = result.Lifestyle;
                    Logger.LogInformation("Loaded lifestyle - Tobacco: {Tobacco} ({TobaccoInt}), Alcohol: {Alcohol} ({AlcoholInt}), Drugs: {Drugs}", 
                        lifestyle.TobaccoUse, (int)lifestyle.TobaccoUse, lifestyle.AlcoholUse, (int)lifestyle.AlcoholUse, lifestyle.RecreationalDrugs);
                }
                else
                {
                    lifestyle = new LifestyleDto();
                    Logger.LogInformation("No existing lifestyle found, created new default DTO with Tobacco: {Tobacco}, Alcohol: {Alcohol}, Drugs: {Drugs}",
                        lifestyle.TobaccoUse, lifestyle.AlcoholUse, lifestyle.RecreationalDrugs);
                }
                StateHasChanged();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
            else
            {
                // No existing lifestyle is fine, user can create a new one
                lifestyle = new LifestyleDto();
                Logger.LogInformation("HTTP error {StatusCode}, created new default lifestyle DTO", response.StatusCode);
            }
        }
        catch (JsonException jsonEx)
        {
            // Handle JSON deserialization errors by starting fresh
            Logger.LogWarning("JSON deserialization error, clearing lifestyle data: {Error}", jsonEx.Message);
            lifestyle = new LifestyleDto();
            errorMessage = "Previous lifestyle data was corrupted. Please re-enter your information.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading lifestyle information");
            errorMessage = $"Error loading lifestyle information: {ex.Message}";
            lifestyle = new LifestyleDto(); // Fallback to empty form
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveLifestyle()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            // Debug logging
            Logger.LogInformation("Saving lifestyle: Tobacco={TobaccoUse}, Alcohol={AlcoholUse}, Drugs={RecreationalDrugs}", 
                lifestyle.TobaccoUse, lifestyle.AlcoholUse, lifestyle.RecreationalDrugs);
            
            var request = new SaveLifestyleRequest { Lifestyle = lifestyle };
            var response = await Http.PostAsJsonAsync("api/checkin/save-lifestyle", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveLifestyleResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Lifestyle information saved successfully!";
                    
                    // Navigate to next step after a short delay
                    await Task.Delay(1000);
                    Continue();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save lifestyle information";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("BadRequest error: {ErrorContent}", errorContent);
                await HandleValidationErrors(response);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("HTTP error {StatusCode}: {ErrorContent}", response.StatusCode, errorContent);
                errorMessage = "An error occurred while saving your lifestyle information. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving lifestyle information");
            errorMessage = $"Error saving lifestyle information: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "Lifestyle.TobaccoUse" => "Tobacco Use",
            "Lifestyle.AlcoholUse" => "Alcohol Use",
            "Lifestyle.RecreationalDrugs" => "Recreational Drug Use",
            _ => fieldName.Replace("Lifestyle.", "")
        };
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation/visit-intake");
    }

    private void Continue()
    {
        Navigation.NavigateTo("/checkin-form-creation/review"); // Final review page
    }

    private void SetTobaccoUse(TobaccoUse value)
    {
        lifestyle.TobaccoUse = value;
        Logger.LogInformation("Tobacco use set to: {Value}", value);
        StateHasChanged();
    }

    private void SetAlcoholUse(AlcoholUse value)
    {
        lifestyle.AlcoholUse = value;
        Logger.LogInformation("Alcohol use set to: {Value}", value);
        StateHasChanged();
    }

    private void SetDrugUse(bool value)
    {
        lifestyle.RecreationalDrugs = value;
        Logger.LogInformation("Recreational drugs set to: {Value}", value);
        StateHasChanged();
    }
}

<style>
    .lifestyle-section-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #007bff, #0056b3);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        box-shadow: 0 4px 8px rgba(0, 123, 255, 0.2);
    }
    
    .lifestyle-section-title {
        color: #2c3e50;
        font-weight: 600;
        font-size: 1.25rem;
    }
    
    .lifestyle-option {
        background: #f8f9fa;
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 15px;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        height: 100%;
    }
    
    .lifestyle-option:hover {
        border-color: #007bff;
        background: #e3f2fd;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 123, 255, 0.15);
    }
    
    .lifestyle-option .form-check-input:checked ~ .form-check-label {
        font-weight: 600;
        color: #007bff;
    }
    
    .lifestyle-option .form-check-input {
        margin-top: 0.25rem;
    }
    
    .lifestyle-option .form-check-label {
        cursor: pointer;
        display: flex;
        align-items: center;
        width: 100%;
        margin-bottom: 0;
    }
    
    .badge.bg-danger {
        background-color: #dc3545 !important;
        font-size: 0.75rem;
        padding: 0.375rem 0.75rem;
    }
    
    .alert-info {
        background-color: #e3f2fd;
        border-color: #bbdefb;
        color: #1565c0;
    }
    
    .form-control:focus,
    .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }
    
    .card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }
    
    .card-body {
        padding: 2rem;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #007bff, #0056b3);
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        transition: all 0.2s ease-in-out;
    }
    
    .btn-primary:hover {
        background: linear-gradient(135deg, #0056b3, #004085);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
    }
    
    .btn-outline-secondary {
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
    }
</style>