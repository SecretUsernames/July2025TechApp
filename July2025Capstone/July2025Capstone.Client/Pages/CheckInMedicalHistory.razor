@page "/checkin-form-creation/medical-history"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

<PageTitle>Medical History - Check-in Form</PageTitle>

<div class="container py-4">
    @if (!isAuthenticated)
    {
        <div class="med-card">
            <div class="card-body">
                <div class="warning-state">
                    <i class="bi bi-exclamation-triangle text-warning fs-2 mb-3"></i>
                    <h4>Authentication Required</h4>
                    <p>You need to be logged in to access this page.</p>
                    <a href="/Account/Login" class="btn-primary-modern">Login</a>
                </div>
            </div>
        </div>
        return;
    }

    <!-- Modern Progress Bar -->
    <div class="modern-progress-wrapper mb-4">
        <div class="progress-step-info">
            <span class="step-number">Step 3 of 8</span>
            <span class="step-title">Medical History</span>
        </div>
        <div class="modern-step-progress">
            <div class="step-progress-bar" style="width: 37.5%"></div>
        </div>
    </div>

    <!-- Modern Hero Section -->
    <div class="page-hero mb-4">
        <div class="hero-icon">
            <i class="bi bi-heart-pulse"></i>
        </div>
        <h1 class="hero-title">Medical History</h1>
        <p class="hero-subtitle">
            Provide your medical history including allergies, conditions, and procedures. This section is optional but helps ensure comprehensive care.
        </p>
    </div>

    <!-- Allergies Section -->
    <div class="med-card mb-4">
        <div class="card-header modern-header">
            <div class="header-content">
                <div class="header-icon allergy">
                    <i class="bi bi-shield-exclamation"></i>
                </div>
                <div class="header-text">
                    <h5 class="header-title">Allergies & Reactions</h5>
                    <p class="header-subtitle">List any known allergies to medications, foods, or environmental factors</p>
                </div>
            </div>
        </div>
        <div class="card-body modern-content">
            <div class="action-header mb-4">
                <button type="button" class="btn-add-modern allergy" @onclick="ShowAddAllergyDialog">
                    <i class="bi bi-plus-circle me-2"></i>Add Allergy
                </button>
            </div>

            @if (allergies.Any())
            {
                <div class="medical-grid">
                    @foreach (var allergy in allergies)
                    {
                        <div class="medical-card allergy">
                            <div class="medical-card-header">
                                <div class="medical-info">
                                    <i class="bi bi-shield-exclamation text-danger me-2"></i>
                                    <span class="medical-name">@allergy.Allergen</span>
                                </div>
                                <div class="card-actions">
                                    <button type="button" class="action-btn edit" @onclick="() => EditAllergy(allergy)" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="action-btn delete" @onclick="() => DeleteAllergy(allergy)" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                    <h5 class="empty-title">No Allergies Listed</h5>
                    <p class="empty-text">Click "Add Allergy" if you have any known allergies to medications, foods, or environmental factors.</p>
                </div>
            }
        </div>
    </div>

    <!-- Medical Conditions Section -->
    <div class="med-card mb-4">
        <div class="card-header modern-header">
            <div class="header-content">
                <div class="header-icon condition">
                    <i class="bi bi-clipboard2-heart"></i>
                </div>
                <div class="header-text">
                    <h5 class="header-title">Medical Conditions</h5>
                    <p class="header-subtitle">List any diagnosed medical conditions or chronic illnesses</p>
                </div>
            </div>
        </div>
        <div class="card-body modern-content">
            <div class="action-header mb-4">
                <button type="button" class="btn-add-modern condition" @onclick="ShowAddConditionDialog">
                    <i class="bi bi-plus-circle me-2"></i>Add Condition
                </button>
            </div>

            @if (conditions.Any())
            {
                <div class="medical-grid">
                    @foreach (var condition in conditions)
                    {
                        <div class="medical-card condition">
                            <div class="medical-card-header">
                                <div class="medical-info">
                                    <i class="bi bi-clipboard2-heart text-info me-2"></i>
                                    <span class="medical-name">@condition.ConditionName</span>
                                </div>
                                <div class="card-actions">
                                    <button type="button" class="action-btn edit" @onclick="() => EditCondition(condition)" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="action-btn delete" @onclick="() => DeleteCondition(condition)" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-clipboard2-heart"></i>
                    </div>
                    <h5 class="empty-title">No Medical Conditions Listed</h5>
                    <p class="empty-text">Click "Add Condition" if you have any diagnosed medical conditions or chronic illnesses.</p>
                </div>
            }
        </div>
    </div>

    <!-- Procedures Section -->
    <div class="med-card mb-4">
        <div class="card-header modern-header">
            <div class="header-content">
                <div class="header-icon procedure">
                    <i class="bi bi-clipboard2-pulse"></i>
                </div>
                <div class="header-text">
                    <h5 class="header-title">Medical Procedures</h5>
                    <p class="header-subtitle">List any surgeries or significant medical procedures you've had</p>
                </div>
            </div>
        </div>
        <div class="card-body modern-content">
            <div class="action-header mb-4">
                <button type="button" class="btn-add-modern procedure" @onclick="ShowAddProcedureDialog">
                    <i class="bi bi-plus-circle me-2"></i>Add Procedure
                </button>
            </div>

            @if (procedures.Any())
            {
                <div class="procedure-grid">
                    @foreach (var procedure in procedures.OrderByDescending(p => p.ProcedureDate))
                    {
                        <div class="procedure-card">
                            <div class="procedure-card-header">
                                <div class="procedure-info">
                                    <i class="bi bi-clipboard2-pulse text-success me-2"></i>
                                    <span class="procedure-name">@procedure.ProcedureName</span>
                                </div>
                                <div class="card-actions">
                                    <button type="button" class="action-btn edit" @onclick="() => EditProcedure(procedure)" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="action-btn delete" @onclick="() => DeleteProcedure(procedure)" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="procedure-card-body">
                                <div class="procedure-detail">
                                    <span class="detail-label">Date:</span>
                                    <span class="detail-value date">@procedure.ProcedureDate.ToString("MMMM dd, yyyy")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(procedure.Notes))
                                {
                                    <div class="procedure-detail">
                                        <span class="detail-label">Notes:</span>
                                        <span class="detail-value notes">@(procedure.Notes.Length > 60 ? procedure.Notes.Substring(0, 60) + "..." : procedure.Notes)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-clipboard2-pulse"></i>
                    </div>
                    <h5 class="empty-title">No Procedures Listed</h5>
                    <p class="empty-text">Click "Add Procedure" if you have had any surgeries or significant medical procedures.</p>
                </div>
            }
        </div>
    </div>

    <!-- Modern Action Buttons -->
    <div class="action-buttons-container">
        <button type="button" @onclick="GoBack" class="btn-secondary-modern">
            <i class="bi bi-arrow-left me-2"></i>
            <span>Back to Medications</span>
        </button>
        <button type="button" @onclick="Continue" class="btn-primary-modern">
            <span>Continue to Insurance</span>
            <i class="bi bi-arrow-right ms-2"></i>
        </button>
    </div>

    <!-- Modern Modals -->
    <!-- Add/Edit Allergy Modal -->
    @if (showAllergyDialog)
    {
        <div class="modern-modal-backdrop" @onclick="CloseAllergyDialog">
            <div class="modern-modal small" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-title-section">
                        <i class="bi bi-shield-exclamation text-danger me-2"></i>
                        <h5 class="modal-title">@allergyDialogTitle</h5>
                    </div>
                    <button type="button" class="modal-close" @onclick="CloseAllergyDialog">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <EditForm Model="currentAllergy" OnValidSubmit="SaveAllergy">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (validationErrors.Any())
                        {
                            <div class="status-alert error mb-3">
                                <h6><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
                                <ul class="mb-0">
                                    @foreach (var error in validationErrors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }
                        
                        @if (errorMessage != null)
                        {
                            <div class="status-alert error mb-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                            </div>
                        }
                        
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-shield-exclamation me-2"></i>Allergen Name *
                            </label>
                            <InputText @bind-Value="currentAllergy.Allergen" 
                                       class="form-control modern-input" 
                                       placeholder="e.g., Peanuts, Penicillin, Pollen, Shellfish" />
                            <ValidationMessage For="@(() => currentAllergy.Allergen)" class="validation-message" />
                            <div class="input-help">Enter the name of the substance you're allergic to</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary-modern" @onclick="CloseAllergyDialog">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn-primary-modern @(isLoading ? "loading" : "")" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-2"></i>
                                <span>Save Allergy</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Add/Edit Condition Modal -->
    @if (showConditionDialog)
    {
        <div class="modern-modal-backdrop" @onclick="CloseConditionDialog">
            <div class="modern-modal small" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-title-section">
                        <i class="bi bi-clipboard2-heart text-info me-2"></i>
                        <h5 class="modal-title">@conditionDialogTitle</h5>
                    </div>
                    <button type="button" class="modal-close" @onclick="CloseConditionDialog">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <EditForm Model="currentCondition" OnValidSubmit="SaveCondition">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (validationErrors.Any())
                        {
                            <div class="status-alert error mb-3">
                                <h6><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
                                <ul class="mb-0">
                                    @foreach (var error in validationErrors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }
                        
                        @if (errorMessage != null)
                        {
                            <div class="status-alert error mb-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                            </div>
                        }
                        
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-clipboard2-heart me-2"></i>Condition Name *
                            </label>
                            <InputText @bind-Value="currentCondition.ConditionName" 
                                       class="form-control modern-input" 
                                       placeholder="e.g., Diabetes, Hypertension, Asthma" />
                            <ValidationMessage For="@(() => currentCondition.ConditionName)" class="validation-message" />
                            <div class="input-help">Enter the name of your diagnosed medical condition</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary-modern" @onclick="CloseConditionDialog">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn-primary-modern @(isLoading ? "loading" : "")" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-2"></i>
                                <span>Save Condition</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Add/Edit Procedure Modal -->
    @if (showProcedureDialog)
    {
        <div class="modern-modal-backdrop" @onclick="CloseProcedureDialog">
            <div class="modern-modal" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-title-section">
                        <i class="bi bi-clipboard2-pulse text-success me-2"></i>
                        <h5 class="modal-title">@procedureDialogTitle</h5>
                    </div>
                    <button type="button" class="modal-close" @onclick="CloseProcedureDialog">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <EditForm Model="currentProcedure" OnValidSubmit="SaveProcedure">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (validationErrors.Any())
                        {
                            <div class="status-alert error mb-3">
                                <h6><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
                                <ul class="mb-0">
                                    @foreach (var error in validationErrors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }
                        
                        @if (errorMessage != null)
                        {
                            <div class="status-alert error mb-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                            </div>
                        }
                        
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-clipboard2-pulse me-2"></i>Procedure Name *
                                    </label>
                                    <InputText @bind-Value="currentProcedure.ProcedureName" 
                                               class="form-control modern-input" 
                                               placeholder="e.g., Appendectomy, Colonoscopy" />
                                    <ValidationMessage For="@(() => currentProcedure.ProcedureName)" class="validation-message" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-calendar3 me-2"></i>Procedure Date *
                                    </label>
                                    <InputDate @bind-Value="procedureDate" class="form-control modern-input" />
                                    <ValidationMessage For="@(() => currentProcedure.ProcedureDate)" class="validation-message" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label class="form-label modern-label">
                                        <i class="bi bi-journal-text me-2"></i>Notes (Optional)
                                    </label>
                                    <InputTextArea @bind-Value="currentProcedure.Notes" 
                                                   class="form-control modern-textarea" 
                                                   rows="3"
                                                   placeholder="Any additional notes about the procedure" />
                                    <ValidationMessage For="@(() => currentProcedure.Notes)" class="validation-message" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-secondary-modern" @onclick="CloseProcedureDialog">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn-primary-modern @(isLoading ? "loading" : "")" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle me-2"></i>
                                <span>Save Procedure</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Status Messages -->
    @if (successMessage != null)
    {
        <div class="status-alert success mt-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
    
    @if (errorMessage != null && !showAllergyDialog && !showConditionDialog && !showProcedureDialog)
    {
        <div class="status-alert error mt-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }
</div>

@code {
    // Data collections
    private List<AllergyDto> allergies = new();
    private List<PatientConditionDto> conditions = new();
    private List<ProcedureDto> procedures = new();

    // Current edit objects
    private AllergyDto currentAllergy = new();
    private PatientConditionDto currentCondition = new();
    private ProcedureDto currentProcedure = new();

    // Dialog states
    private bool showAllergyDialog = false;
    private bool showConditionDialog = false;
    private bool showProcedureDialog = false;

    // Dialog titles
    private string allergyDialogTitle = "Add Allergy";
    private string conditionDialogTitle = "Add Condition";
    private string procedureDialogTitle = "Add Procedure";

    // General state
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();

    // Helper for procedure date
    private DateTime procedureDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        await LoadAllergies();
        await LoadConditions();
        await LoadProcedures();
    }

    #region Allergies
    private async Task LoadAllergies()
    {
        try
        {
            var response = await Http.GetAsync("api/checkin/allergies");
            
            if (response.IsSuccessStatusCode)
            {
                var allergyList = await response.Content.ReadFromJsonAsync<List<AllergyDto>>();
                allergies = allergyList ?? new List<AllergyDto>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading allergies: {ex.Message}";
        }
    }

    private void ShowAddAllergyDialog()
    {
        currentAllergy = new AllergyDto();
        allergyDialogTitle = "Add Allergy";
        showAllergyDialog = true;
        ClearMessages();
    }

    private void EditAllergy(AllergyDto? allergy)
    {
        if (allergy != null)
        {
            currentAllergy = new AllergyDto
            {
                Id = allergy.Id,
                Allergen = allergy.Allergen
            };
            allergyDialogTitle = "Edit Allergy";
            showAllergyDialog = true;
            ClearMessages();
        }
    }

    private async Task DeleteAllergy(AllergyDto? allergy)
    {
        if (allergy != null && allergy.Id > 0)
        {
            try
            {
                ClearMessages();
                var response = await Http.DeleteAsync($"api/checkin/allergy/{allergy.Id}");
                
                if (response.IsSuccessStatusCode)
                {
                    successMessage = "Allergy deleted successfully!";
                    await LoadAllergies();
                }
                else
                {
                    errorMessage = "An error occurred while deleting the allergy. Please try again.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting allergy: {ex.Message}";
            }
        }
    }

    private async Task SaveAllergy()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            var request = new SaveAllergyRequest { Allergy = currentAllergy };
            var response = await Http.PostAsJsonAsync("api/checkin/save-allergy", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveAllergyResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Allergy saved successfully!";
                    showAllergyDialog = false;
                    await LoadAllergies();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save allergy";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while saving the allergy. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving allergy: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseAllergyDialog()
    {
        showAllergyDialog = false;
        ClearMessages();
    }
    #endregion

    #region Conditions
    private async Task LoadConditions()
    {
        try
        {
            var response = await Http.GetAsync("api/checkin/conditions");
            
            if (response.IsSuccessStatusCode)
            {
                var conditionList = await response.Content.ReadFromJsonAsync<List<PatientConditionDto>>();
                conditions = conditionList ?? new List<PatientConditionDto>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading conditions: {ex.Message}";
        }
    }

    private void ShowAddConditionDialog()
    {
        currentCondition = new PatientConditionDto();
        conditionDialogTitle = "Add Condition";
        showConditionDialog = true;
        ClearMessages();
    }

    private void EditCondition(PatientConditionDto? condition)
    {
        if (condition != null)
        {
            currentCondition = new PatientConditionDto
            {
                Id = condition.Id,
                ConditionName = condition.ConditionName
            };
            conditionDialogTitle = "Edit Condition";
            showConditionDialog = true;
            ClearMessages();
        }
    }

    private async Task DeleteCondition(PatientConditionDto? condition)
    {
        if (condition != null && condition.Id > 0)
        {
            try
            {
                ClearMessages();
                var response = await Http.DeleteAsync($"api/checkin/condition/{condition.Id}");
                
                if (response.IsSuccessStatusCode)
                {
                    successMessage = "Condition removed successfully!";
                    await LoadConditions();
                }
                else
                {
                    errorMessage = "An error occurred while removing the condition. Please try again.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error removing condition: {ex.Message}";
            }
        }
    }

    private async Task SaveCondition()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            var request = new SaveConditionRequest { Condition = currentCondition };
            var response = await Http.PostAsJsonAsync("api/checkin/save-condition", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveConditionResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Condition saved successfully!";
                    showConditionDialog = false;
                    await LoadConditions();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save condition";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while saving the condition. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving condition: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseConditionDialog()
    {
        showConditionDialog = false;
        ClearMessages();
    }
    #endregion

    #region Procedures
    private async Task LoadProcedures()
    {
        try
        {
            var response = await Http.GetAsync("api/checkin/procedures");
            
            if (response.IsSuccessStatusCode)
            {
                var procedureList = await response.Content.ReadFromJsonAsync<List<ProcedureDto>>();
                procedures = procedureList ?? new List<ProcedureDto>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading procedures: {ex.Message}";
        }
    }

    private void ShowAddProcedureDialog()
    {
        currentProcedure = new ProcedureDto();
        procedureDate = DateTime.Today;
        procedureDialogTitle = "Add Procedure";
        showProcedureDialog = true;
        ClearMessages();
    }

    private void EditProcedure(ProcedureDto? procedure)
    {
        if (procedure != null)
        {
            currentProcedure = new ProcedureDto
            {
                Id = procedure.Id,
                ProcedureName = procedure.ProcedureName,
                ProcedureDate = procedure.ProcedureDate,
                Notes = procedure.Notes
            };
            procedureDate = procedure.ProcedureDate.ToDateTime(TimeOnly.MinValue);
            procedureDialogTitle = "Edit Procedure";
            showProcedureDialog = true;
            ClearMessages();
        }
    }

    private async Task DeleteProcedure(ProcedureDto? procedure)
    {
        if (procedure != null && procedure.Id > 0)
        {
            try
            {
                ClearMessages();
                var response = await Http.DeleteAsync($"api/checkin/procedure/{procedure.Id}");
                
                if (response.IsSuccessStatusCode)
                {
                    successMessage = "Procedure deleted successfully!";
                    await LoadProcedures();
                }
                else
                {
                    errorMessage = "An error occurred while deleting the procedure. Please try again.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting procedure: {ex.Message}";
            }
        }
    }

    private async Task SaveProcedure()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            // Convert DateTime to DateOnly
            currentProcedure.ProcedureDate = DateOnly.FromDateTime(procedureDate);
            
            var request = new SaveProcedureRequest { Procedure = currentProcedure };
            var response = await Http.PostAsJsonAsync("api/checkin/save-procedure", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveProcedureResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Procedure saved successfully!";
                    showProcedureDialog = false;
                    await LoadProcedures();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save procedure";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while saving the procedure. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving procedure: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void CloseProcedureDialog()
    {
        showProcedureDialog = false;
        ClearMessages();
    }
    #endregion

    #region General Helpers
    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "Allergy.Allergen" => "Allergen Name",
            "Condition.ConditionName" => "Condition Name",
            "Procedure.ProcedureName" => "Procedure Name",
            "Procedure.ProcedureDate" => "Procedure Date",
            "Procedure.Notes" => "Procedure Notes",
            _ => fieldName.Replace("Allergy.", "").Replace("Condition.", "").Replace("Procedure.", "")
        };
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation/medications");
    }

    private void Continue()
    {
        Navigation.NavigateTo("/checkin-form-creation/insurance");
    }
    #endregion
}

