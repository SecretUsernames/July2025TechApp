        color: white;
        font-size: 1.5rem;
        flex-shrink: 0;
    }
    
    .header-text {
        flex: 1;
    }
    
    .header-title {
        color: #1f2937;
        font-weight: 600;
        margin: 0 0 4px 0;
        font-size: 1.25rem;
    }
    
    .header-subtitle {
        color: #6b7280;
        font-size: 0.875rem;
        margin: 0;
    }
    
    /* Modern Forms */
    .modern-form {
        padding: 28px;
    }
    
    .form-group {
        margin-bottom: 0;
    }
    
    .modern-label {
        font-weight: 600;
