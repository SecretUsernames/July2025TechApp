@page "/checkin-form-creation/personal-info"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

<PageTitle>Personal Information - Check-in Form</PageTitle>

@if (!isAuthenticated)
{
    <div class="alert alert-warning">
        <h4>Authentication Required</h4>
        <p>You need to be logged in to access this page.</p>
        <a href="/Account/Login" class="btn btn-primary">Login</a>
    </div>
    return;
}

<div class="container py-4">
    <!-- Progress Bar -->
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted">Step 1 of 8</span>
            <span class="text-muted">Personal Information</span>
        </div>
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: 17.5%"></div>
        </div>
    </div>

    <h3 class="mb-3">Personal Information</h3>
    <p class="text-muted">Please provide your basic personal details and address.</p>

    @if (validationErrors.Any())
    {
        <div class="alert alert-danger mb-4">
            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <EditForm Model="formModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        
        <!-- Personal Information Section -->
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">Personal Details</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">First Name *</label>
                        <InputText @bind-Value="formModel.PersonalInfo.FirstName" class="form-control" />
                        <ValidationMessage For="@(() => formModel.PersonalInfo.FirstName)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Last Name *</label>
                        <InputText @bind-Value="formModel.PersonalInfo.LastName" class="form-control" />
                        <ValidationMessage For="@(() => formModel.PersonalInfo.LastName)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Date of Birth *</label>
                        <InputDate @bind-Value="formModel.PersonalInfo.DateOfBirth" class="form-control" />
                        <ValidationMessage For="@(() => formModel.PersonalInfo.DateOfBirth)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Gender</label>
                        <InputSelect @bind-Value="formModel.PersonalInfo.Gender" class="form-select">
                            <option value="">Select gender</option>
                            <option value="@GenderType.Male">Male</option>
                            <option value="@GenderType.Female">Female</option>
                            <option value="@GenderType.Other">Other</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email *</label>
                        <InputText @bind-Value="formModel.PersonalInfo.Email" type="email" class="form-control" />
                        <ValidationMessage For="@(() => formModel.PersonalInfo.Email)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone Number *</label>
                        <InputText @bind-Value="formModel.PersonalInfo.Phone" type="tel" class="form-control" />
                        <ValidationMessage For="@(() => formModel.PersonalInfo.Phone)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Preferred Contact Method</label>
                        <InputSelect @bind-Value="formModel.PersonalInfo.PreferredContactMethod" class="form-select">
                            <option value="">Select preferred contact method</option>
                            <option value="@ContactMethod.Phone">Phone</option>
                            <option value="@ContactMethod.Email">Email</option>
                            <option value="@ContactMethod.Text">Text Message</option>
                        </InputSelect>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address Section -->
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">Address Information</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Street Address *</label>
                        <InputText @bind-Value="formModel.Address.Street" class="form-control" placeholder="123 Main Street" />
                        <ValidationMessage For="@(() => formModel.Address.Street)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">City *</label>
                        <InputText @bind-Value="formModel.Address.City" class="form-control" placeholder="City" />
                        <ValidationMessage For="@(() => formModel.Address.City)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">State *</label>
                        <InputText @bind-Value="formModel.Address.State" class="form-control" placeholder="State" />
                        <ValidationMessage For="@(() => formModel.Address.State)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Postal Code *</label>
                        <InputText @bind-Value="formModel.Address.PostalCode" class="form-control" placeholder="12345" />
                        <ValidationMessage For="@(() => formModel.Address.PostalCode)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Country *</label>
                        <InputText @bind-Value="formModel.Address.Country" class="form-control" />
                        <ValidationMessage For="@(() => formModel.Address.Country)" class="text-danger small mt-1" />
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex justify-content-between">
            <button type="button" @onclick="GoBack" class="btn btn-outline-secondary">
                <span class="bi bi-arrow-left me-2"></span>Back
            </button>
            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                Continue to Medications<span class="bi bi-arrow-right ms-2"></span>
            </button>
        </div>
    </EditForm>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }

    @if (successMessage != null)
    {
        <div class="alert alert-success mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
</div>

@code {
    private PersonalInfoFormModel formModel = new();
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();

    public class PersonalInfoFormModel
    {
        public PersonalInfoDto PersonalInfo { get; set; } = new();
        public AddressDto Address { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        // Load existing data if editing
        await LoadExistingData();
    }

    private async Task LoadExistingData()
    {
        try
        {
            var response = await Http.GetAsync("api/checkin/personal-info");
            if (response.IsSuccessStatusCode)
            {
                var existingData = await response.Content.ReadFromJsonAsync<GetPersonalInfoResponse>();
                if (existingData != null)
                {
                    formModel.PersonalInfo = existingData.PersonalInfo;
                    formModel.Address = existingData.Address ?? new AddressDto();
                    StateHasChanged();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // No existing data found, which is fine for new users
                Console.WriteLine("No existing personal info found for user");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading existing data: {ex.Message}");
            errorMessage = "Error loading your existing information.";
        }
    }

    private async Task HandleValidSubmit()
    {
        if (!isAuthenticated)
        {
            errorMessage = "You must be logged in to save information.";
            return;
        }

        // Clear previous messages
        ClearMessages();

        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new SavePersonalInfoRequest 
            { 
                PersonalInfo = formModel.PersonalInfo,
                Address = formModel.Address
            };
            var response = await Http.PostAsJsonAsync("api/checkin/save-personal-info", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SavePersonalInfoResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Personal information and address saved successfully!";
                    await Task.Delay(1000); // Brief delay to show success message
                    Navigation.NavigateTo("/checkin-form-creation/medications");
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save personal information";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to perform this action. Please log in again.";
                isAuthenticated = false;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                // Handle validation errors from server
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while saving your information. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "PersonalInfo.FirstName" => "First Name",
            "PersonalInfo.LastName" => "Last Name",
            "PersonalInfo.Email" => "Email",
            "PersonalInfo.Phone" => "Phone Number",
            "PersonalInfo.DateOfBirth" => "Date of Birth",
            "Address.Street" => "Street Address",
            "Address.City" => "City",
            "Address.State" => "State",
            "Address.PostalCode" => "Postal Code",
            "Address.Country" => "Country",
            _ => fieldName.Replace("PersonalInfo.", "").Replace("Address.", "")
        };
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation");
    }
}

<style>
