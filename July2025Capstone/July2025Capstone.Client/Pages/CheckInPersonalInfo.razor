@page "/checkin-form-creation/personal-info"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

<PageTitle>Personal Information - Check-in Form</PageTitle>

<div class="container py-4">
    @if (!isAuthenticated)
    {
        <div class="med-card">
            <div class="card-body">
                <div class="warning-state">
                    <i class="bi bi-exclamation-triangle text-warning fs-2 mb-3"></i>
                    <h4>Authentication Required</h4>
                    <p>You need to be logged in to access this page.</p>
                    <a href="/Account/Login" class="btn-primary-modern">Login</a>
                </div>
            </div>
        </div>
        return;
    }

    <!-- Modern Progress Bar -->
    <div class="modern-progress-wrapper mb-4">
        <div class="progress-step-info">
            <span class="step-number">Step 1 of 8</span>
            <span class="step-title">Personal Information</span>
        </div>
        <div class="modern-step-progress">
            <div class="step-progress-bar" style="width: 12.5%"></div>
        </div>
    </div>

    <!-- Modern Hero Section -->
    <div class="page-hero mb-4">
        <div class="hero-icon">
            <i class="bi bi-person-fill"></i>
        </div>
        <h1 class="hero-title">Personal Information</h1>
        <p class="hero-subtitle">
            Please provide your basic personal details and address information for your medical records.
        </p>
    </div>

    @if (validationErrors.Any())
    {
        <div class="status-alert error mb-4" role="alert">
            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <EditForm Model="formModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        
        <!-- Personal Information Section -->
        <div class="med-card mb-4">
            <div class="card-header modern-header">
                <div class="header-content">
                    <div class="header-icon">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <div class="header-text">
                        <h5 class="header-title">Personal Details</h5>
                        <p class="header-subtitle">Basic information for identification and contact</p>
                    </div>
                </div>
            </div>
            <div class="card-body modern-form">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-person me-2"></i>First Name *
                            </label>
                            <InputText @bind-Value="formModel.PersonalInfo.FirstName" 
                                      class="form-control modern-input" 
                                      placeholder="Enter your first name" />
                            <ValidationMessage For="@(() => formModel.PersonalInfo.FirstName)" class="validation-message" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-person me-2"></i>Last Name *
                            </label>
                            <InputText @bind-Value="formModel.PersonalInfo.LastName" 
                                      class="form-control modern-input" 
                                      placeholder="Enter your last name" />
                            <ValidationMessage For="@(() => formModel.PersonalInfo.LastName)" class="validation-message" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-calendar3 me-2"></i>Date of Birth *
                            </label>
                            <InputDate @bind-Value="formModel.PersonalInfo.DateOfBirth" 
                                      class="form-control modern-input" />
                            <ValidationMessage For="@(() => formModel.PersonalInfo.DateOfBirth)" class="validation-message" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-gender-ambiguous me-2"></i>Gender
                            </label>
                            <InputSelect @bind-Value="formModel.PersonalInfo.Gender" class="form-select modern-select">
                                <option value="">Select gender</option>
                                <option value="@GenderType.Male">Male</option>
                                <option value="@GenderType.Female">Female</option>
                                <option value="@GenderType.Other">Other</option>
                            </InputSelect>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-envelope me-2"></i>Email Address *
                            </label>
                            <InputText @bind-Value="formModel.PersonalInfo.Email" 
                                      type="email" 
                                      class="form-control modern-input" 
                                      placeholder="your.email@example.com" />
                            <ValidationMessage For="@(() => formModel.PersonalInfo.Email)" class="validation-message" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-telephone me-2"></i>Phone Number *
                            </label>
                            <InputText @bind-Value="formModel.PersonalInfo.Phone" 
                                      type="tel" 
                                      class="form-control modern-input" 
                                      placeholder="(555) 123-4567" />
                            <ValidationMessage For="@(() => formModel.PersonalInfo.Phone)" class="validation-message" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-chat-dots me-2"></i>Preferred Contact Method
                            </label>
                            <InputSelect @bind-Value="formModel.PersonalInfo.PreferredContactMethod" class="form-select modern-select">
                                <option value="">Select contact preference</option>
                                <option value="@ContactMethod.Phone">Phone Call</option>
                                <option value="@ContactMethod.Email">Email</option>
                                <option value="@ContactMethod.Text">Text Message</option>
                            </InputSelect>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address Section -->
        <div class="med-card mb-4">
            <div class="card-header modern-header">
                <div class="header-content">
                    <div class="header-icon">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <div class="header-text">
                        <h5 class="header-title">Address Information</h5>
                        <p class="header-subtitle">Your current residential address for correspondence</p>
                    </div>
                </div>
            </div>
            <div class="card-body modern-form">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-house me-2"></i>Street Address *
                            </label>
                            <InputText @bind-Value="formModel.Address.Street" 
                                      class="form-control modern-input" 
                                      placeholder="123 Main Street, Apt 4B" />
                            <ValidationMessage For="@(() => formModel.Address.Street)" class="validation-message" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-building me-2"></i>City *
                            </label>
                            <InputText @bind-Value="formModel.Address.City" 
                                      class="form-control modern-input" 
                                      placeholder="Enter city name" />
                            <ValidationMessage For="@(() => formModel.Address.City)" class="validation-message" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-map me-2"></i>State *
                            </label>
                            <InputText @bind-Value="formModel.Address.State" 
                                      class="form-control modern-input" 
                                      placeholder="State" />
                            <ValidationMessage For="@(() => formModel.Address.State)" class="validation-message" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-mailbox me-2"></i>Postal Code *
                            </label>
                            <InputText @bind-Value="formModel.Address.PostalCode" 
                                      class="form-control modern-input" 
                                      placeholder="12345" />
                            <ValidationMessage For="@(() => formModel.Address.PostalCode)" class="validation-message" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label modern-label">
                                <i class="bi bi-globe me-2"></i>Country *
                            </label>
                            <InputText @bind-Value="formModel.Address.Country" 
                                      class="form-control modern-input" 
                                      placeholder="United States" />
                            <ValidationMessage For="@(() => formModel.Address.Country)" class="validation-message" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modern Action Buttons -->
        <div class="action-buttons-container">
            <button type="button" @onclick="GoBack" class="btn-secondary-modern">
                <i class="bi bi-arrow-left me-2"></i>
                <span>Back to Overview</span>
            </button>
            <button type="submit" class="btn-primary-modern @(isLoading ? "loading" : "")" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Saving...</span>
                }
                else
                {
                    <span>Continue to Medications</span>
                    <i class="bi bi-arrow-right ms-2"></i>
                }
            </button>
        </div>
    </EditForm>

    <!-- Status Messages -->
    @if (errorMessage != null)
    {
        <div class="status-alert error mt-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }

    @if (successMessage != null)
    {
        <div class="status-alert success mt-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
</div>

@code {
    private PersonalInfoFormModel formModel = new();
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();

    public class PersonalInfoFormModel
    {
        public PersonalInfoDto PersonalInfo { get; set; } = new();
        public AddressDto Address { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        // Load existing data if editing
        await LoadExistingData();
    }

    private async Task LoadExistingData()
    {
        try
        {
            var response = await Http.GetAsync("api/checkin/personal-info");
            if (response.IsSuccessStatusCode)
            {
                var existingData = await response.Content.ReadFromJsonAsync<GetPersonalInfoResponse>();
                if (existingData != null)
                {
                    formModel.PersonalInfo = existingData.PersonalInfo;
                    formModel.Address = existingData.Address ?? new AddressDto();
                    StateHasChanged();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // No existing data found, which is fine for new users
                Console.WriteLine("No existing personal info found for user");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading existing data: {ex.Message}");
            errorMessage = "Error loading your existing information.";
        }
    }

    private async Task HandleValidSubmit()
    {
        if (!isAuthenticated)
        {
            errorMessage = "You must be logged in to save information.";
            return;
        }

        // Clear previous messages
        ClearMessages();

        isLoading = true;
        StateHasChanged();

        try
        {
            var request = new SavePersonalInfoRequest 
            { 
                PersonalInfo = formModel.PersonalInfo,
                Address = formModel.Address
            };
            var response = await Http.PostAsJsonAsync("api/checkin/save-personal-info", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SavePersonalInfoResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Personal information and address saved successfully!";
                    await Task.Delay(1000); // Brief delay to show success message
                    Navigation.NavigateTo("/checkin-form-creation/medications");
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save personal information";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to perform this action. Please log in again.";
                isAuthenticated = false;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                // Handle validation errors from server
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while saving your information. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "PersonalInfo.FirstName" => "First Name",
            "PersonalInfo.LastName" => "Last Name",
            "PersonalInfo.Email" => "Email",
            "PersonalInfo.Phone" => "Phone Number",
            "PersonalInfo.DateOfBirth" => "Date of Birth",
            "Address.Street" => "Street Address",
            "Address.City" => "City",
            "Address.State" => "State",
            "Address.PostalCode" => "Postal Code",
            "Address.Country" => "Country",
            _ => fieldName.Replace("PersonalInfo.", "").Replace("Address.", "")
        };
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation");
    }
}

<style>
