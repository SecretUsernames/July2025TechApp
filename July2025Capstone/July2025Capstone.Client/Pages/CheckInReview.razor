@page "/checkin-form-creation/review"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@using Microsoft.Extensions.Logging
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<CheckInReview> Logger
@inject IJSRuntime JSRuntime
@rendermode InteractiveWebAssembly

<PageTitle>Review & Consent - Check-in Form</PageTitle>

<div class="container py-4">
    <!-- Progress Bar -->
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted">Step 8 of 8</span>
            <span class="text-muted">Review & Consent</span>
        </div>
        <div class="progress">
            <div class="progress-bar bg-success" role="progressbar" style="width: 100%"></div>
        </div>
    </div>

    <h3 class="mb-3">Review & Consent</h3>
    <p class="text-muted">Please review your information and provide consent to complete your check-in.</p>

    @if (!isAuthenticated)
    {
        <div class="alert alert-warning">
            <h4>Authentication Required</h4>
            <p>You need to be logged in to access this page.</p>
            <a href="/Account/Login" class="btn btn-primary">Login</a>
        </div>
        return;
    }

    @if (validationErrors.Any())
    {
        <div class="alert alert-danger mb-4">
            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <!-- Review Summary Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-check-circle-fill me-2"></i>Check-in Information Summary</h5>
        </div>
        <div class="card-body">
            @if (completionStatus != null)
            {
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-primary"><i class="bi bi-person-fill me-2"></i>Personal Information</h6>
                        <p class="mb-1"><strong>Status:</strong> 
                            @if (completionStatus.HasPersonalInfo && completionStatus.HasAddress)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                        </p>
                        
                        <h6 class="text-primary mt-3"><i class="bi bi-capsule me-2"></i>Medications</h6>
                        <p class="mb-1"><strong>Status:</strong> 
                            @if (completionStatus.HasMedications)
                            {
                                <span class="badge bg-info">Optional - Added</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Optional</span>
                            }
                        </p>
                        
                        <h6 class="text-primary mt-3"><i class="bi bi-heart-pulse me-2"></i>Medical History</h6>
                        <p class="mb-1"><strong>Status:</strong> 
                            @if (completionStatus.HasAllergies)
                            {
                                <span class="badge bg-info">Optional - Added</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Optional</span>
                            }
                        </p>
                        
                        <h6 class="text-primary mt-3"><i class="bi bi-shield-check me-2"></i>Insurance</h6>
                        <p class="mb-1"><strong>Status:</strong> 
                            @if (completionStatus.HasInsurance)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-primary"><i class="bi bi-person-lines-fill me-2"></i>Emergency Contacts</h6>
                        <p class="mb-1"><strong>Status:</strong> 
                            @if (completionStatus.HasEmergencyContacts)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                        </p>
                        
                        <h6 class="text-primary mt-3"><i class="bi bi-clipboard-pulse me-2"></i>Reason for Visit</h6>
                        <p class="mb-1"><strong>Status:</strong> 
                            @if (completionStatus.HasVisitIntake)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                        </p>
                        
                        <h6 class="text-primary mt-3"><i class="bi bi-activity me-2"></i>Lifestyle Information</h6>
                        <p class="mb-1"><strong>Status:</strong> 
                            @if (completionStatus.HasLifestyle)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                        </p>
                        
                        <h6 class="text-primary mt-3"><i class="bi bi-file-text me-2"></i>Consent</h6>
                        <p class="mb-1"><strong>Status:</strong> 
                            @if (completionStatus.HasConsent)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Pending</span>
                            }
                        </p>
                    </div>
                </div>
            }
            else
            {
                <!-- Fallback while loading completion status -->
                <div class="d-flex justify-content-center py-3">
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    <span class="text-muted">Loading completion status...</span>
                </div>
            }
        </div>
    </div>

    <!-- Consent Form -->
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>Consent for Treatment</h5>
        </div>
        <div class="card-body">
            <EditForm Model="consent" OnValidSubmit="SaveConsent">
                <DataAnnotationsValidator />
                
                <!-- Consent Text -->
                <div class="mb-4">
                    <div class="border rounded p-3 bg-light" style="max-height: 300px; overflow-y: auto;">
                        <h6 class="text-primary">INFORMED CONSENT FOR MEDICAL TREATMENT</h6>
                        <p class="small mb-2">
                            <strong>Patient Rights and Responsibilities:</strong><br/>
                            I understand that I have the right to participate in the development of my treatment plan and to receive information about my diagnosis, treatment options, and prognosis in terms I can understand.
                        </p>
                        <p class="small mb-2">
                            <strong>Treatment Authorization:</strong><br/>
                            I authorize the healthcare providers at this facility to perform diagnostic procedures, treatments, and services as deemed necessary for my care. This may include but is not limited to examinations, laboratory tests, imaging studies, medications, and other therapeutic interventions.
                        </p>
                        <p class="small mb-2">
                            <strong>Privacy and Confidentiality:</strong><br/>
                            I understand that my health information will be kept confidential and used only for treatment, payment, and healthcare operations as permitted by law and HIPAA regulations.
                        </p>
                        <p class="small mb-2">
                            <strong>Financial Responsibility:</strong><br/>
                            I understand my financial responsibility for services provided and agree to pay for services not covered by my insurance plan.
                        </p>
                        <p class="small mb-2">
                            <strong>Release of Information:</strong><br/>
                            I authorize the release of medical information necessary to process insurance claims and for continuity of care with other healthcare providers as needed.
                        </p>
                        <p class="small mb-0">
                            <strong>Questions and Concerns:</strong><br/>
                            I have been given the opportunity to ask questions about my treatment, and all my questions have been answered to my satisfaction.
                        </p>
                    </div>
                </div>

                <!-- Consent Checkbox -->
                <div class="mb-4">
                    <div class="form-check p-3 border rounded @(consent.HasConsented ? "bg-success bg-opacity-10 border-success" : "bg-warning bg-opacity-10 border-warning")">
                        <InputCheckbox @bind-Value="consent.HasConsented" class="form-check-input" id="consentCheck" />
                        <label class="form-check-label fw-bold" for="consentCheck">
                            <i class="bi bi-shield-check me-2"></i>
                            I have read and understand the above information. I voluntarily consent to the medical treatment and services described above.
                        </label>
                        <ValidationMessage For="@(() => consent.HasConsented)" class="text-danger small mt-1" />
                    </div>
                </div>

                @if (consent.HasConsented)
                {
                    <!-- Signature Section -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-pencil-square me-2"></i>Please type your full name to provide digital consent
                        </label>
                        <div class="border rounded p-3 bg-light">
                            <p class="small mb-3 text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                By typing your full name below, you are providing your electronic signature and consent to the above terms.
                            </p>
                            
                            <div class="mb-3">
                                <InputText @bind-Value="consent.SignatureName" 
                                          class="form-control" 
                                          placeholder="Type your full name here (e.g., John Smith)"
                                          maxlength="100" />
                                <ValidationMessage For="@(() => consent.SignatureName)" class="text-danger small mt-1" />
                            </div>
                            
                            @if (consent.SignedAt.HasValue)
                            {
                                <div class="alert alert-success small mb-0">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    Consent provided on @consent.SignedAt.Value.ToString("MMMM dd, yyyy 'at' h:mm tt")
                                    @if (!string.IsNullOrEmpty(consent.SignatureName))
                                    {
                                        <span> by <strong>@consent.SignatureName</strong></span>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(consent.SignatureName))
                            {
                                <div class="alert alert-info small mb-0">
                                    <i class="bi bi-info-circle me-2"></i>
                                    You will be signing as: <strong>@consent.SignatureName</strong>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between">
                    <button type="button" @onclick="GoBack" class="btn btn-outline-secondary">
                        <span class="bi bi-arrow-left me-2"></span>Back to Lifestyle
                    </button>
                    <button type="submit" class="btn btn-success btn-lg" disabled="@(!consent.HasConsented || isLoading)">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-check-circle-fill me-2"></i>Complete Check-in
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Important Notes -->
    <div class="card border-info mt-4">
        <div class="card-body">
            <h6 class="card-title"><i class="bi bi-info-circle me-2"></i>Important Information</h6>
            <ul class="mb-0 small">
                <li><strong>Review:</strong> Please review all sections above to ensure accuracy</li>
                <li><strong>Changes:</strong> If you need to make changes, use the "Back" button or start a new check-in</li>
                <li><strong>Consent:</strong> Your consent is required to complete the check-in process</li>
                <li><strong>Privacy:</strong> All information is securely stored and HIPAA compliant</li>
            </ul>
        </div>
    </div>

    @* Success and error messages *@
    @if (successMessage != null)
    {
        <div class="alert alert-success mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
    
    @if (errorMessage != null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }
</div>

@code {
    private ConsentDto consent = new();
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();
    private FormCompletionStatus? completionStatus; // Add completion status tracking

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        await LoadConsent();
        await LoadCompletionStatus(); // Load completion status for dynamic summary
    }

    private async Task LoadConsent()
    {
        try
        {
            isLoading = true;
            var response = await Http.GetAsync("api/checkin/consent");
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GetConsentResponse>();
                if (result?.Consent != null)
                {
                    consent = result.Consent;
                }
                else
                {
                    consent = new ConsentDto();
                }
                StateHasChanged();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
            else
            {
                // No existing consent is fine, user can create a new one
                consent = new ConsentDto();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading consent information");
            errorMessage = $"Error loading consent information: {ex.Message}";
            consent = new ConsentDto(); // Fallback to empty form
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCompletionStatus()
    {
        try
        {
            // Cache completion status for 30 seconds to avoid repeated calls
            var cacheKey = "completionStatus";
            var cachedStatus = await GetCachedCompletionStatus(cacheKey);
            
            if (cachedStatus != null)
            {
                completionStatus = cachedStatus;
                return;
            }

            // Get user form to get patient ID
            var userFormResponse = await Http.GetAsync("api/checkin/user-form");
            if (userFormResponse.IsSuccessStatusCode)
            {
                var existingFormSummary = await userFormResponse.Content.ReadFromJsonAsync<CheckinFormSummary>();
                
                if (existingFormSummary != null && int.TryParse(existingFormSummary.Id, out int patientId))
                {
                    var response = await Http.GetAsync($"api/checkin/patient/{patientId}");
                    
                    if (response.IsSuccessStatusCode)
                    {
                        try
                        {
                            var patientDetail = await response.Content.ReadFromJsonAsync<PatientDetailResponse>();
                            
                            if (patientDetail?.CompletionStatus != null)
                            {
                                completionStatus = patientDetail.CompletionStatus;
                                await CacheCompletionStatus(cacheKey, completionStatus);
                            }
                            else
                            {
                                completionStatus = CreateFallbackCompletionStatus();
                            }
                        }
                        catch (Exception)
                        {
                            completionStatus = CreateFallbackCompletionStatus();
                        }
                    }
                    else
                    {
                        completionStatus = CreateFallbackCompletionStatus();
                    }
                }
                else
                {
                    completionStatus = CreateFallbackCompletionStatus();
                }
            }
            else
            {
                completionStatus = CreateFallbackCompletionStatus();
            }
        }
        catch (Exception)
        {
            completionStatus = CreateFallbackCompletionStatus();
        }
    }

    private async Task<FormCompletionStatus?> GetCachedCompletionStatus(string key)
    {
        try
        {
            // Simple in-memory cache with timestamp
            var cachedData = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", $"{key}_data");
            var cachedTime = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", $"{key}_time");
            
            if (!string.IsNullOrEmpty(cachedData) && !string.IsNullOrEmpty(cachedTime))
            {
                if (DateTime.TryParse(cachedTime, out var cacheTime) && 
                    DateTime.Now.Subtract(cacheTime).TotalSeconds < 30) // 30 second cache
                {
                    return System.Text.Json.JsonSerializer.Deserialize<FormCompletionStatus>(cachedData);
                }
            }
        }
        catch { }
        return null;
    }

    private async Task CacheCompletionStatus(string key, FormCompletionStatus status)
    {
        try
        {
            var statusJson = System.Text.Json.JsonSerializer.Serialize(status);
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", $"{key}_data", statusJson);
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", $"{key}_time", DateTime.Now.ToString("O"));
        }
        catch { }
    }

    private FormCompletionStatus CreateFallbackCompletionStatus()
    {
        return new FormCompletionStatus
        {
            HasPersonalInfo = false,
            HasAddress = false,
            HasInsurance = false,
            HasEmergencyContacts = false,
            HasMedications = false,
            HasAllergies = false,
            HasLifestyle = false,
            HasVisitIntake = false,
            HasConsent = false,
            OverallComplete = false
        };
    }

    private async Task SaveConsent()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            if (!consent.HasConsented)
            {
                errorMessage = "You must provide consent to complete check-in.";
                return;
            }
            
            // Create a completely clean request with only the necessary fields
            var request = new SaveConsentRequest 
            { 
                Consent = new ConsentDto
                {
                    HasConsented = consent.HasConsented,
                    SignatureName = consent.SignatureName?.Trim(),
                    PatientName = consent.PatientName
                    // Explicitly exclude SignedAt and other auto-generated fields
                }
            };
            
            var response = await Http.PostAsJsonAsync("api/checkin/save-consent", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveConsentResponse>();
                if (result?.Success == true)
                {
                    // Reload completion status to reflect the consent update
                    await LoadCompletionStatus();
                    
                    // Complete the check-in process
                    await CompleteCheckIn();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save consent";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("BadRequest error: {ErrorContent}", errorContent);
                await HandleValidationErrors(response);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("HTTP error {StatusCode}: {ErrorContent}", response.StatusCode, errorContent);
                errorMessage = "An error occurred while saving your consent. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving consent");
            errorMessage = $"Error saving consent: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CompleteCheckIn()
    {
        try
        {
            var response = await Http.PostAsync("api/checkin/complete-checkin", null);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CompleteCheckInResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Check-in completed successfully! Thank you for providing your information.";
                    
                    // Navigate back to the check-in form creation page after a delay
                    await Task.Delay(3000);
                    Navigation.NavigateTo("/checkin-form-creation"); // Navigate to check-in form creation page
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to complete check-in";
                }
            }
            else
            {
                errorMessage = "An error occurred while completing check-in. Please contact support.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error completing check-in");
            errorMessage = $"Error completing check-in: {ex.Message}";
        }
    }

    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "Consent.HasConsented" => "Consent",
            _ => fieldName.Replace("Consent.", "")
        };
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation/lifestyle");
    }

    // Model classes for completion status
    public class CheckinFormSummary
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public DateTime CreatedDate { get; set; }
        public DateTime LastModified { get; set; }
        public bool IsComplete { get; set; }
    }

    public class FormCompletionStatus
    {
        public bool HasPersonalInfo { get; set; }
        public bool HasAddress { get; set; }
        public bool HasInsurance { get; set; }
        public bool HasEmergencyContacts { get; set; }
        public bool HasMedications { get; set; }
        public bool HasAllergies { get; set; }
        public bool HasLifestyle { get; set; }
        public bool HasVisitIntake { get; set; }
        public bool HasConsent { get; set; }
        public bool OverallComplete { get; set; }
    }

    public class PatientDetailResponse
    {
        public FormCompletionStatus? CompletionStatus { get; set; }
    }
}