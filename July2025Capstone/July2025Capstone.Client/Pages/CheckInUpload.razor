@page "/checkin-upload"
@using System.Net.Http.Json
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@rendermode InteractiveWebAssembly

<PageTitle>Upload Check-in Information</PageTitle>

<h3 class="mb-3">Upload Check-in Information</h3>
<p class="text-muted">Insurance, demographics, emergency contacts—skip the clipboard at the hospital.</p>

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Uploading...</span>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <InputFile OnChange="OnFilesSelected" accept=".json,.pdf,.txt" />
            
            @if (uploadStatus != null)
            {
                <div class="alert @(uploadStatus.IsSuccess ? "alert-success" : "alert-danger") mt-3" role="alert">
                    @uploadStatus.Message
                </div>
            }

            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label">Or paste JSON</label>
                    <textarea @bind="jsonData" class="form-control" rows="6" placeholder='{"firstName":"John", "lastName":"Doe", "insurance":"Blue Cross"}'></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Notes</label>
                    <textarea @bind="notes" class="form-control" rows="6" placeholder="Any special instructions…"></textarea>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" disabled="@(!hasInput || isLoading)" @onclick="SaveCheckinProfile">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Save Check-in Profile
                </button>
                <button class="btn btn-outline-secondary" disabled="@(!hasInput)" @onclick="PreviewData">Preview</button>
            </div>

            @if (showPreview && previewData != null)
            {
                <div class="mt-4">
                    <h5>Preview</h5>
                    <div class="card">
                        <div class="card-body">
                            <pre>@previewData</pre>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool hasInput = false;
    private bool isLoading = false;
    private bool showPreview = false;
    private string jsonData = string.Empty;
    private string notes = string.Empty;
    private string? previewData;
    private IBrowserFile? selectedFile;
    private UploadStatus? uploadStatus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Configure the HttpClient base address if it's not set (for server-side rendering)
            if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
            {
                Http.BaseAddress = new Uri("https://localhost:7014/"); // Update port as needed
            }
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        hasInput = e.FileCount > 0 || !string.IsNullOrWhiteSpace(jsonData);
        uploadStatus = null;
        StateHasChanged();
    }

    private void OnJsonDataChanged()
    {
        hasInput = selectedFile != null || !string.IsNullOrWhiteSpace(jsonData);
        StateHasChanged();
    }

    private async Task SaveCheckinProfile()
    {
        isLoading = true;
        uploadStatus = null;
        StateHasChanged();

        try
        {
            var formData = new MultipartFormDataContent();

            // Add file if selected
            if (selectedFile != null)
            {
                var fileContent = new StreamContent(selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)); // 10MB limit
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);
                formData.Add(fileContent, "file", selectedFile.Name);
            }

            // Add JSON data if provided
            if (!string.IsNullOrWhiteSpace(jsonData))
            {
                formData.Add(new StringContent(jsonData), "jsonData");
            }

            // Add notes if provided
            if (!string.IsNullOrWhiteSpace(notes))
            {
                formData.Add(new StringContent(notes), "notes");
            }

            var response = await Http.PostAsync("api/checkin/upload", formData);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CheckinUploadResponse>();
                uploadStatus = new UploadStatus
                {
                    IsSuccess = true,
                    Message = result?.Message ?? "Check-in profile saved successfully!"
                };

                // Clear form after successful upload
                selectedFile = null;
                jsonData = string.Empty;
                notes = string.Empty;
                hasInput = false;
                showPreview = false;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                uploadStatus = new UploadStatus
                {
                    IsSuccess = false,
                    Message = $"Upload failed: {errorContent}"
                };
            }
        }
        catch (Exception ex)
        {
            uploadStatus = new UploadStatus
            {
                IsSuccess = false,
                Message = $"Error: {ex.Message}"
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void PreviewData()
    {
        if (!string.IsNullOrWhiteSpace(jsonData))
        {
            previewData = jsonData;
        }
        else if (selectedFile != null)
        {
            previewData = $"File: {selectedFile.Name}\nSize: {selectedFile.Size} bytes\nType: {selectedFile.ContentType}";
        }

        if (!string.IsNullOrWhiteSpace(notes))
        {
            previewData += $"\n\nNotes:\n{notes}";
        }

        showPreview = true;
        StateHasChanged();
    }

    // Model classes
    public class CheckinUploadResponse
    {
        public string Message { get; set; } = string.Empty;
        public bool Success { get; set; }
        public string? ProfileId { get; set; }
    }

    public class UploadStatus
    {
        public bool IsSuccess { get; set; }
        public string Message { get; set; } = string.Empty;
    }
}