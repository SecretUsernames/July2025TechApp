@page "/checkin-form-creation/visit-intake"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveWebAssembly

<PageTitle>Primary Reason for Visit - Check-in Form</PageTitle>

<div class="container py-4">
    <!-- Progress Bar -->
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted">Step 6 of 8</span>
            <span class="text-muted">Reason for Visit</span>
        </div>
        <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: 75%"></div>
        </div>
    </div>

    <h3 class="mb-3">Primary Reason for Visit</h3>
    <p class="text-muted">Please describe the main reason for your visit today. This helps our medical staff prepare for your appointment.</p>

    @if (!isAuthenticated)
    {
        <div class="alert alert-warning">
            <h4>Authentication Required</h4>
            <p>You need to be logged in to access this page.</p>
            <a href="/Account/Login" class="btn btn-primary">Login</a>
        </div>
        return;
    }

    @if (validationErrors.Any())
    {
        <div class="alert alert-danger mb-4">
            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <EditForm Model="visitIntake" OnValidSubmit="SaveVisitIntake">
                <DataAnnotationsValidator />
                
                <div class="mb-4">
                    <label class="form-label fw-semibold">Primary Reason for Visit *</label>
                    <InputTextArea @bind-Value="visitIntake.PrimaryReason" 
                                   class="form-control" 
                                   rows="4"
                                   placeholder="Please describe your symptoms, concerns, or the reason for today's visit. For example: 'Annual checkup', 'Chest pain for 2 days', 'Follow-up for diabetes', etc." />
                    <ValidationMessage For="@(() => visitIntake.PrimaryReason)" class="text-danger small mt-1" />
                    <div class="form-text">Be as specific as possible to help our medical staff prepare for your visit.</div>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="visitIntake.TreatedBefore" class="form-check-input" id="treatedBeforeCheck" />
                        <label class="form-check-label" for="treatedBeforeCheck">
                            I have been treated for this condition/symptom before
                        </label>
                    </div>
                    <div class="form-text">Check this if you've received medical care for this issue previously.</div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between">
                    <button type="button" @onclick="GoBack" class="btn btn-outline-secondary">
                        <span class="bi bi-arrow-left me-2"></span>Back
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Continue to Lifestyle Information<span class="bi bi-arrow-right ms-2"></span>
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Additional Information Card -->
    <div class="card border-info mt-4">
        <div class="card-body">
            <h6 class="card-title"><i class="bi bi-info-circle me-2"></i>Why do we ask for this information?</h6>
            <ul class="mb-0 small">
                <li>Helps medical staff prepare for your appointment</li>
                <li>Allows for more efficient triage and care</li>
                <li>Ensures appropriate time is allocated for your visit</li>
                <li>Helps identify if you need urgent care</li>
            </ul>
        </div>
    </div>

    @* Success and error messages *@
    @if (successMessage != null)
    {
        <div class="alert alert-success mt-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
    
    @if (errorMessage != null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }
</div>

@code {
    private VisitIntakeDto visitIntake = new();
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        await LoadVisitIntake();
    }

    private async Task LoadVisitIntake()
    {
        try
        {
            isLoading = true;
            var response = await Http.GetAsync("api/checkin/visit-intake");
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GetVisitIntakeResponse>();
                if (result?.VisitIntake != null)
                {
                    visitIntake = result.VisitIntake;
                }
                StateHasChanged();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
            else
            {
                // No existing visit intake is fine, user can create a new one
                visitIntake = new VisitIntakeDto();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading visit information: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveVisitIntake()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            var request = new SaveVisitIntakeRequest { VisitIntake = visitIntake };
            var response = await Http.PostAsJsonAsync("api/checkin/save-visit-intake", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveVisitIntakeResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Visit information saved successfully!";
                    
                    // Navigate to next step after a short delay
                    await Task.Delay(1000);
                    Continue();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save visit information";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                await HandleValidationErrors(response);
            }
            else
            {
                errorMessage = "An error occurred while saving your visit information. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving visit information: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "VisitIntake.PrimaryReason" => "Primary Reason",
            _ => fieldName.Replace("VisitIntake.", "")
        };
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation/emergency-contacts");
    }

    private void Continue()
    {
        Navigation.NavigateTo("/checkin-form-creation/lifestyle");
    }
}