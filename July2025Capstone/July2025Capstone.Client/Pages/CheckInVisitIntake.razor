@page "/checkin-form-creation/visit-intake"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@using Microsoft.Extensions.Logging
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<CheckInVisitIntake> Logger
@rendermode InteractiveWebAssembly

<PageTitle>Visit Information - Check-in Form</PageTitle>

<div class="container py-4">
    @if (!isAuthenticated)
    {
        <div class="med-card">
            <div class="card-body">
                <div class="warning-state">
                    <i class="bi bi-exclamation-triangle text-warning fs-2 mb-3"></i>
                    <h4>Authentication Required</h4>
                    <p>You need to be logged in to access this page.</p>
                    <a href="/Account/Login" class="btn-primary-modern">Login</a>
                </div>
            </div>
        </div>
        return;
    }

    <!-- Modern Progress Bar -->
    <div class="modern-progress-wrapper mb-4">
        <div class="progress-step-info">
            <span class="step-number">Step 6 of 8</span>
            <span class="step-title">Visit Information</span>
        </div>
        <div class="modern-step-progress">
            <div class="step-progress-bar" style="width: 75%"></div>
        </div>
    </div>

    <!-- Modern Hero Section -->
    <div class="page-hero mb-4">
        <div class="hero-icon">
            <i class="bi bi-clipboard-pulse"></i>
        </div>
        <h1 class="hero-title">Reason for Visit</h1>
        <p class="hero-subtitle">
            Help us prepare for your appointment by describing your symptoms, concerns, or the reason for today's visit.
        </p>
    </div>

    @if (validationErrors.Any())
    {
        <div class="status-alert error mb-4" role="alert">
            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Please correct the following errors:</h6>
            <ul class="mb-0">
                @foreach (var error in validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="med-card">
        <div class="card-header modern-header">
            <div class="header-content">
                <div class="header-icon">
                    <i class="bi bi-stethoscope"></i>
                </div>
                <div class="header-text">
                    <h5 class="header-title">Visit Details</h5>
                    <p class="header-subtitle">Provide information about your current health concerns and visit purpose</p>
                </div>
            </div>
        </div>
        <div class="card-body modern-form">
            <EditForm Model="visitIntake" OnValidSubmit="SaveVisitIntake">
                <DataAnnotationsValidator />
                
                <div class="form-section mb-5">
                    <div class="section-header">
                        <i class="bi bi-chat-text text-primary me-2"></i>
                        <h6 class="section-title">Primary Reason for Visit</h6>
                    </div>
                    <div class="form-group">
                        <label class="form-label modern-label">
                            <i class="bi bi-pencil-square me-2"></i>Describe your symptoms or reason for today's visit *
                        </label>
                        <InputTextArea @bind-Value="visitIntake.PrimaryReason" 
                                       class="form-control modern-textarea" 
                                       rows="5"
                                       placeholder="Please be as specific as possible. For example: 'Annual checkup', 'Chest pain for 2 days', 'Follow-up for diabetes', 'Persistent headaches', etc." />
                        <ValidationMessage For="@(() => visitIntake.PrimaryReason)" class="validation-message" />
                        <div class="input-help">
                            <i class="bi bi-info-circle me-1"></i>
                            Be as detailed as possible to help our medical staff prepare for your visit and provide the best care.
                        </div>
                    </div>
                </div>

                <div class="form-section mb-5">
                    <div class="section-header">
                        <i class="bi bi-clock-history text-primary me-2"></i>
                        <h6 class="section-title">Medical History</h6>
                    </div>
                    <div class="checkbox-container">
                        <div class="custom-checkbox">
                            <InputCheckbox @bind-Value="visitIntake.TreatedBefore" class="form-check-input modern-checkbox" id="treatedBeforeCheck" />
                            <label class="form-check-label modern-checkbox-label" for="treatedBeforeCheck">
                                <div class="checkbox-content">
                                    <span class="checkbox-title">I have been treated for this condition/symptom before</span>
                                    <span class="checkbox-subtitle">Check this if you've received medical care for this issue previously</span>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Modern Action Buttons -->
                <div class="form-actions">
                    <button type="button" @onclick="GoBack" class="btn-secondary-modern">
                        <i class="bi bi-arrow-left me-2"></i>
                        <span>Back to Emergency Contacts</span>
                    </button>
                    <button type="submit" class="btn-primary-modern @(isLoading ? "loading" : "")" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Continue to Lifestyle Information</span>
                            <i class="bi bi-arrow-right ms-2"></i>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Information Card -->
    <div class="med-card info-card mt-4">
        <div class="card-body">
            <div class="info-card-header">
                <i class="bi bi-lightbulb text-warning fs-4 me-2"></i>
                <h6 class="info-card-title">Why do we ask for this information?</h6>
            </div>
            <div class="info-benefits">
                <div class="benefit-item">
                    <i class="bi bi-clipboard-check text-success me-2"></i>
                    <span>Helps medical staff prepare for your appointment in advance</span>
                </div>
                <div class="benefit-item">
                    <i class="bi bi-speedometer2 text-info me-2"></i>
                    <span>Allows for more efficient triage and prioritized care</span>
                </div>
                <div class="benefit-item">
                    <i class="bi bi-clock text-primary me-2"></i>
                    <span>Ensures appropriate time is allocated for your specific needs</span>
                </div>
                <div class="benefit-item">
                    <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                    <span>Helps identify if you need urgent or specialized care</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Messages -->
    @if (successMessage != null)
    {
        <div class="status-alert success mt-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
        </div>
    }
    
    @if (errorMessage != null)
    {
        <div class="status-alert error mt-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
        </div>
    }
</div>

@code {
    private VisitIntakeDto visitIntake = new();
    private bool isLoading = false;
    private bool isAuthenticated = false;
    private string? errorMessage;
    private string? successMessage;
    private List<string> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        // Check authentication state
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            return;
        }

        // Configure HttpClient base address
        if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
        {
            Http.BaseAddress = new Uri("https://localhost:7014/");
        }

        await LoadVisitIntake();
    }

    private async Task LoadVisitIntake()
    {
        try
        {
            isLoading = true;
            Logger.LogInformation("Starting to load visit intake data...");
            
            var response = await Http.GetAsync("api/checkin/visit-intake");
            Logger.LogInformation("HTTP Response Status: {StatusCode}", response.StatusCode);
            
            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadAsStringAsync();
                Logger.LogInformation("Raw response content: {Content}", responseContent);
                
                var result = await response.Content.ReadFromJsonAsync<GetVisitIntakeResponse>();
                if (result?.VisitIntake != null)
                {
                    visitIntake = result.VisitIntake;
                    Logger.LogInformation("Loaded visit intake - Reason: {Reason}, TreatedBefore: {TreatedBefore}", 
                        visitIntake.PrimaryReason, visitIntake.TreatedBefore);
                }
                else
                {
                    visitIntake = new VisitIntakeDto();
                    Logger.LogInformation("No existing visit intake found, created new default DTO");
                }
                StateHasChanged();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "You are not authorized to access this data. Please log in again.";
                isAuthenticated = false;
            }
            else
            {
                // No existing visit intake is fine, user can create a new one
                visitIntake = new VisitIntakeDto();
                Logger.LogInformation("HTTP error {StatusCode}, created new default visit intake DTO", response.StatusCode);
            }
        }
        catch (JsonException jsonEx)
        {
            // Handle JSON deserialization errors by starting fresh
            Logger.LogWarning("JSON deserialization error, clearing visit intake data: {Error}", jsonEx.Message);
            visitIntake = new VisitIntakeDto();
            errorMessage = "Previous visit intake data was corrupted. Please re-enter your information.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading visit intake information");
            errorMessage = $"Error loading visit intake information: {ex.Message}";
            visitIntake = new VisitIntakeDto(); // Fallback to empty form
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveVisitIntake()
    {
        try
        {
            isLoading = true;
            ClearMessages();
            
            // Debug logging
            Logger.LogInformation("Saving visit intake: Reason='{PrimaryReason}', TreatedBefore={TreatedBefore}", 
                visitIntake.PrimaryReason, visitIntake.TreatedBefore);
            
            var request = new SaveVisitIntakeRequest { VisitIntake = visitIntake };
            var response = await Http.PostAsJsonAsync("api/checkin/save-visit-intake", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SaveVisitIntakeResponse>();
                if (result?.Success == true)
                {
                    successMessage = "Visit information saved successfully!";
                    
                    // Navigate to next step after a short delay
                    await Task.Delay(1000);
                    Continue();
                }
                else
                {
                    errorMessage = result?.Message ?? "Failed to save visit information";
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("BadRequest error: {ErrorContent}", errorContent);
                await HandleValidationErrors(response);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("HTTP error {StatusCode}: {ErrorContent}", response.StatusCode, errorContent);
                errorMessage = "An error occurred while saving your visit information. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving visit intake information");
            errorMessage = $"Error saving visit information: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleValidationErrors(HttpResponseMessage response)
    {
        try
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            
            // Try to parse as validation problem details
            using var document = JsonDocument.Parse(errorContent);
            var root = document.RootElement;
            
            if (root.TryGetProperty("errors", out var errorsElement))
            {
                validationErrors.Clear();
                
                foreach (var errorProperty in errorsElement.EnumerateObject())
                {
                    var fieldName = GetFriendlyFieldName(errorProperty.Name);
                    
                    if (errorProperty.Value.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var errorMessage in errorProperty.Value.EnumerateArray())
                        {
                            if (errorMessage.ValueKind == JsonValueKind.String)
                            {
                                validationErrors.Add($"{fieldName}: {errorMessage.GetString()}");
                            }
                        }
                    }
                }
                
                if (!validationErrors.Any())
                {
                    errorMessage = "Please check your input and try again.";
                }
            }
            else if (root.TryGetProperty("title", out var titleElement))
            {
                errorMessage = titleElement.GetString() ?? "Validation errors occurred.";
            }
            else
            {
                errorMessage = "Please check your input and try again.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Please check your input and try again.";
        }
    }

    private string GetFriendlyFieldName(string fieldName)
    {
        return fieldName switch
        {
            "VisitIntake.PrimaryReason" => "Primary Reason for Visit",
            _ => fieldName.Replace("VisitIntake.", "")
        };
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
        validationErrors.Clear();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/checkin-form-creation/emergency-contacts");
    }

    private void Continue()
    {
        Navigation.NavigateTo("/checkin-form-creation/lifestyle");
    }
}

