@page "/"
@using July2025Capstone.Client.Pages
@using System.Net.Http.Json
@inject IJSRuntime JS
@inject HttpClient Http
@rendermode InteractiveWebAssembly

<PageTitle>MedVault - Home</PageTitle>

<div class="container py-4">
    <!-- Hero -->
    <div class="med-banner mb-4">
        <h1 class="mb-1">MedVault</h1>
        <p class="mb-0">
            Securely store your medical records, auto-fill check-ins, and see instant health insights.
        </p>
    </div>

    <!-- Top actions -->
    <div class="row g-4 med-actions">
        <div class="col-md-4">
            <div class="card med-card h-100">
                <div class="card-body">
                    <div class="med-section-title">Upload</div>
                    <h5 class="card-title">Medical Records</h5>
                    <p class="text-muted mb-3">PDFs, CCD/HL7, labs, and imaging reports.</p>
                    <NavLink class="btn btn-primary w-100" href="records-upload">
                        <span class="bi bi-file-earmark-arrow-up me-1"></span> Upload Records
                    </NavLink>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card med-card h-100">
                <div class="card-body">
                    <div class="med-section-title">Upload</div>
                    <h5 class="card-title">Check-in Info</h5>
                    <p class="text-muted mb-3">Demographics & insurance for one-tap check-in.</p>
                    <NavLink class="btn btn-success w-100" href="checkin-upload">
                        <span class="bi bi-clipboard-check me-1"></span> Upload Check-in
                    </NavLink>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card med-card h-100">
                <div class="card-body">
                    <div class="med-section-title">Insights</div>
                    <h5 class="card-title">Analytics</h5>
                    <p class="text-muted mb-3">Trends, alerts, and insights � at a glance.</p>
                    <div class="d-grid gap-2">
                        <NavLink class="btn btn-outline-primary" href="analytics">
                            <span class="bi bi-graph-up me-1"></span> View Analytics
                        </NavLink>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI row -->
    @if (isLoading)
    {
        <div class="med-kpi my-4">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
            <span class="text-muted">Loading dashboard data...</span>
        </div>
    }
    else if (dashboardData != null)
    {
        <div class="med-kpi my-4">
            <span class="badge badge-soft"><strong>BP:</strong> @dashboardData.BloodPressure</span>
            <span class="badge badge-soft-danger"><strong>HR:</strong> @dashboardData.HeartRate bpm</span>
            <span class="badge badge-soft-info"><strong>Glucose:</strong> @dashboardData.Glucose mg/dL</span>
            <span class="badge badge-soft-success"><strong>Weight:</strong> @dashboardData.Weight lb</span>
            <span class="badge badge-soft"><strong>Last upload:</strong> @dashboardData.LastUpload</span>
        </div>
    }
    else
    {
        <div class="med-kpi my-4">
            <span class="badge badge-soft-warning">No recent data available</span>
        </div>
    }

    <!-- Charts -->
    <div class="row g-4">
        <div class="col-lg-3 col-md-6">
            <div class="card med-card">
                <div class="card-body">
                    <div class="med-section-title">Vitals</div>
                    <h5 class="card-title mb-3">Blood Pressure</h5>
                    <div class="med-chart-wrap">
                        <canvas id="bpChart" class="med-chart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card med-card">
                <div class="card-body">
                    <div class="med-section-title">Vitals</div>
                    <h5 class="card-title mb-3">Heart Rate</h5>
                    <div class="med-chart-wrap">
                        <canvas id="hrChart" class="med-chart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card med-card">
                <div class="card-body">
                    <div class="med-section-title">Labs</div>
                    <h5 class="card-title mb-3">Glucose</h5>
                    <div class="med-chart-wrap">
                        <canvas id="glucoseChart" class="med-chart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card med-card">
                <div class="card-body">
                    <div class="med-section-title">Body</div>
                    <h5 class="card-title mb-3">Weight & BMI</h5>
                    <div class="med-chart-wrap">
                        <canvas id="weightChart" class="med-chart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Links + Privacy -->
    <div class="row g-4 mt-1">
        <div class="col-lg-8">
            <div class="card med-card">
                <div class="card-body">
                    <div class="med-section-title">Quick Links</div>
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="mb-0">
                                <li><NavLink href="records-upload">Add a new lab result</NavLink></li>
                                <li><NavLink href="checkin-upload">Update insurance</NavLink></li>
                                <li><NavLink href="analytics">See all charts</NavLink></li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="mb-0">
                                <li><NavLink href="">Help & docs (soon)</NavLink></li>
                                @if (recentActivities?.Any() == true)
                                {
                                    <li><strong>Recent:</strong> @recentActivities.First().Description</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card med-card">
                <div class="card-body">
                    <div class="med-section-title">Privacy</div>
                    <h5 class="card-title">Your data is your data</h5>
                    <p class="text-muted mb-0">Uploads are encrypted at rest and in transit.</p>
                    @if (dashboardData != null)
                    {
                        <small class="text-muted d-block mt-2">
                            <i class="bi bi-shield-check me-1"></i>
                            @dashboardData.TotalRecords records securely stored
                        </small>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@* <ChatWidget @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" /> *@
@code {
    private bool isLoading = true;
    private DashboardData? dashboardData;
    private List<RecentActivity>? recentActivities;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Configure the HttpClient base address if it's not set (for server-side rendering)
            if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
            {
                Http.BaseAddress = new Uri("https://localhost:7014/"); // Update port as needed
            }

            await LoadDashboardData();
            
            try 
            { 
                await JS.InvokeVoidAsync("medvaultCharts.initAll"); 
            }
            catch 
            { 
                /* ignore init errors in dev */ 
            }
        }
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Load dashboard data and recent activities concurrently
            var dashboardTask = Http.GetFromJsonAsync<DashboardData>("api/dashboard/summary");
            var activitiesTask = Http.GetFromJsonAsync<List<RecentActivity>>("api/dashboard/recent-activities");

            await Task.WhenAll(dashboardTask, activitiesTask);

            dashboardData = await dashboardTask;
            recentActivities = await activitiesTask ?? new List<RecentActivity>();
        }
        catch (HttpRequestException ex)
        {
            // Handle network errors silently for dashboard
            Console.WriteLine($"Dashboard data load failed: {ex.Message}");
        }
        catch (Exception ex)
        {
            // Handle other errors silently for dashboard
            Console.WriteLine($"Unexpected error loading dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // Model classes
    public class DashboardData
    {
        public string BloodPressure { get; set; } = "118/76";
        public int HeartRate { get; set; } = 68;
        public int Glucose { get; set; } = 128;
        public int Weight { get; set; } = 162;
        public string LastUpload { get; set; } = "2h";
        public int TotalRecords { get; set; } = 0;
        public int AlertCount { get; set; } = 0;
    }

    public class RecentActivity
    {
        public string Id { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; }
        public string Type { get; set; } = string.Empty;
    }
}

<ChatWidget @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />