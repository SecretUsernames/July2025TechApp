<SfGrid DataSource="@medications" AllowPaging="false" AllowSorting="false" Width="100%">
    <GridColumns>
        <GridColumn Field=@nameof(MedicationDTO.Name) HeaderText="Name" Width="150"></GridColumn>
        <GridColumn Field=@nameof(MedicationDTO.DosageStrength) HeaderText="Strength" Width="100"></GridColumn>
        <GridColumn Field=@nameof(MedicationDTO.DosageUnit) HeaderText="Unit" Width="100"></GridColumn>
        <GridColumn Field=@nameof(MedicationDTO.Frequency) HeaderText="Frequency" Width="150"></GridColumn>
    </GridColumns>
</SfGrid>


<div class="mt-3">
    <SfButton CssClass="e-outline" Content="+ Add Medication" OnClick="AddMedication"></SfButton>
</div>

<div class="d-flex justify-content-between mt-4">
    <SfButton CssClass="e-secondary" Content="Back" OnClick="GoBack"></SfButton>
    <SfButton CssClass="e-primary" Content="Next" OnClick="GoNext"></SfButton>
</div>

