<PageTitle>Medications & Tracker</PageTitle>

@page "/medications"
@rendermode InteractiveWebAssembly
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Navigations
@using July2025Capstone.Shared
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using July2025Capstone.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<div class="container py-4">
    <!-- Header -->
    <div class="bg-primary text-white rounded-lg p-4 mb-4">
        <div class="d-flex align-items-center gap-3">
            <span class="bi bi-heart fs-2"></span>
            <div>
                <h2 class="mb-1">Medication Tracker</h2>
                <p class="mb-0">Manage your medications and track your daily doses for better health outcomes</p>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary bg-opacity-10 border-primary border-opacity-25">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <span class="bi bi-capsule fs-3 text-primary"></span>
                        <div>
                            <h4 class="mb-0">@medications.Count</h4>
                            <small class="text-muted">Active Medications</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success bg-opacity-10 border-success border-opacity-25">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <span class="bi bi-calendar-check fs-3 text-success"></span>
                        <div>
                            <h4 class="mb-0">@weeklyStats.TotalTaken</h4>
                            <small class="text-muted">Doses This Week</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info bg-opacity-10 border-info border-opacity-25">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <span class="bi bi-graph-up fs-3 text-info"></span>
                        <div>
                            <h4 class="mb-0">@(adherenceRate.ToString("F0"))%</h4>
                            <small class="text-muted">Adherence Rate</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!isAuthenticated)
    {
        <div class="alert alert-warning">
            <h4>Authentication Required</h4>
            <p>You need to be logged in to access this page.</p>
            <a href="/Account/Login" class="btn btn-primary">Login</a>
        </div>
        return;
    }

    <!-- Main Content -->
    <div class="row">
        <!-- Left Column - Medication Management -->
        <div class="col-xl-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <span class="bi bi-list-ul me-2"></span>My Medications
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Add Medication Button -->
                    <div class="mb-3">
                        <button type="button" class="btn btn-primary" @onclick="ShowAddDialog">
                            <span class="bi bi-plus-circle me-2"></span>Add Medication
                        </button>
                    </div>

                    <!-- Medications Table -->
                    @if (medications.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Medication Name</th>
                                        <th>Dosage</th>
                                        <th>Frequency</th>
                                        <th width="120">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var medication in medications)
                                    {
                                        <tr>
                                            <td>@medication.Name</td>
                                            <td>@medication.DosageDisplay</td>
                                            <td>@medication.FrequencyDisplay</td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button type="button" class="btn btn-outline-primary" @onclick="() => EditMedication(medication)" title="Edit">
                                                        <span class="bi bi-pencil"></span>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger" @onclick="() => DeleteMedication(medication)" title="Delete">
                                                        <span class="bi bi-trash"></span>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <span class="bi bi-capsule fs-1 d-block mb-3"></span>
                                <h5>No medications added yet</h5>
                                <p class="mb-0">Click "Add Medication" to get started</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Weekly Tracker -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <span class="bi bi-calendar-week me-2 text-success"></span>Weekly Tracker
                        </h5>
                        <div class="d-flex gap-2">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                @weeklyStats.TotalTaken/@weeklyStats.TotalScheduled taken
                            </span>
                            @if (weeklyStats.AsNeededCount > 0)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">
                                    @weeklyStats.AsNeededCount as needed
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (medications.Any())
                    {
                        @foreach (var medication in medications)
                        {
                            var times = MedicationTracker.GetTimesForFrequency(medication.Frequency);
                            var isAsNeeded = medication.Frequency == MedicationFrequency.AsNeeded;

                            <div class="mb-4">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <h6 class="mb-0">@medication.Name</h6>
                                    <span class="badge @(isAsNeeded ? "bg-secondary" : "bg-primary") bg-opacity-10">
                                        @(isAsNeeded ? "As needed" : $"{times.Count}x daily")
                                    </span>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-borderless table-sm">
                                        <thead>
                                            <tr>
                                                <th style="width: 100px;">Time</th>
                                                @for (int day = 0; day < 7; day++)
                                                {
                                                    <th class="text-center">@MedicationTracker.GetDayShortName(day)</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var time in times)
                                            {
                                                <tr>
                                                    <td class="text-muted small">@MedicationTracker.GetTimeDisplayName(time)</td>
                                                    @for (int day = 0; day < 7; day++)
                                                    {
                                                        var dose = GetDoseStatus(medication.Id, day, time);
                                                        var isTaken = dose?.Taken ?? false;

                                                        <td class="text-center">
                                                            <button type="button"
                                                                    class="btn btn-sm @(isTaken ? "btn-success" : "btn-outline-secondary") rounded-circle"
                                                                    style="width: 35px; height: 35px;"
                                                                    @onclick="() => ToggleDoseAsync(medication.Id, day, time)">
                                                                @if (isTaken)
                                                                {
                                                                    <span class="bi bi-check"></span>
                                                                }
                                                                else
                                                                {
                                                                    <span style="font-size: 0.7rem;">✓</span>
                                                                }
                                                            </button>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <span class="bi bi-calendar-x fs-1 text-muted d-block mb-3"></span>
                            <h6 class="text-muted">No medications to track</h6>
                            <p class="text-muted mb-0">Add medications to start tracking your weekly schedule</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column - Statistics -->
        <div class="col-xl-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">
                        <span class="bi bi-graph-up me-2 text-primary"></span>Weekly Summary
                    </h5>
                </div>
                <div class="card-body">
                    @if (weeklyStats.TotalScheduled == 0 && weeklyStats.AsNeededCount == 0)
                    {
                        <div class="text-center py-5">
                            <span class="bi bi-target fs-1 text-muted d-block mb-3"></span>
                            <p class="text-muted mb-0">Start tracking to see your weekly summary</p>
                        </div>
                    }
                    else
                    {
                        <!-- Adherence Rate -->
                        @if (weeklyStats.TotalScheduled > 0)
                        {
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0">Medication Adherence</h6>
                                    <span class="badge @GetAdherenceColorClass(adherenceRate) bg-opacity-10 border border-opacity-25">
                                        @(adherenceRate.ToString("F0"))%
                                    </span>
                                </div>
                                <div class="progress mb-2" style="height: 8px;">
                                    <div class="progress-bar @GetProgressBarClass(adherenceRate)"
                                         role="progressbar"
                                         style="width: @(adherenceRate)%"></div>
                                </div>
                                <p class="small mb-0 @GetAdherenceColorClass(adherenceRate)">
                                    @MedicationTracker.GetAdherenceMessage(adherenceRate)
                                </p>
                            </div>
                        }

                        <!-- Statistics Grid -->
                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <div class="bg-success bg-opacity-10 rounded p-3 border border-success border-opacity-25">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="bi bi-check-circle text-success"></span>
                                        <div>
                                            <div class="fw-bold text-success">@weeklyStats.TotalTaken</div>
                                            <small class="text-muted">Taken</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-danger bg-opacity-10 rounded p-3 border border-danger border-opacity-25">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="bi bi-exclamation-circle text-danger"></span>
                                        <div>
                                            <div class="fw-bold text-danger">@weeklyStats.TotalMissed</div>
                                            <small class="text-muted">Missed</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-primary bg-opacity-10 rounded p-3 border border-primary border-opacity-25">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="bi bi-target text-primary"></span>
                                        <div>
                                            <div class="fw-bold text-primary">@weeklyStats.TotalScheduled</div>
                                            <small class="text-muted">Scheduled</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @if (weeklyStats.AsNeededCount > 0)
                            {
                                <div class="col-6">
                                    <div class="bg-warning bg-opacity-10 rounded p-3 border border-warning border-opacity-25">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="bi bi-clock text-warning"></span>
                                            <div>
                                                <div class="fw-bold text-warning">@weeklyStats.AsNeededCount</div>
                                                <small class="text-muted">As Needed</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Tips -->
                        <div class="bg-light rounded p-3">
                            <h6 class="mb-3">💡 Medication Tips</h6>
                            <ul class="list-unstyled mb-0 small text-muted">
                                <li class="mb-2">• Set daily reminders for consistent timing</li>
                                <li class="mb-2">• Take with food if recommended</li>
                                <li class="mb-2">• Keep backup supply when traveling</li>
                                <li class="mb-0">• Aim for 90%+ adherence for best results</li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Add/Edit Medication Modal -->
    @if (showDialog)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@dialogTitle</h5>
                        <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                    </div>
                    <EditForm Model="currentMedication" OnValidSubmit="SaveMedication">
                        <DataAnnotationsValidator />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Medication Name *</label>
                                <InputText @bind-Value="currentMedication.Name"
                                           class="form-control"
                                           placeholder="Enter medication name" />
                                <ValidationMessage For="@(() => currentMedication.Name)" class="text-danger" />
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Dosage Strength *</label>
                                    <InputNumber @bind-Value="currentMedication.DosageStrength"
                                                 class="form-control"
                                                 placeholder="0"
                                                 step="0" />
                                    <ValidationMessage For="@(() => currentMedication.DosageStrength)" class="text-danger" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Unit *</label>
                                    <InputSelect @bind-Value="currentMedication.DosageUnit" class="form-select">
                                        <option value="">Select unit</option>
                                        @foreach (var unit in dosageUnits)
                                        {
                                            <option value="@unit.Value">@unit.Text</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => currentMedication.DosageUnit)" class="text-danger" />
                                </div>
                            </div>

                            @if (currentMedication.DosageUnit == DosageUnit.Other)
                            {
                                <div class="mb-3">
                                    <label class="form-label">Custom Unit</label>
                                    <InputText @bind-Value="currentMedication.CustomDosageUnit"
                                               class="form-control"
                                               placeholder="Enter custom unit" />
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label">Frequency *</label>
                                <InputSelect @bind-Value="currentMedication.Frequency" class="form-select">
                                    <option value="">Select frequency</option>
                                    @foreach (var freq in frequencies)
                                    {
                                        <option value="@freq.Value">@freq.Text</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => currentMedication.Frequency)" class="text-danger" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Save Medication
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    @if (errorMessage != null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            @errorMessage
        </div>
    }

    @if (successMessage != null)
    {
        <div class="alert alert-success mt-3" role="alert">
            @successMessage
        </div>
    }

    <!-- Footer -->
    <div class="text-center pt-4 mt-4 border-top">
        <p class="text-muted small mb-0">
            Always consult with your healthcare provider before making changes to your medication regimen.
        </p>
    </div>
</div>

<style>
    .table th {
        font-weight: 600;
        border-bottom: 2px solid #dee2e6;
    }

    .table td {
        vertical-align: middle;
    }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        border-radius: 0.25rem;
    }

    .modal.show {
        display: block !important;
    }

    .bi-capsule {
        color: #6c757d;
    }

    .form-label {
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    .btn-group .btn + .btn {
        margin-left: -1px;
    }

    .spinner-border-sm {
        width: 1rem;
        height: 1rem;
    }
</style>