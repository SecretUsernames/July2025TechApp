@page "/records-upload"
@using System.Net.Http.Json
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@rendermode InteractiveWebAssembly

<PageTitle>Upload Medical Records</PageTitle>

<h3 class="mb-3">Upload Medical Records</h3>
<p class="text-muted">PDFs, CCD/HL7 XML, lab results, discharge summaries.</p>

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Processing...</span>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <InputFile OnChange="OnFilesSelected" multiple accept=".pdf,.xml,.json,.csv,.txt" />
            
            @if (uploadStatus != null)
            {
                <div class="alert @(uploadStatus.IsSuccess ? "alert-success" : "alert-danger") mt-3" role="alert">
                    @uploadStatus.Message
                </div>
            }

            @if (selectedFiles.Any())
            {
                <div class="mt-3">
                    <h6>Selected Files:</h6>
                    <ul class="list-group">
                        @foreach (var file in selectedFiles)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@file.Name</strong>
                                    <br />
                                    <small class="text-muted">@FormatFileSize(file.Size) - @file.ContentType</small>
                                </div>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFile(file)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" disabled="@(!filesSelected || isLoading)" @onclick="ProcessAndAnalyze">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Process & Analyze
                </button>
                <button class="btn btn-outline-secondary" disabled="@(!filesSelected)" @onclick="ClearFiles">Clear All</button>
            </div>

            <small class="text-muted d-block mt-2">
                Supported: PDF, XML, JSON, CSV (Max 50MB per file)
            </small>

            @if (analysisResults?.Any() == true)
            {
                <div class="mt-4">
                    <h5>Analysis Results</h5>
                    <div class="accordion" id="analysisAccordion">
                        @for (int i = 0; i < analysisResults.Count; i++)
                        {
                            var result = analysisResults[i];
                            var collapseId = $"collapse{i}";
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" 
                                            data-bs-toggle="collapse" data-bs-target="#@collapseId" 
                                            aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                                        @result.FileName
                                        <span class="badge bg-@(result.Status == "Success" ? "success" : "warning") ms-2">
                                            @result.Status
                                        </span>
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : "")" 
                                     data-bs-parent="#analysisAccordion">
                                    <div class="accordion-body">
                                        <strong>Extracted Data:</strong>
                                        <pre>@result.ExtractedData</pre>
                                        @if (!string.IsNullOrEmpty(result.Summary))
                                        {
                                            <hr />
                                            <strong>Summary:</strong>
                                            <p>@result.Summary</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool filesSelected = false;
    private bool isLoading = false;
    private List<IBrowserFile> selectedFiles = new();
    private UploadStatus? uploadStatus;
    private List<AnalysisResult>? analysisResults;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Configure the HttpClient base address if it's not set (for server-side rendering)
            if (string.IsNullOrEmpty(Http.BaseAddress?.ToString()))
            {
                Http.BaseAddress = new Uri("https://localhost:7014/"); // Update port as needed
            }
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        selectedFiles.Clear();
        selectedFiles.AddRange(e.GetMultipleFiles(10)); // Limit to 10 files
        filesSelected = selectedFiles.Count > 0;
        uploadStatus = null;
        analysisResults = null;
        StateHasChanged();
    }

    private void RemoveFile(IBrowserFile file)
    {
        selectedFiles.Remove(file);
        filesSelected = selectedFiles.Count > 0;
        StateHasChanged();
    }

    private void ClearFiles()
    {
        selectedFiles.Clear();
        filesSelected = false;
        uploadStatus = null;
        analysisResults = null;
        StateHasChanged();
    }

    private async Task ProcessAndAnalyze()
    {
        isLoading = true;
        uploadStatus = null;
        analysisResults = null;
        StateHasChanged();

        try
        {
            var formData = new MultipartFormDataContent();

            foreach (var file in selectedFiles)
            {
                var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024)); // 50MB limit
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                formData.Add(fileContent, "files", file.Name);
            }

            var response = await Http.PostAsync("api/records/upload", formData);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RecordsUploadResponse>();
                uploadStatus = new UploadStatus
                {
                    IsSuccess = true,
                    Message = result?.Message ?? "Files processed successfully!"
                };

                analysisResults = result?.Results ?? new List<AnalysisResult>();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                uploadStatus = new UploadStatus
                {
                    IsSuccess = false,
                    Message = $"Upload failed: {errorContent}"
                };
            }
        }
        catch (Exception ex)
        {
            uploadStatus = new UploadStatus
            {
                IsSuccess = false,
                Message = $"Error: {ex.Message}"
            };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    // Model classes
    public class RecordsUploadResponse
    {
        public string Message { get; set; } = string.Empty;
        public bool Success { get; set; }
        public List<AnalysisResult> Results { get; set; } = new();
    }

    public class AnalysisResult
    {
        public string FileName { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string ExtractedData { get; set; } = string.Empty;
        public string Summary { get; set; } = string.Empty;
        public DateTime ProcessedDate { get; set; }
    }

    public class UploadStatus
    {
        public bool IsSuccess { get; set; }
        public string Message { get; set; } = string.Empty;
    }
}