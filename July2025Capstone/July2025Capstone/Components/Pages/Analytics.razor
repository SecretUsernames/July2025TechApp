@page "/analytics"
@layout July2025Capstone.Components.Layout.MainLayout

<h3 class="mb-3">Health Analytics</h3>
<p class="text-muted">A quick look at your trends. (Live charts will plug in here.)</p>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card h-100 shadow-sm">
      <div class="card-body">
        <h5 class="card-title">Vitals Trend</h5>
        <div class="chart-placeholder"></div>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <h6 class="card-title mb-2">Recent Uploads</h6>
        <ul class="list-unstyled mb-0 small">
          <li>• CBC Panel — 2 hours ago</li>
          <li>• MRI Report — Yesterday</li>
          <li>• Insurance Card — 3 days ago</li>
        </ul>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-body">
        <h6 class="card-title">Alerts</h6>
        <p class="small text-muted mb-2">No critical alerts.</p>
        <button class="btn btn-outline-primary btn-sm">View All</button>
      </div>
    </div>
  </div>
</div>
