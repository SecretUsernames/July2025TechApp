@page "/dashboard"

<h3 class="mb-4">MedVault Dashboard</h3>

<div class="row">
    <!-- Left panel: quick actions -->
    <div class="col-md-3">
        <div class="list-group">
            <a class="list-group-item list-group-item-action" href="#">
                Upload Medical Record
            </a>
            <a class="list-group-item list-group-item-action" href="#">
                View Records
            </a>
            <a class="list-group-item list-group-item-action" href="#">
                Find a Doctor
            </a>
            <a class="list-group-item list-group-item-action" href="#">
                Insurance Info
            </a>
        </div>
    </div>

    <!-- Main panel: summary -->
    <div class="col-md-9">
        <div class="card mb-4">
            <div class="card-header">
                Recent Activity
            </div>
            <div class="card-body">
                <ul>
                    <li>Blood Test results uploaded - Aug 12, 2025</li>
                    <li>Doctor Appointment - Aug 10, 2025</li>
                    <li>Insurance policy updated - Aug 5, 2025</li>
                </ul>
            </div>
        </div>

        <!-- Placeholder for future charts -->
        <div class="card">
            <div class="card-header">
                Health Overview
            </div>
            <div class="card-body">
                <p>Charts and health data will appear here.</p>
            </div>
        </div>
    </div>
</div>
