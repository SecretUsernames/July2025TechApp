@page "/records-upload"
@layout July2025Capstone.Components.Layout.MainLayout

<h3 class="mb-3">Upload Medical Records</h3>
<p class="text-muted">PDFs, CCD/HL7 XML, lab results, discharge summaries.</p>

<div class="card shadow-sm">
  <div class="card-body">
    <InputFile OnChange="OnFilesSelected" multiple />
    <div class="mt-3">
      <button class="btn btn-primary" disabled="@(!filesSelected)">Process & Analyze</button>
    </div>
    <small class="text-muted d-block mt-2">Supported: PDF, XML, JSON, CSV</small>
  </div>
</div>

@code {
    bool filesSelected;
    void OnFilesSelected(InputFileChangeEventArgs e) => filesSelected = e.GetMultipleFiles().Count > 0;
}
